 id=\"topbar\"><button id=\"menu\" aria-label=\"My plans\" aria-expanded=\"false\" aria-controls=\"plans\"><svg class=\"sidebar-open-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"4\"></rect><path d=\"M9 3v18\"></path></svg></button><a href=\"#\" id=\"brand\" class=\"brand\" aria-label=\"Praxis home\">Praxis<span class=\"cursor\"></span></a><button id=\"new-case\">New plan <span aria-hidden=\"true\">+</span></button></header>\n<div id=\"backdrop\" hidden=\"\"></div><aside id=\"plans\" aria-label=\"My plans\"><div id=\"plans-brand\"><button id=\"collapse-plans\" aria-label=\"Close sidebar\" aria-controls=\"plans\"><svg class=\"sidebar-open-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"4\"></rect><path d=\"M9 3v18\"></path></svg></button></div><div id=\"plans-heading\"><h2>My plans</h2></div><nav id=\"case-list\"><button class=\"case-link active\" data-case-id=\"restaurant:bb962355aed81c8eb39fe3d1\" title=\"Dinner in Tokyo\"><span>Dinner in Tokyo</span><small>Ready</small></button></nav><details id=\"profile\"><summary><span id=\"profile-avatar\" aria-hidden=\"true\">F</span><span id=\"profile-label\">Fixture account</span></summary><p id=\"profile-name\" hidden=\"\"></p><button id=\"logout\">Sign out</button></details></aside>\n<main><section id=\"home\" hidden=\"\"><h1>What do you want to plan?</h1><div id=\"home-composer\"></div></section>\n<section id=\"case-workspace\" data-view=\"DETAILS\" data-case-id=\"restaurant:bb962355aed81c8eb39fe3d1\"><div id=\"topbar-sentinel\" aria-hidden=\"true\"></div><div id=\"reconnecting\" role=\"status\" hidden=\"\">Reconnecting…</div><div class=\"workspace-head\"><h1 id=\"case-title\" title=\"Dinner in Tokyo\">Dinner in Tokyo</h1></div><div class=\"workspace-conditions\"><div id=\"request-conditions\" aria-label=\"Plan conditions\" data-signature=\"[&quot;restaurant:bb962355aed81c8eb39fe3d1&quot;,[[&quot;Tokyo&quot;,false,&quot;text&quot;],[&quot;Mon, Nov 2&quot;,false,&quot;date&quot;,&quot;2026-11-02&quot;],[&quot;19:00–19:30&quot;,false,&quot;time&quot;,{&quot;latest&quot;:&quot;19:30&quot;,&quot;earliest&quot;:&quot;19:00&quot;}],[&quot;2 guests&quot;,false,&quot;guests&quot;,2]]]\"><button title=\"Change Tokyo\">Tokyo</button><button title=\"Change Mon, Nov 2\">Mon, Nov 2</button><button title=\"Change 19:00–19:30\">19:00–19:30</button><button title=\"Change 2 guests\">2 guests</button></div><button id=\"saved\" aria-label=\"Saved\"><svg class=\"saved-icon\" aria-hidden=\"true\" viewBox=\"5 3 14 18\"><path d=\"M6 4h12v17l-6-4-6 4z\"></path></svg><span>Saved</span><span id=\"saved-count\" hidden=\"\">0</span></button></div>\n<p id=\"understanding-error\" role=\"status\" hidden=\"\">Couldn't read that. Try rephrasing?</p>\n<section id=\"progress\" aria-label=\"Search progress\" hidden=\"\" class=\"\"><div id=\"stages\"></div><button id=\"stop\" hidden=\"\">Stop</button></section>\n<details id=\"revision-changes\" hidden=\"\"><summary><span id=\"added-count\"></span><span id=\"removed-count\"></span><span id=\"revision-chevron\" aria-hidden=\"true\"></span></summary><ul id=\"removed-list\"></ul></details>\n<section id=\"feedback\" hidden=\"\"><p>Did you get the booking?</p><div class=\"answers\"><button data-answer=\"YES\">Yes</button><button data-answer=\"NO\">Not yet</button><button id=\"feedback-dismiss\" aria-label=\"Skip booking feedback\" data-answer=\"SKIP\">×</button></div></section>\n<section id=\"candidate-panel\" hidden=\"\"><article class=\"candidate\" id=\"candidate-card\" data-candidate-id=\"fixture:outlet\"><div class=\"photo-frame\"><div class=\"photo\"><button id=\"cover-open\" aria-label=\"Open restaurant photos\" hidden=\"\"><img id=\"cover-image\" class=\"card-media\" alt=\"\" decoding=\"async\"></button><span class=\"initial\" id=\"restaurant-initial\">F</span><span id=\"no-photo\"><svg class=\"photo-placeholder\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Image placeholder\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><circle cx=\"8\" cy=\"8\" r=\"1.5\"></circle><path d=\"m4 17 5-5 4 4 3-3 4 4\"></path></svg></span><button id=\"bookmark\" aria-label=\"Save for later\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 4h12v17l-6-4-6 4z\"></path></svg></button></div><p id=\"cover-photo-source\" class=\"photo-credit\" hidden=\"\"></p></div><div class=\"card-head\"><h2 id=\"restaurant-name\">Fixture Sushi</h2><button id=\"details-button\">About <span aria-hidden=\"true\">›</span></button></div><div id=\"key-facts\"><span class=\"address-line\">1-2-3 Tokyo (synthetic)</span></div><p id=\"availability\" data-status=\"available\"><span>Availability</span> <span id=\"availability-status\">Mon, Nov 2</span></p><div id=\"delivery-slots\" class=\"muted\"><div><div class=\"slot-options\"><button class=\"slot-time\" data-offer-id=\"offer:tablecheck:fixture:outlet:2026-11-02:19:00:2\" aria-label=\"Time 19:00 on Mon, Nov 2\" aria-pressed=\"true\">19:00</button><button class=\"slot-time\" data-offer-id=\"offer:tablecheck:fixture:outlet:2026-11-02:19:30:2\" aria-label=\"Time 19:30 on Mon, Nov 2\" aria-pressed=\"false\">19:30</button></div></div></div><div id=\"delivery-conditions\"><div class=\"condition-row\"><span class=\"condition-name\">At most 9000 yen per person</span> <span class=\"condition-status\">Confirmed</span></div></div><p id=\"recommendation\">Fixture match for the requested area</p><div id=\"source-categories\" hidden=\"\" aria-label=\"Source cuisine classifications\"></div><button id=\"choose\" class=\"primary\" aria-busy=\"false\">Let's book</button><div id=\"card-actions\"><div id=\"card-pagination\" role=\"group\" aria-label=\"Browse restaurants\"><button id=\"previous\" aria-label=\"Previous restaurant\" disabled=\"\">←</button><span id=\"card-counter\" aria-live=\"polite\" aria-atomic=\"true\" style=\"visibility: visible;\">1 of 3</span><button id=\"next\" aria-label=\"Next restaurant\">→</button></div></div></article></section>\n<section id=\"details\" class=\"panel\"><button id=\"details-back\" class=\"view-back\">← Back</button><h2 id=\"details-name\">Fixture Sushi</h2><p id=\"evidence\">TableCheck · Checked 19:00</p><section id=\"place-photos\" hidden=\"\" aria-label=\"Restaurant photos\"><div class=\"photo-frame detail-photo-frame\"><button id=\"detail-photo-open\" aria-label=\"Open restaurant photos\"><img id=\"detail-photo\" alt=\"\" decoding=\"async\"></button><p id=\"detail-photo-source\" class=\"photo-credit\" hidden=\"\"></p></div><div id=\"detail-photo-controls\" class=\"photo-controls\" hidden=\"\"><button id=\"detail-photo-previous\" aria-label=\"Previous photo\" disabled=\"\">←</button><span id=\"detail-photo-counter\"></span><button id=\"detail-photo-next\" aria-label=\"Next photo\" disabled=\"\">→</button></div></section><div id=\"details-content\"><p class=\"about-address\">1-2-3 Tokyo (synthetic)</p><div class=\"fact\"><div class=\"condition-row\"><span class=\"condition-name\">At most 9000 yen per person</span> <span class=\"condition-status\">Confirmed</span></div></div><section class=\"about-source\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,null]\"><div class=\"citation-sources\" data-source-id=\"[[&quot;https://merchant.example/venue&quot;,null]]\"><div class=\"citation-group\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,null]\"><p class=\"citation-context\">Observed price:</p><blockquote>Dinner course: JPY 7000, tax included.</blockquote><p class=\"citation-context\">Observed price:</p><blockquote>Dinner course: JPY 8000, tax included.</blockquote><p class=\"citation-footer\"><a href=\"https://merchant.example/venue\" target=\"_blank\" rel=\"noopener noreferrer\">Source page<span aria-hidden=\"true\"> ↗</span></a></p></div></div></section><section class=\"about-commercial\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:04:00Z&quot;]\"><div class=\"citation-sources\" data-source-id=\"[[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:04:00Z&quot;]]\"><div class=\"citation-group\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:04:00Z&quot;]\"><blockquote>Dinner course: JPY 7000, tax included.</blockquote><p class=\"citation-footer\"><a href=\"https://merchant.example/venue\" target=\"_blank\" rel=\"noopener noreferrer\">Source page<span aria-hidden=\"true\"> ↗</span></a> · Checked Sat, Nov 21 · 17:04 JST</p></div></div></section><section class=\"about-commercial\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:05:00Z&quot;]\"><div class=\"citation-sources\" data-source-id=\"[[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:05:00Z&quot;]]\"><div class=\"citation-group\" data-source-id=\"[&quot;https://merchant.example/venue&quot;,&quot;2026-11-21T08:05:00Z&quot;]\"><blockquote>Dinner course: JPY 8000, tax included.</blockquote><p class=\"citation-footer\"><a href=\"https://merchant.example/venue\" target=\"_blank\" rel=\"noopener noreferrer\">Source page<span aria-hidden=\"true\"> ↗</span></a> · Checked Sat, Nov 21 · 17:05 JST</p></div></div></section></div><button id=\"refresh\" class=\"quiet\" aria-busy=\"false\">Refresh availability</button><p id=\"details-refresh-status\" class=\"muted\" role=\"status\" hidden=\"\">Refreshing…</p><section id=\"asked-history\" hidden=\"\"><h3>Q&amp;A</h3><article id=\"asked-pending\" class=\"asked-item\" hidden=\"\"><p id=\"asked-pending-question\"></p><p class=\"muted\" role=\"status\">Checking the page…</p><button id=\"question-stop\" class=\"quiet\" hidden=\"\">Stop</button></article><article id=\"asked-latest\" class=\"asked-item\" hidden=\"\"><p id=\"asked-question\"></p><div id=\"asked-result\"></div></article><div id=\"asked-earlier\"></div></section></section>\n<section id=\"saved-panel\" class=\"panel\" hidden=\"\"><button id=\"saved-back\" class=\"view-back\">← Back</button><h2>Saved</h2><div id=\"saved-list\"></div><p id=\"saved-empty\">No places saved yet.</p></section>\n<section id=\"handoff\" class=\"panel\" hidden=\"\"><button id=\"handoff-back\" class=\"view-back\">← Back</button><p id=\"handoff-provider\"><span id=\"handoff-recommended\">Recommended</span><span id=\"handoff-provider-name\"></span></p><h2 id=\"handoff-name\"></h2><div class=\"handoff-time-row\" id=\"handoff-time-row\" hidden=\"\"><label id=\"handoff-slot-label\">Time <span class=\"handoff-slot-control\"><select id=\"handoff-slot\" aria-label=\"Booking time\"></select><svg class=\"handoff-chevron\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"m2 4 4 4 4-4\"></path></svg></span></label><span id=\"handoff-price\" hidden=\"\"></span></div><div id=\"handoff-terms\"></div><p id=\"handoff-unavailable\" hidden=\"\">No current booking handoff is available. You can check the source website or refresh availability.</p><a id=\"departure\" class=\"primary\" href=\"#\" target=\"_blank\" rel=\"noopener\"><span id=\"departure-title\"></span></a><p id=\"departure-fields\" class=\"muted\"></p><p class=\"hint\" id=\"selection-hint\" hidden=\"\"></p><p class=\"hint\" id=\"verification-hint\" hidden=\"\"></p><a id=\"direct-source\" href=\"#\" target=\"_blank\" rel=\"noopener noreferrer\">Go to source website ↗</a></section>\n<section id=\"batch-end\" class=\"panel\" hidden=\"\"><button id=\"batch-back\" class=\"view-back\">← Back</button><h2>Any of these work?</h2><div id=\"end-options\"><button id=\"end-adjust\" class=\"quiet\">Adjust</button><button id=\"find-more\" class=\"primary\">Find more</button></div></section>\n<section id=\"empty-state\" class=\"panel\" hidden=\"\"><p id=\"empty-message\"></p><div class=\"empty-actions\"><button id=\"empty-adjust\">Adjust</button><button id=\"empty-more\" class=\"primary\">Find more</button><button id=\"empty-retry\" class=\"primary\">Try again</button></div></section><p id=\"partial-source-note\" class=\"muted\" hidden=\"\">Some sources couldn't be checked.</p>\n<p id=\"clarification-reply\" hidden=\"\"></p>\n<div id=\"messages\" aria-live=\"polite\" hidden=\"\"></div>\n<button id=\"use-location\" hidden=\"\">Use my location</button><p id=\"mode-note\" hidden=\"\">Fixture only. No real availability or reservations.</p><p id=\"error\" role=\"alert\" hidden=\"\"></p></section>\n\n<div id=\"workspace-composer\"><form id=\"composer\" novalidate=\"\"><textarea id=\"message\" aria-label=\"Restaurant question\" rows=\"1\" placeholder=\"Ask about Fixture Sushi\" style=\"height: 40px;\"></textarea><button id=\"send\" aria-label=\"Send\" aria-busy=\"false\"><svg viewBox=\"0 0 24 24\"><path d=\"m6 11 6-6 6 6M12 5v15\"></path></svg></button></form></div>\n\n</main><div id=\"answer-backdrop\" hidden=\"\"></div><section id=\"answer-sheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"answer-place\" tabindex=\"-1\" hidden=\"\"><button id=\"answer-dismiss\" aria-label=\"Close answer\"></button><header class=\"answer-head\"><h2 id=\"answer-place\"></h2><button id=\"answer-close\" aria-label=\"Close answer\">×</button></header><p id=\"answer-question\"></p><div id=\"question-result\"></div></section></div>\n<dialog id=\"photo-viewer\" aria-labelledby=\"photo-place\"><header><h2 id=\"photo-place\"></h2><button id=\"photo-close\" aria-label=\"Close photos\">Close</button></header><div class=\"viewer-image-frame\"><img id=\"large-photo\" alt=\"\" decoding=\"async\"><p id=\"photo-source\" class=\"photo-credit\"></p></div><div id=\"photo-controls\" class=\"photo-controls\"><button id=\"photo-previous\" aria-label=\"Previous photo\">←</button><span id=\"photo-counter\"></span><button id=\"photo-next\" aria-label=\"Next photo\">→</button></div></dialog>\n<script src=\"/assets/landing.js\"></script><script type=\"module\" src=\"/assets/workspace/entry.js\"></script>\n"}