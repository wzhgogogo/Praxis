\":\"link\",\"label\":\"Tabelog\",\"controlGroupLabel\":\"Unlabelled group\",\"href\":\"https://tabelog.com/en/\",\"availableActions\":[],\"rejectionReason\":\"REGION_OUTLET_EVIDENCE_MISMATCH_OR_VISITED\"},{\"ref\":\"observation:3:target:11\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Tabelog\",\"controlGroupLabel\":\"Unlabelled group\",\"href\":\"https://tabelog.com/en/\",\"availableActions\":[],\"rejectionReason\":\"REGION_OUTLET_EVIDENCE_MISMATCH_OR_VISITED\"},{\"ref\":\"observation:3:target:12\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Tokyo Restaurants\",\"controlGroupLabel\":\"Unlabelled group\",\"href\":\"https://tabelog.com/en/tokyo/\",\"availableActions\":[],\"rejectionReason\":\"REGION_OUTLET_EVIDENCE_MISMATCH_OR_VISITED\"},{\"ref\":\"observation:3:target:13\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Sugamo\",\"controlGroupLabel\":\"Unlabelled group\",\"href\":\"https://tabelog.com/en/tokyo/A1323/#\",\"availableActions\":[\"CLICK\"]},{\"ref\":\"observation:3:target:14\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Akabane\",\"controlGroupLabel\":\"Search by area\",\"controlGroupRef\":\"observation:3:group:1\",\"href\":\"https://tabelog.com/en/tokyo/A1323/A132305/\",\"availableActions\":[\"OPEN_LINK\"]},{\"ref\":\"observation:3:target:15\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Jujo\",\"controlGroupLabel\":\"Search by area\",\"controlGroupRef\":\"observation:3:group:1\",\"href\":\"https://tabelog.com/en/tokyo/A1323/A132304/\",\"availableActions\":[],\"rejectionReason\":\"REGION_OUTLET_EVIDENCE_MISMATCH_OR_VISITED\"},{\"ref\":\"observation:3:target:16\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Oji\",\"controlGroupLabel\":\"Search by area\",\"controlGroupRef\":\"observation:3:group:1\",\"href\":\"https://tabelog.com/en/tokyo/A1323/A132303/\",\"availableActions\":[],\"rejectionReason\":\"REGION_OUTLET_EVIDENCE_MISMATCH_OR_VISITED\"},{\"ref\":\"observation:3:target:17\",\"kind\":\"LINK\",\"role\":\"link\",\"label\":\"Otsuka