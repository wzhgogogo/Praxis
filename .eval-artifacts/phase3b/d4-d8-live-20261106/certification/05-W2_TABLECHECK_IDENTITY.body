<!doctype html>
<html data-theme="light">
  <head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no, interactive-widget=resizes-content"
    />
    <script>
      (function () {
        function mark(img) {
          var pic = img.parentElement;
          if (!pic || pic.tagName !== "PICTURE") return;
          pic.setAttribute("data-loaded", "true");
          var w = pic.closest("[data-image-reveal]");
          if (!w) return;
          var pics = w.querySelectorAll("picture");
          var idx = Array.prototype.indexOf.call(pics, pic);
          var skels = w.querySelectorAll("[data-skeleton-cell]");
          if (skels[idx])
            skels[idx].setAttribute("data-skeleton-loaded", "true");
        }
        function checkImg(img) {
          if (
            img &&
            img.tagName === "IMG" &&
            img.complete &&
            img.naturalWidth > 0
          )
            mark(img);
        }
        function onImgEvent(e) {
          if (e.target && e.target.tagName === "IMG") mark(e.target);
        }
        document.addEventListener("load", onImgEvent, true);
        document.addEventListener("error", onImgEvent, true);
        function observeInsertions() {
          if (!document.documentElement || window.__obs) return;
          window.__obs = true;
          new MutationObserver(function (muts) {
            for (var i = 0; i < muts.length; i++) {
              var added = muts[i].addedNodes;
              for (var j = 0; j < added.length; j++) {
                var n = added[j];
                if (!n || n.nodeType !== 1) continue;
                if (n.tagName === "IMG") checkImg(n);
                else if (n.querySelectorAll)
                  n.querySelectorAll("picture > img").forEach(checkImg);
              }
            }
          }).observe(document.documentElement, {
            childList: true,
            subtree: true,
          });
        }
        if (document.documentElement) observeInsertions();
        else
          document.addEventListener("readystatechange", observeInsertions, {
            once: true,
          });
        document.addEventListener("DOMContentLoaded", function () {
          observeInsertions();
          document
            .querySelectorAll("[data-image-reveal] picture > img")
            .forEach(checkImg);
        });
      })();
    </script>
