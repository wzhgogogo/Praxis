,"request_policy_placement":"popup","cuisines":["izakaya","japanese"],"phone":"+81362643229","shop_universe_ids":["57e0b91744aea12988000001"],"name":["のどぐろ専門 銀座 中俣","Specializing in Nodoguro Ginza Nakamata"],"budget_dinner_max":"15000.0","enable_points_redemption":true,"topic3_body_translations":[],"service_modes":["dining"],"locale":"ja","kana_name":"ノドグロセンモン ギンザ ナカマタ","budget_dinner_min":"10000.0","budget_dinner_avg":"12500.0","tc_input_service_category":"required","is_smartpay":false,"name_translations":[{"translation":"のどぐろ専門 銀座 中俣","locale":"ja"},{"translation":"Specializing in Nodoguro Ginza Nakamata","locale":"en"}],"enable_promo_code":false,"topic2_title_translations":[],"default_locale":"ja","currency":"JPY","phone_natl":"03-6264-3229","topic2_body_translations":[],"content_title_translations":[{"translation":"最高級のどぐろを心ゆくまで味わう専門店","locale":"ja"}],"affluent_program_venue":false,"service_categories":[],"address":{"country":"JP","city":"中央区","street":"銀座4-10-12","id":"6a50a1d5f4075420de877501","tag":"none","street2":"銀座サマリアビルB1","region":"東京都","postal_code":"104-0061"},"enable_points_issuance":true,"time_zone":"Asia/Tokyo","url":"https://nakamata-nodoguro.com/ginza/","topic1_body_translations":[],"request_policy_translations":[{"translation":"There are currently no seats available for reservation.\r\nJoin the waitlist to receive a notification if a seat becomes available due to a cancellation or other changes.\r\nIf you do not receive a notification by the day before, please understand that no seats became available.","locale":"en"},{"translation":"ただいま、ご予約いただけるお席がありません。\r\n\r\nキャンセル待ちに登録すると、キャンセルなどで空席が出た際に、ご登録の連絡先へご案内します。\r\n\r\n前日までにご案内がない場合は、空席がないものとしてご了承ください。","locale":"ja"},{"translation":"대기 예약 등록\r\n현재 예약 가능한 좌석이 없습니다.\r\n대기 예약을 등록하시면 취소 등으로 좌석이 다시 예약 가능해질 경우 등록하신 연락처로 안내해 드립니다.\r\n전날까지 안내를 받지 못하신 경우, 예약 가능한 좌석이 없는 것으로 양해 부탁드립니다.","locale":"ko"},{"translation":"目前暂无可预约的座位。\r\n登记候补后，如因取消预约等原因有座位空出，我们会通过您登记的联系方式通知您。\r\n如果截至前一天仍未收到通知，则表示暂无可预约的座位，敬请谅解。","locale":"zh-CN"},{"translation":"目前沒有可預約的座位。\r\n登記候補後，如因取消預約等原因有座位空出，我們會透過您登記的聯絡方式通知您。\r\n如果截至前一天仍未收到通知，則表示目前沒有可預約的座位，敬請見諒。","locale":"zh-TW"}],"booking_page_mode":"v2","content_body_translations":[{"translation":"「のどぐろ専門 銀座 中俣」は、大ぶりで脂のり抜群の最高級のどぐろを贅沢に味わえる専門店です。名物の塩焼きやしゃぶしゃぶ、一本丸ごと炊き上げる土鍋ご飯など、素材の魅力を引き出した多彩なのどぐろ料理をご提供。百余年の歴史を持つ中俣酒造の焼酎とともに、至福のひとときをお楽しみいただけます。和モダンな店内には個室も備え、接待や会食、記念日など幅広いシーンでご利用いただけます。","locale":"ja"}],"geocode":{"lon":139.7669681,"lat":35.6701718},"_id":"6a50a1d5f4075420de8774fd","search_after":"WyJuYWthbWF0YS1ub2RvZ3Vyby1naW56YSIsIm5ha2FtYXRhLW5vZG9ndXJv\nLWdpbnphIl0=","tc_points_rules":[{"status":"active","rate":"0.01","fixed_amount":"100.0","max_point_amount":null,"max_point_amount_per_pax":"5000.0","valid_date_ranges":[{"start_date":null,"end_date":null}]}],"stations":[{"name_translations":[{"translation":"東銀座","locale":"en"},{"translation":"東銀座","locale":"ja"},{"translation":"히가시긴자","locale":"ko"},{"translation":"東銀座","locale":"zh-CN"},{"translation":"東銀座","locale":"zh-TW"},{"translation":"東銀座","locale":"de"},{"translation":"Higashi-Ginza","locale":"es"},{"translation":"東銀座","locale":"fr"},{"translation":null,"locale":"nl"},{"translation":"東銀座","locale":"it"},{"translation":null,"locale":"pt"},{"translation":null,"locale":"tr"},{"translation":"Хигаси Гиндза","locale":"ru"},{"translation":null,"locale":"id"},{"translation":null,"locale":"ms"},{"translation":null,"locale":"tl"},{"translation":null,"locale":"th"},{"translation":null,"locale":"lo"},{"translation":null,"locale":"km"},{"translation":null,"locale":"vi"},{"translation":null,"locale":"ar"},{"translation":null,"locale":"he"},{"translation":null,"locale":"hi"}],"distance":60.424037461699,"geocode":{"lon":139.7673,"lat":35.6697}},{"name_translations":[{"translation":"Higashi-Ginza Station","locale":"en"},{"translation":"東銀座駅","locale":"ja"},{"translation":"Higashi-Ginza Station","locale":"ko"},{"translation":"東銀座駅","locale":"zh-CN"},{"translation":"東銀座駅","locale":"zh-TW"},{"translation":"Higashi