          "method": "GET",
          "url": "https://tblg.k-img.com/stylesheets/lib/colorbox.css?rst-v1-202611051539-f4cec0ed48e7e3432e067401c68ea1a23d8b239c132f3ab90e4e940e24efb1ee",
          "httpVersion": "HTTP/1.1",
