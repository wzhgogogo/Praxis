e-img-item--06\">\n              <img loading=\"lazy\" width=\"1860\" height=\"380\" alt=\"top kv 06\" />\n            </div>\n          </div>\n          <div class=\"rsttop-inbound-kv__inner\">\n            <div class=\"rsttop-inbound-kv__title\">\n              <strong>Japan&#39;s No. 1* Restaurant Listing and Reservation Site.</strong>\n            </div>\n          </div>\n          <div class=\"rsttop-inbound-search-form l-container\">\n            <div class=\"rsttop-inbound-search-form__contents l-contents l-contents--flexible\">\n              <div class=\"rsttop-inbound-kv__notice\">\n                *As of May 2024, according to in-house survey.\n              </div>\n              <div class=\"rsttop-inbound-search-form__item\">\n                <form class=\"p-global-search rsttop-inbound-search-form__item-frame js-top-search-form js-keyword-suggest-form\" accept-charset=\"UTF-8\" method=\"get\"><input name=\"utf8\" type=\"hidden\" value=\"&#x2713;\" />\n                          <div class=\"p-global-search__input-wrap p-global-search__input-wrap--area rsttop-inbound-search-form__input-wrap rsttop-inbound-search-form__input-wrap--area\">\n                            <div class=\"p-keyword-suggest__input-inner js-keyword-suggest-input-inner\">\n                              <input class=\"js-keyword-suggest-input p-keyword-suggest__input js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":search_filter_open\" placeholder=\"Location, cuisine, restaurant name, etc.\" type=\"text\" />\n                            </div>\n                            <div class=\"p-global-search__clear-btn p-global-search-suggest__clear-btn rsttop-inbound-search-form__clear-btn js-keyword-text-reset\">\n                              <i>Reset</i>\n                            </div>\n                            <input type=\"hidden\" name=\"pal\" id=\"pal\" class=\"js-pal\" /><input type=\"hidden\" name=\"LstPrf\" id=\"LstPrf\" class=\"js-LstPrf\" /><i