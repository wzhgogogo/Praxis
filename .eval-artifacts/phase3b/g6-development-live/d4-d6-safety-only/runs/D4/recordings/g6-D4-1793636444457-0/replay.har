oter-language\">\n            <div class=\"footer-language__inner\">\n              <ul class=\"footer-language__items\">\n                <li class=\"footer-language__item-dtl is-selected\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_en\" href=\"https://tabelog.com/en/tokyo/\" id=\"js-global-footer-link-en\">English</a>\n                </li>\n                <li class=\"footer-language__item-dtl\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_cn\" href=\"https://tabelog.com/cn/tokyo/\" id=\"js-global-footer-link-cn\">简体中文</a>\n                </li>\n                <li class=\"footer-language__item-dtl\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_tw\" href=\"https://tabelog.com/tw/tokyo/\" id=\"js-global-footer-link-tw\">繁體中文</a>\n                </li>\n                <li class=\"footer-language__item-dtl\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_kr\" href=\"https://tabelog.com/kr/tokyo/\" id=\"js-global-footer-link-kr\">한국어</a>\n                </li>\n                <li class=\"footer-language__item-dtl\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_th\" href=\"https://tabelog.com/th/tokyo/\" id=\"js-global-footer-link-th\">ไทย</a>\n                </li>\n                <li class=\"footer-language__item-dtl\">\n                  <a class=\"js-analytics\" data-analytics-add-page-prefix=\"true\" data-analytics-btn=\":footer_change_language_jp\" href=\"https://tabelog.com/tokyo/\">日本語</a>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </div>\n        <div class=\"footer-copyright\">\n       