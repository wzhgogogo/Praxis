witch-image-item\" data-slide-index=\"2\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"3\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"4\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"5\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"6\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"7\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"8\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                  <li class=\"p-main-photos__switch-photo js-switch-image-item\" data-slide-index=\"9\">\n                    <a class=\"p-main-photos__switch-photo-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"><img alt=\"Kushi Katsu Tanaka Nishisugamo ten\" width=\"60\" height=\"60\" /></a>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div class=\"pr-comment-wrap\">\n              <h3 class=\"pr-comment-title js-pr-title\">\n                Proudly serving Osaka&#39;s traditional Kushi Katsu and affordable drinks! Families with children and adult gatherings are all warmly welcomed!\n              </h3>\n              <div class=\"pr-comment\">\n                <p class=\"pr-comment__body js-pr-comment-body is-hidden\">\n                  <span class=\"pr-comment__option\"><span class=\"pr-comment__first\">Enjoy the vibrant atmosphere and traditional flavors of Osaka at Kushikatsu Tanaka! Bite into crispy, hot kushikatsu dipped generously in our secret sauce for an authentic taste of Osaka! At Kushikats<span class=\"js-pr-comment-more pr-comment__more-icon is-hidden\">...</span><button class=\"pr-comment__more js-pr-comment-more is-hidden\" type=\"button\">Read more</button><span class=\"pr-comment__over js-pr-comment-over\">u Tanaka, don’t miss out on &quot;Chinchiro&quot;! If you&#39;re lucky, you might get it for free, and even if not, you can toast with a mega cup! Making your own takoyaki is sure to be a hit too! With affordable prices, you can raise a glass every day! <br />We also offer great services for kids, making it a family-friendly spot. Experience Kushikatsu Tanaka, where both adults and children can have a great time!<br /></span></span></span>\n                </p>\n              </div>\n            </div>\n            <div class=\"rstdtl-top-kodawari\">\n              <div class=\"rstdtl-heading\">\n                <h3 class=\"rstdtl-heading__title\">\n                  Specialities\n                </h3>\n              </div>\n              <div class=\"rstdtl-top-kodawari__item\">\n                <div class=\"js-kodawari-cassete rstdtl-top-kodawari__target\" data-kodawari-id=\"1\">\n                  <div class=\"rstdtl-top-kodawari__contents\">\n                    <p class=\"rstdtl-top-kodawari__label rstdtl-top-kodawari__label--food\">\n                      Food \n                    </p>\n                    <div class=\"rstdtl-top-kodawari__photo\"><img alt=\"Is it the thrill of spices or the shock of garlic? Which one do you prefer?\" />\n                    </div>\n                    <p class=\"rstdtl-top-kodawari__title\">\n                      Is it the thrill of spices or the shock of garlic? Which one do you prefer?\n                    </p>\n                  </div>\n                </div>\n                <div class=\"js-kodawari-cassete rstdtl-top-kodawari__target\" data-kodawari-id=\"2\">\n                  <div class=\"rstdtl-top-kodawari__contents\">\n                    <p class=\"rstdtl-top-kodawari__label rstdtl-top-kodawari__label--drink\">\n                      Drink\n                    </p>\n                    <div class=\"rstdtl-top-kodawari__photo\"><img alt=\"Unbelievable Price! &quot;Unlimited Highball&quot; Always Just JPY 110 (Tax Included)!\" />\n                    </div>\n                    <p class=\"rstdtl-top-kodawari__title\">\n                      Unbelievable Price! &quot;Unlimited Highball&quot; Always Just JPY 110 (Tax Included)!\n                    </p>\n                  </div>\n                </div>\n                <div class=\"js-kodawari-cassete rstdtl-top-kodawari__target\" data-kodawari-id=\"3\">\n                  <div class=\"rstdtl-top-kodawari__contents\">\n                    <p class=\"rstdtl-top-kodawari__label rstdtl-top-kodawari__label--service\">\n                      Service\n                    </p>\n                    <div class=\"rstdtl-top-kodawari__photo\"><img alt=\"[Family-Friendly] Enjoy Takoyaki and Ice Cream on Us! Great Perks Await!\" />\n                    </div>\n                    <p class=\"rstdtl-top-kodawari__title\">\n                      [Family-Friendly] Enjoy Takoyaki and Ice Cream on Us! Great Perks Await!\n                    </p>\n                  </div>\n                </div>\n                <div class=\"js-kodawari-cassete rstdtl-top-kodawari__target\" data-kodawari-id=\"4\">\n                  <div class=\"rstdtl-top-kodawari__contents\">\n                    <p class=\"rstdtl-top-kodawari__label rstdtl-top-kodawari__label--food\">\n                      Food \n                    </p>\n                    <div class=\"rstdtl-top-kodawari__photo\"><img alt=\"Banquet Course with 120-Minute All-You-Can-Drink for JPY 4,000 (Tax Included) ~\" />\n                    </div>\n                    <p class=\"rstdtl-top-kodawari__title\">\n                      Banquet Course with 120-Minute All-You-Can-Drink for JPY 4,000 (Tax Included) ~\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"rstdtl-top-course\">\n              <div class=\"rstdtl-heading rstdtl-top-course__heading\">\n                <h3 class=\"rstdtl-heading__title\">\n                  Set menu\n                </h3>\n              </div>\n              <div class=\"rstdtl-course-list js-rstdtl-course-list\">\n                <div class=\"rstdtl-course-list__inner\">\n                  <p class=\"rstdtl-course-list__img\"><a class=\"rstdtl-course-list__img-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844953/\"><img alt=\"\" height=\"120\" width=\"120\" /></a>\n                  </p>\n                  <div class=\"rstdtl-course-list__data\">\n                    <div class=\"rstdtl-course-list__data-header\">\n                      <div class=\"rstdtl-course-list__course-summary\">\n                        <div class=\"rstdtl-course-list__option\">\n                          <span class=\"c-label c-label--s rstdtl-course-list__label rstdtl-course-list__label--emphasis\">All you can drink</span>\n                        </div>\n                        <p class=\"rstdtl-course-list__course-title\"><a class=\"rstdtl-course-list__target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844953/\">\n                                      <span class=\"rstdtl-course-list__course-title-text\">Kushikatsu Tanaka Course, 13 Dishes, 120 Minutes All-You-Can-Drink, JPY 4,400, Tax Included</span></a><span class=\"c-label c-label--s rstdtl-course-list__label\">13 items</span>\n                        </p>\n                        <p class=\"rstdtl-course-list__desc\">\n                          Enjoy six varieties of Kushi Katsu! Additionally, you can savor Kushi Katsu Tanaka&#39;s specialties such as &quot;Kasu Udon&quot; and &quot;Potato Salad.&quot; This course is packed with generous portions and includes a two-hour all-you-can-drink option, making it a truly fulfilling experience!  \n                          *The photo represents a serving for four people.\n                        </p>\n                      </div>\n                      <div class=\"rstdtl-course-list__action-btn\">\n                        <span class=\"c-btn c-btn--s c-btn--primary rstdtl-course-list__action-btn-target js-show-yoyaku-modal-trigger-course\" data-catalog-price=\"\" data-course-name=\"Kushikatsu Tanaka Course, 13 Dishes, 120 Minutes All-You-Can-Drink, JPY 4,400, Tax Included\" data-ex-tax-plan=\"false\" data-none-tax-plan=\"false\" data-plan-id=\"298844953\" data-real-price=\"4,400\" data-tax=\"（Price including tax）per person\">Reserve</span><a class=\"c-btn c-btn--s rstdtl-course-list__action-btn-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844953/\">Set menu details</a>\n                      </div>\n                    </div>\n                    <div class=\"rstdtl-course-list__data-body\">\n                      <div class=\"rstdtl-course-list__subinfo\">\n                        <div class=\"rstdtl-course-list__price-wrap\">\n                          <div class=\"rstdtl-course-list__price\">\n                            <span class=\"rstdtl-course-list__price-num\">JPY<em>4,400</em><span class=\"rstdtl-course-list__price-num-tax\">（Price including tax）per person</span></span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div><div class=\"rstdtl-course-list js-rstdtl-course-list\">\n                <div class=\"rstdtl-course-list__inner\">\n                  <p class=\"rstdtl-course-list__img\"><a class=\"rstdtl-course-list__img-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844954/\"><img alt=\"\" height=\"120\" width=\"120\" /></a>\n                  </p>\n                  <div class=\"rstdtl-course-list__data\">\n                    <div class=\"rstdtl-course-list__data-header\">\n                      <div class=\"rstdtl-course-list__course-summary\">\n                        <div class=\"rstdtl-course-list__option\">\n                          <span class=\"c-label c-label--s rstdtl-course-list__label rstdtl-course-list__label--emphasis\">All you can drink</span>\n                        </div>\n                        <p class=\"rstdtl-course-list__course-title\"><a class=\"rstdtl-course-list__target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844954/\">\n                                      <span class=\"rstdtl-course-list__course-title-text\">Osaka Full Enjoyment Course, 16 Dishes, 120 Minutes All-You-Can-Drink, JPY 5,500 (Tax Included)</span></a><span class=\"c-label c-label--s rstdtl-course-list__label\">16 items</span>\n                        </p>\n                        <p class=\"rstdtl-course-list__desc\">\n                          Enjoy our signature Kushi Katsu dishes, including the famous &quot;Saiboshi&quot;! You can also make your own piping hot &quot;Takoyaki&quot;! This course is packed with generous portions and includes a two-hour all-you-can-drink option, ensuring a truly satisfying experience.\n                        </p>\n                      </div>\n                      <div class=\"rstdtl-course-list__action-btn\">\n                        <span class=\"c-btn c-btn--s c-btn--primary rstdtl-course-list__action-btn-target js-show-yoyaku-modal-trigger-course\" data-catalog-price=\"\" data-course-name=\"Osaka Full Enjoyment Course, 16 Dishes, 120 Minutes All-You-Can-Drink, JPY 5,500 (Tax Included)\" data-ex-tax-plan=\"false\" data-none-tax-plan=\"false\" data-plan-id=\"298844954\" data-real-price=\"5,500\" data-tax=\"（Price including tax）per person\">Reserve</span><a class=\"c-btn c-btn--s rstdtl-course-list__action-btn-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844954/\">Set menu details</a>\n                      </div>\n                    </div>\n                    <div class=\"rstdtl-course-list__data-body\">\n                      <div class=\"rstdtl-course-list__subinfo\">\n                        <div class=\"rstdtl-course-list__price-wrap\">\n                          <div class=\"rstdtl-course-list__price\">\n                            <span class=\"rstdtl-course-list__price-num\">JPY<em>5,500</em><span class=\"rstdtl-course-list__price-num-tax\">（Price including tax）per person</span></span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div><div class=\"rstdtl-course-list js-rstdtl-course-list\">\n                <div class=\"rstdtl-course-list__inner\">\n                  <p class=\"rstdtl-course-list__img\"><a class=\"rstdtl-course-list__img-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844955/\"><img alt=\"\" height=\"120\" width=\"120\" /></a>\n                  </p>\n                  <div class=\"rstdtl-course-list__data\">\n                    <div class=\"rstdtl-course-list__data-header\">\n                      <div class=\"rstdtl-course-list__course-summary\">\n                        <div class=\"rstdtl-course-list__option\">\n                          <span class=\"c-label c-label--s rstdtl-course-list__label rstdtl-course-list__label--emphasis\">All you can drink</span>\n                        </div>\n                        <p class=\"rstdtl-course-list__course-title\"><a class=\"rstdtl-course-list__target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/party/298844955/\">\n                                      <span class=\"rstdtl-course-list__course-title-text\">Chiritori Nabe Course, 13 Dishes, 120 Minutes All-You-Can-Drink, JPY 5,500 (Tax Included)</span></a><span class=\"c-label c-label--s rstdtl-course-list__label\">16 items</span>\n                        </p>\n                        <p class=\"rstdtl-course-list__desc\">\n                          Experience the perfect match of sweet and spicy sauce with our homemade dashi broth! Enjoy a generous serving of vegetables along with the famous &quot;Osaka Tsuruhashi Chiritori Nabe&quot; and delicious Kushi Katsu. This delightful course also includes a two-hour all-you-can-drink option!\n                        </p>\n                      </div>\n                      <div class=\"rstdtl-course-list__action-btn\">\n                        <span cla