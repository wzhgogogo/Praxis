t>\n                            <dd class=\"list-balloon__table-contents\">\n                              <ul class=\"list-balloon__text-list\">\n                                <li class=\"list-balloon__text-item\">\n                                  <a class=\"list-balloon__recommend-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/rstLst/washoku/?sw=kushikatsu\">Washoku (Japanese cuisine)</a>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Western</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Chinese</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Asian, Ethnic</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Curry</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Yakiniku (Japanese BBQ), Tripe</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Nabe (Japanese hot pot)</span>\n                                </li>\n                                <li class=\"list-balloon__text-item\">\n                                  <a class=\"list-balloon__recommend-target\" href=\"https://tabelog.com/en/tokyo/A1322/A132201/rstLst/RC21/?sw=kushikatsu\">Izakaya (Japanese style tavern)</a>\n                                </li>\n                                <li class=\"list-balloon__text-item\"><span class=\"list-balloon__nolink\">Restaurants - other</span>\n                                </li>\n                              </ul>\n                   