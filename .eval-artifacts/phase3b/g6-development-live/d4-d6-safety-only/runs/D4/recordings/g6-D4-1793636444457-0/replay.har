pan><a>Friends</a>\n                    </p>\n                    <p class=\"rstinfo-table__notice\">\n                      This occasion is recommended by many people.\n                    </p>\n                  </td>\n                </tr>\n              </tbody>\n              <tr>\n                <th>\n                  Service\n                </th>\n                <td>\n                  <p>\n                    Pet friendly (Good for pets), Happy hour, Take-out, Delivery, Multilingual menu available（English, Traditional Chinese, Simplified Chinese, Korean）, Menu with photos, Digital menu available\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <th>\n                  Family friendly\n                </th>\n                <td>\n                  <p>\n                    Children welcome(Babies welcome, Preschoolers welcome, School-age children welcome), Kids menu available, Strollers welcome\n                  </p>\n                  <p class=\"rstinfo-table__each-info\">\n                    Please note that we have a limited number of children&#39;s chairs available, so we kindly ask you to contact us in advance to confirm.<br />\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <th>\n                  Website\n                </th>\n                <td>\n                  <p class=\"homepage\"><a target=\"_blank\" rel=\"nofollow noopener\" class=\"c-link-arrow\">\n                            <span>https://kushi-tanaka.com/restaurant/detail/nishiikebukuro</span></a>\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <th>\n                  The opening day\n                </th>\n                <td>\n                  <p class=\"rstinfo-opened-date\">\n                    2013.5.7\n                  </p>\n                </td>\n              </tr>\n            </table>\n            <div cl