aurants</span></a>\n                </li>\n                <li class=\"c-breadcrumbs__item is-current\">\n                  <strong><span>Kita-Ikebukuro &amp; Itabashi St. Area Restaurants</span></strong>\n                </li>\n              </ol>\n            </div>\n            <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Tabelog \",\"item\":\"https://tabelog.com/en/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tokyo Restaurants\",\"item\":\"https://tabelog.com/en/tokyo/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Itabashi & Along Tobu Railway Line Restaurants\",\"item\":\"https://tabelog.com/en/tokyo/A1322/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Kita-Ikebukuro & Itabashi St. Area Restaurants\"}]}</script>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"container\">\n      <script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13300833/\"},{\"@type\":\"ListItem\",\"position\":2,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13283609/\"},{\"@type\":\"ListItem\",\"position\":3,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13239336/\"},{\"@type\":\"ListItem\",\"position\":4,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13091352/\"},{\"@type\":\"ListItem\",\"position\":5,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13118121/\"},{\"@type\":\"ListItem\",\"position\":6,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13300847/\"},{\"@type\":\"ListItem\",\"position\":7,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13196441/\"},{\"@type\":\"ListItem\",\"position\":8,\"url\":\"https://tabelog.com/en/tokyo/A1322/A132201/13232465/\"},{\"@type\":\"ListItem\",\"position\":9,\"url\":\"https://tabelog.com/