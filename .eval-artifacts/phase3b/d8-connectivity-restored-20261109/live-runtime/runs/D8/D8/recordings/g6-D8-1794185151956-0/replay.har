_wings:\"כנפי עוף חריפות\",chinese:\"סיני\",chinese_hotpot:\"סיר חם סיני\",coffee_brunch:\"קפה ובראנץ'\",cold_noodles:\"נודלס קרים\",craft_beer:\"בירת מלאכה\",creative:\"יצירתי\",crepes:\"קרפים\",curry:\"קארי\",deli:\"דלי\",dessert:\"קינוח\",desserts:\"קינוחים\",dimsum:\"דים סאם\",dining_bar:\"בר מסעדה וגסטרופאב\",donuts:\"סופגניות\",entertainment:\"בילוי\",european:\"אירופאי\",european_curry:\"קארי אירופאי\",french:\"צרפתי\",fugu:\"פוגו (אבו נפחא)\",fusion_international:\"פיוז'ן ובינלאומי\",german:\"גרמני ואוסטרי\",greek:\"יווני\",gyoza:\"גיוזה (כיסונים)\",halal:\"בעל הכשר חלאל\",hawaiian:\"הוואי ואיי האוקיינוס השקט\",healthy:\"בריא\",horumon:\"הורמון-יאקי (קרביים על האש)\",hotpot:\"סיר חם\",ice_cream:\"גלידה\",indian:\"הודי\",indian_curry:\"קארי הודי\",indonesian:\"אינדונזי\",inn:\"אכסניה וארוחת בוקר\",international_fusion:\"פיוז'ן ובינלאומי\",irish:\"אירי\",italian:\"איטלקי\",izakaya:\"איזקאיה (פאב יפני)\",izakaya_dining:\"איזקאיה ואוכל\",izakaya_short:\"איזקאיה\",japanese:\"יפני\",japanese_curry:\"קארי יפני\",japanese_noodles:\"סובה ואודון\",japanese_sweets:\"ממתקים יפניים\",kaiseki:\"קאיסקי\",kaiten_zushi:\"סושי סיבובי\",kamameshi:\"קאמאמשי (פילאף יפני)\",kappo:\"קאפו (מטבח יפני מסורתי)\",karaoke:\"קריוקי\",kissaten:\"קפה יפני\",korean:\"קוריאני\",korean_hotpot:\"סיר חם קוריאני\",kosher:\"כשר\",kushiage:\"קושיאגה (שיפודים מטוגנים)\",kyoto_cuisine:\"מטבח קיוטו\",lounge:\"לאונג'\",malaysian:\"מלזיאי\",meat:\"בשר\",mediterranean:\"תיכוני\",mexican:\"מקסיקני\",middle_eastern:\"מזרח תיכוני\",modern_asian:\"אסייתי מודרני\",modern_french:\"מטבח צרפתי מודרני\",modern_indian:\"הודי מודרני\",modern_italian:\"איטלקי מודרני\",modern_mexican:\"מקסיקני מודרני\",modern_spanish:\"מטבח ספרדי מודרני\",modern_sushi:\"סושי מערבי\",mongolian:\"מונגולי\",mongolian_bbq:\"ברביקיו מונגולי\",moroccan:\"מרוקאי וצפון אפריקאי\",motsunabe:\"נאבה ומוטסונאבה (סיר חם)\",multiple_cuisines:\"{{cuisine}} + {{other_selected_cuisines_count}}\",nabe:\"נאבה (סיר חם יפני)\",natural:\"טבעי\",nepalese:\