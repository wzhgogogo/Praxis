uti \"{{listName}}\"',unsubscribed_venue:\"Berhenti mengikuti {{venue}}\",unsuccessful_list_save:\"Maaf, kami tidak dapat menyimpan tempat ini ke dalam daftar\",unsuccessful_venue_copy:\"Maaf, kami tidak dapat menyalin tempat ini\",unsuccessful_venue_share:\"Maaf, kami tidak dapat membagikan tempat ini\",updated_list:\"Daftar diperbarui\",updated_notifications:\"Preferensi notifikasi diperbarui\",updated_password:\"xxxxxxxxxxxxxxxxxxxxx\",updated_preferences:\"Preferensi diperbarui\",updated_profile:\"Profil diperbarui\"},XWe={japan_text:\"Jelajahi Tempat Makanan Terbaik dan Tersembunyi di Jepang\",select_region:\"Pilih wilayah\",singapore_text:\"Nikmati ragam kuliner Singapura yang semarak dan beragam\"},eFe={about:{title:\"Tentang\"},accepts_smartpay:\"Menerima TableCheck Pay\",action_btns:{call:\"Telepon\",open_full_page:\"Buka halaman penuh\",review:\"Ulas\",save:\"Simpan\",saved:\"Tersimpan\",share:\"Bagikan\",subscribe:\"Ikuti\",subscribed:\"Mengikuti\",visited:\"Dikunjungi\"},added_by_venue:\"Ditambahkan oleh tempat\",claim_or_remove_venue:{claim_venue:\"Klaim tempat\",email_contact_email:\"Email: {{ contact_email }}\",email_contact_person:\"Kontak: {{ contact_person_name }}\",email_contact_phone:\"Telepon: {{ contact_phone }}\",email_placeholder:\"Email Anda\",email_subject:\"[Permintaan penghapusan] {{venue_name}}\",email_venue_link:\"Tautan: {{ venue_url }}\",email_venue_name:\"Nama tempat: {{ venue_name }}\",full_name:\"Nama Anda\",full_name_placeholder:\"Nama lengkap Anda\",modal_title:\"Pemilik tempat ini?\",remove_venue:\"Hapus tempat\",remove_venue_checkbox_text:\"Saya mengonfirmasi bahwa saya memiliki, mengelola, atau mewakili tempat ini dan ingin menghapusnya\",remove_venue_explanation:\"Untuk penghapusan tempat, silakan isi formulir di bawah ini dan salah satu tim kami akan menghubungi Anda.\",success_message:\"Permintaan telah dikirimkan\"},community_photos:{add_photos:\"Tambah foto\",content_policy_agreement:\"Dengan memposting foto, saya setuju 