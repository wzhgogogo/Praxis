ញ្ជី\",explore_venues:\"ស្វែងរកភោជនីយដ្ឋាន\",favorites:\"បញ្ជី​ដែល​ចូលចិត្ត\",img_alt:{empty_followed_lists:\"ដៃច្រើនកំពុងចែករំលែកចានអាហារមួយ\",hand_with_food:\"ដៃកាន់អាហារ\"},info_msg:\"បញ្ជីជួយអ្នកតាមដានភោជនីយដ្ឋាន និងស្វែងរកកន្លែងទំនេរបានយ៉ាងងាយស្រួល\",info_msg_followed_lists:\"បញ្ជីណាមួយពីសហគមន៍ដែលអ្នករក្សាទុកនឹងបង្ហាញនៅទីនេះ\",list_name:\"ឈ្មោះបញ្ជី\",list_view:{make_profile_public_prompt:\"បញ្ជីរបស់អ្នកកំពុងពេញនិយម! ប្ដូរប្រវត្តិរូបរបស់អ្នកទៅជាសាធារណៈ ហើយដោះសោសមិទ្ធផលសម្រាប់ការរួមចំណែក។\",make_profile_public_prompt_title:\"🎉 មានការមើល 50 ដងហើយ ហើយនៅតែកើនឡើង!\"},list_visibility:\"ភាពមើលឃើញនៃបញ្ជី\",lists_page:{make_profile_public_prompt:\"បើកបង្ហាញប្រវត្តិរូបរបស់អ្នកជាសាធារណៈ ដើម្បីបង្កើនឱកាសឲ្យបញ្ជីរបស់អ្នកបានបង្ហាញក្នុងផ្នែកពេញនិយមរបស់យើង។\",make_profile_public_prompt_title:\"បង្កើនឱកាសរបស់អ្នក\"},login_to_use:\"ចូលគណនីដើម្បីប្រើបញ្ជី\",login_to_view_list:\"សូមចូលគណនីជាមុនសិន ដើម្បីមើលបញ្ជីនេះ។\",manage_list:\"គ្រប់គ្រងបញ្ជី\",multiple_lists:\"{{first_list_name}} + {{other_selected_lists_count}}\",my_lists:\"បញ្ជីរបស់ខ្ញុំ\",no_followed_lists:\"អ្នកមិនទាន់បានរក្សាទុកបញ្ជីណាមួយនៅឡើយទេ\",no_venue_saved_yet:\"មិនទាន់មានទីកន្លែងរក្សាទុកនៅឡើយទេ\",open_until:\"<bold>បើក</bold> ដល់ម៉ោង {{time}}\",ownership:{anonymous:\"ដោយ <span>អនាមិក</span>\",private:\"បញ្ជី​ឯកជន\",you:\"ដោយ <a>អ្នក</a>\"},privacy_private_info:\"បញ្ជីរបស់អ្នកនឹងអាចមើលឃើញតែអ្នកប៉ុណ្ណោះ។\",privacy_public_info:\"បញ្ជីរបស់អ្នកនឹងអាចមើលឃើញដោយអ្នកគ្រប់គ្នា។\",privacy_toggle:{description:\"ពេលបញ្ជីរបស់អ្នកជាឯកជន មានតែអ្នកប៉ុណ្ណោះដែលអាចមើលឃើញ និងចូលប្រើបាន។ មានតែបញ្ជីសាធារណៈប៉ុណ្ណោះដែលអាចចែករំលែកជាមួយអ្នកដទៃបាន។\",title:\"ធ្វើឱ្យបញ្ជីជាឯកជន\"},private_list_warning:\"បញ្ជីនេះត្រូវបានធ្វើឱ្យឯកជនដោយម្ចាស់របស់វា។\",remove:\"ដកចេញ\",save_list_info_msg:\"ចុចរូបតំណាងរក្សាទុកលើភោជនីយដ្ឋានណាមួយ បន្ទាប់មកជ្រើសរើសឈ្មោះបញ្ជីនេះ ដើម្បីចាប់ផ្ដើមបន្ថែម។\",save_to_list:\"រក្សាទុកក្នុងបញ្ជី\",saved_lists:\"បញ្ជីដែលបានរក្សាទុក\",share_list:\"ចែករំលែកបញ្ជី\",share_list_info:\"មានតែបញ្ជីដែលបានកំណត់ជាសាធារណៈប៉ុណ្ណោះដែលអាចចែករ