onfirm_email_no_match:\"E-mel pengesahan tidak sepadan dengan e-mel yang dimasukkan\",email_invalid:\"E-mel tidak sah\",email_required:\"Alamat e-mel yang sah diperlukan\",first_name_required:\"Nama pertama diperlukan\",full_name_required:\"Nama penuh diperlukan\",invalid_login:\"E-mel atau kata laluan tidak sah\",last_name_required:\"Nama akhir diperlukan\",min_length:\"Minimum 12 aksara\",one_lower_case:\"Sekurang-kurangnya 1 huruf kecil\",one_number:\"Sekurang-kurangnya 1 nombor\",one_symbol:\"Sekurang-kurangnya 1 simbol\",one_upper_case:\"Sekurang-kurangnya 1 huruf besar\",password_contains_email_substring:\"Tidak boleh mengandungi sebahagian daripada e-mel\",phone_number_required:\"Nombor telefon yang sah diperlukan\"},first_name:\"Nama pertama\",forgot_password:\"xxxxxxxxxxxxxxxxx\",gender:\"Jantina\",last_name:\"Nama terakhir\",login:\"Log masuk\",login_feat_unlock:\"<bold>Daftar</bold> atau <bold>log masuk</bold> ke akaun percuma anda dan buka semua ciri kami.\",logout:\"Log keluar\",no_account:\"Tiada akaun?\",password:\"xxxxxxxxxxx\",phone_number:\"Nombor Telefon\",reset_instruction:\"Masukkan alamat e-mel anda dan kami akan menghantar pautan untuk menetapkan semula kata laluan anda\",reset_instruction_sent:\"Jika akaun wujud untuk <bold>{{email}}</bold>, anda akan menerima e-mel dengan arahan untuk menetapkan semula kata laluan anda dalam beberapa minit.\",reset_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxx\",sign_up:\"Daftar\",sign_up_email:\"Daftar dengan e-mel\",terms_and_policy:\"Dengan meneruskan dan membuat akaun, anda bersetuju dengan <bold>terma dan dasar yang berkaitan.</bold>\"},NHe={all_day:\"Sepanjang hari\",any_party_size:\"Sebarang bilangan tetamu\",book_from:\"Tempah dari {{date}}\",book_from_day:\"Tempah dari {{day}} ini\",book_from_today:\"Tempah dari hari ini\",book_from_tomorrow:\"Tempah dari esok\",explore_venues:\"Teroka semua tempat berdekatan\",find_avail:\"Cari ketersediaan\",find_venues:\"Cari tempat yang tersedia\",more_avail:\"Cari lebih banyak ketersediaan\",no_avail_message:\"Kami tidak dapat mencari meja pada <underline>{{date}}</underline> untuk waktu makan yang dipilih, sila cuba lagi dengan masa atau hari lain\",no_avail_message_pickup:\"Kami tidak dapat menemui sebarang kekosongan pada <underline>{{date}}</underline> untuk masa pengambilan yang dipilih, sila cuba lagi dengan masa atau hari yang lain\",no_time_slots:\"Tiada meja tersedia dalam tempoh yang dipilih\",non_tc_disclaimer:\"Walau bagaimanapun, kerana kami tidak dapat menunjukkan atau menjamin ketersediaan, kami sangat mengesyorkan membuat tempahan dari salah satu pilihan yang disenaraikan di bawah.\",pickup_from:\"Jadualkan pengambilan dari {{date}}\",pickup_from_day:\"Jadualkan pengambilan dari {{day}}\",pickup_from_today:\"Jadualkan pengambilan dari hari ini\",pickup_from_tomorrow:\"Jadualkan pengambilan dari esok\",reset_to_default:\"Tetapkan semula kepada lalai\",retry_banner:\"Ada sesuatu yang tidak kena. Sila cuba buat tempahan sekali lagi.\",shop_disabled_busy:\"{{shop}} mengalami jumlah trafik yang tinggi dan telah berhenti menerima tempahan baharu buat sementara waktu. Sila tunggu beberapa minit dan cuba lagi kemudian.\",shop_disabled_stopped:\"{{shop}} tidak menerima tempahan dalam talian pada masa ini.\",time_slot_unavailable_message:\"Masa yang anda pilih tidak tersedia. Berikut ialah beberapa slot masa alternatif.\",walk_in:\"Tempat ini mungkin menerima pelanggan tanpa tempahan\",when_dine:\"Bila anda mahu makan?\"},EHe={description:\"Temui cerapan makan, cadangan restoran dan cerita budaya makanan\",page_description:\"Baca artikel dan kemas kini terkini daripada TableCheck\",page_title:\"Blog | TableCheck\",post_not_found:\"Catatan Blog Tidak Ditemui\",title:\"Blog TableCheck Diner\"},MHe={bishoku:{cta_text:\"Terokai sekarang\",description:\"Nikmati restoran gourmet Kyoto 20 Jan (Isnin) - 19 Mac (Rabu)\",title:\"Kyoto Bishoku Meguri 2025\"},fastpass:{cta_text:\"Tempah sekarang\",description:\"Daripada Kegemaran Tempatan kepada Restoran Trend. Nikmati tanpa Menunggu\",title:\"FastPass\"},ginza_week:{cta_text:\"Tempah sekarang\",description:\"Alami santapan terbaik di Ginza dengan menu set yang dihasilkan oleh cef terkenal.\",title:\"Minggu Restoran Diners Club Ginza Musim Bunga 2025\"},hsbc:{cta_text:\"Tempah sekarang\",description:\"Nikmati diskaun 10% untuk menu istimewa di restoran terpilih di Tokyo.\",terms:\"Terma dan syarat berlaku.\\nUntuk meminjam atau tidak meminjam? Pinjam hanya jika anda boleh membayar balik!\",title:\"Tawaran Eksklusif Kad HSBC Visa Signature\"},tc_app:{description:\"Gunakan aplikasi percuma kami untuk menempah dengan mudah semasa dalam perjalanan!\\nImbas kod QR di bawah.\",title:\"Muat turun Apl TableCheck\"},tc_pay:{cta_text:\"Semak imbas tempat\",description:\"Bayar serta-merta dengan kad berdaftar anda selepas makan.\\nCipta Kenangan, Bukan Kesusahan.\",title:\"TableCheck Pay\"},visa:{cta_text:\"Tempah sekarang\",description:\"Dapatkan diskaun 10% untuk menu terpilih di restoran yang mengambil bahagian di Tokyo, Kyoto dan Osaka.\",title:\"Makan dengan Visa di Jepun\"},xmas:{cta_text:\"Tempah sekarang\",description:\"Temui pilihan restoran eksklusif untuk Krismas!\",title:\"Kempen Krismas\"}},JHe={content_not_available:\"Dasar kandungan tidak tersedia.\",meta_description:\"Dasar Kandungan TableCheck\",page_title:\"Dasar Kandungan | TableCheck\"},BHe={android_description:\"Kami gembira untuk berkongsi bahawa aplikasi Android baharu kami akan tiba tidak lama lagi & akan tersedia secara percuma! Sementara itu, sila gunakan laman web kami tablecheck.com\",android_title:\"Kemas kini akan datang\",continue_tc:\"Teruskan ke tablecheck.com\",ios_description:\"Kemas kini ke versi aplikasi terkini kami secara percuma & buka ciri-ciri baru. Anda juga boleh meneruskan ke tablecheck.com jika anda ingin mengemas kini kemudian.\",ios_title:\"Kemas kini aplikasi tersedia\",update_app:\"Kemas kini aplikasi\"},PHe={african:\"Afrika\",agemono:\"Agemono (Gorengan J