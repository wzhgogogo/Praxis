tl_mainphoto_next.png?a40a4c59e3e51d1954292e5d1881e8ea6811478e75895349ae3cbc03bcfa881f\") 96% 50% no-repeat rgba(0,0,0,0)}body.is-visit-form-open #cboxNext:hover{background:url(\"https://tblg.k-img.com/images/shared/lightbox/bg_rstdtl_mainphoto_next_hover_re1.png?781e160cd6f5bacaa4eee25b6c27c3697a42f7ca02908f91678e0074d09b3616\") 96% 50% no-repeat}body.is-visit-form-open #cboxPrevious{position:absolute;top:0;left:0;outline:none;border:none;width:49%;height:100%;text-indent:-9999px;background:url(\"https://tblg.k-img.com/images/shared/lightbox/bg_rstdtl_mainphoto_back.png?15a937060a0603516a619d58fc08a221a5c305ef64ae8e7c9bcf47d6399dd69f\") 4% 50% no-repeat rgba(0,0,0,0)}body.is-visit-form-open #cboxPrevious:hover{background:url(\"https://tblg.k-img.com/images/shared/lightbox/bg_rstdtl_mainphoto_back_hover_re1.png?7f9888b66bb375ebf3d60671e79b13bb47c306150f5bc3febcc3ba5ee7bc49ae\") 4% 50% no-repeat rgba(0,0,0,0)}body.is-visit-form-open #cboxCurrent{color:rgba(0,0,0,0)}\n"
