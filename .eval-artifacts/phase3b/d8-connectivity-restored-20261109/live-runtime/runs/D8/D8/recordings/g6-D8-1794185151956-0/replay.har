:\"ទីកន្លែង\",details:{download_receipt:\"ទាញយកបង្កាន់ដៃ\",expired_status:\"ប័ណ្ណនេះផុតកំណត់ហើយ។\",expired_voucher_message:\"ប័ណ្ណផុតកំណត់នៅ {{venueName}}\",gifted_voucher_message:\"អ្នកបានប្រគល់ប័ណ្ណនេះជាអំណោយ\",included_message:\"ប័ណ្ណរួមបញ្ចូលនៅក្នុងការកក់នេះ។\",make_a_reservation:\"ធ្វើការកក់ទុក\",multiple_venues:\"ភោជនីយដ្ឋានច្រើន\",order_details:\"ព័ត៌មានលម្អិតនៃការបញ្ជាទិញ\",price:\"តម្លៃ៖ {{voucherPrice}}\",qr_code_redeem_message:\"បង្ហាញលេខកូដ QR នេះ ដើម្បីប្ដូរយកប័ណ្ណរបស់អ្នក។\",qr_gallery_counter:\"{{current}} / {{total}}\",qr_split_per_voucher:\"បង្កើតលេខកូដ QR ដាច់ដោយឡែកសម្រាប់អត្តសញ្ញាណប័ណ្ណនីមួយៗ\",quantity_selector:\"ចំនួនប័ណ្ណដែលត្រូវប្រើ៖ \",redeemable_at_message:\"អាចប្រើបាននៅ {{venueName}}\",redeemed_message:\"ប័ណ្ណដែលបានប្រើក្នុងប្រតិបត្តិការនេះ\",redeemed_status:\"បានចូលរួមដោយជោគជ័យនៅ {{venueName}}\",redemption_message:\"ចំណាំ៖ ប្រព័ន្ធនឹងប្រើប័ណ្ណដែលផុតកំណត់មុនគេ\",refunded_voucher_message:\"សងប្រាក់វិញនៅ {{venueName}}\",reservation_details:\"ព័ត៌មានលម្អិតនៃការកក់\",reservation_id:\"លេខសម្គាល់ការកក់៖ {{reservationId}}\",reserved_status:\"កក់ទុកនៅ {{venueName}}\",select_quantity:\"សូមជ្រើសរើសបរិមាណប័ណ្ណដែលអ្នកចង់ប្រើប្រាស់\",select_quantity_placeholder:\"ជ្រើសរើសបរិមាណ...\",select_quantity_qr:\"សូមជ្រើសរើសបរិមាណប័ណ្ណដែលអ្នកចង់ប្រើ\",select_venue_description:\"ប័ណ្ណនេះអាចប្រើបាននៅភោជនីយដ្ឋានច្រើន។ សូមជ្រើសរើសភោជនីយដ្ឋានដើម្បីបន្តការកក់។\",select_venue_placeholder:\"ជ្រើសរើសកន្លែង...\",total_value:\"តម្លៃសរុប៖ {{totalValue}}\",total_vouchers:\"ប័ណ្ណសរុប៖ {{totalVouchers}}\",valid_vouchers_0:\"{{validVouchers}} ប័ណ្ណមានសុពលភាព\",validity_message:\"មានសុពលភាពរហូតដល់ {{validityDate}}\",validity_range_message:\"មានសុពលភាពពី {{startDate}} រហូតដល់ {{endDate}}\",voucher_count:\"{{voucherCount}}x ប័ណ្ណ\",voucher_id:\"លេខសម្គាល់ប័ណ្ណ៖ {{voucherIds}}\"},error:{voucher_not_found:\"រកមិនឃើញប័ណ្ណ\"},status:{expired:\"ផុតកំណត់\",redeemed:\"បានប្រើ\",refunded:\"បានសងប្រាក់វិញ\",transferred:\"បានផ្ដល់ជាអំណោយ\"},tabs:{inactive:\"អសកម្ម\",no_inactive_vouchers:\"មិ