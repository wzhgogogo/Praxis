mex:\"جنوب غربي أمريكي وتكس مكس\",thai:\"تايلاندي\",thai_curry:\"الكاري التايلاندي\",thai_hotpot:\"هوتبوت تايلاندي\",title:\"نوع المطبخ\",tofu:\"توفو\",tonkatsu:\"تونكاتسو (شريحة لحم خنزير مقلية)\",tsukemen:\"تسوكيمن (رامن للغمس)\",turkish:\"تركي\",udon:\"نودلز أودون\",udon_short:\"أودون\",unagi:\"أوناغي (ثعبان المياه العذبة)\",vegan:\"نباتي صرف (فيغان)\",vegetables:\"خضراوات\",vegetarian:\"نباتي\",vietnamese:\"فيتنامي\",western:\"غربي\",wine_bar:\"بار النبيذ\",wine_cocktails:\"النبيذ والكوكتيلات\",yakiniku:\"ياكينيكو وشواء كوري\",yakiniku_bbq:\"ياكينيكو ومشويات\",yakiniku_short:\"ياكينيكو\",yakisoba:\"ياكيسوبا (نودلز مقلية)\",yakitori:\"ياكيتوري وكوشياياكي (شوي بالسيخ)\",yakitori_short:\"ياكيتوري\",yoshoku:\"يوشوكو (غربي على الطريقة اليابانية)\"},lMe={description:\"يُظهر تقييمك كعميل مدى التزامك بحجوزاتك، لتعرف المطاعم أنك ضيف يمكن الاعتماد عليه. وكلما ارتفع تقييمك، حصلت على مزايا أكثر.\",explainer:{factors:{reliability:{body:\"حضور حجوزاتك هو أسرع طريقة لبناء تقييمك كعميل.\",title:\"الموثوقية\"},reservation_history:{body:\"مدى تكرار حجزك وتناولك الطعام في مطاعم TableCheck بمرور الوقت.\",title:\"سجل الحجوزات\"},transactions:{body:\"الحجوزات المكتملة والإنفاق عبر المنصة.\",title:\"المعاملات\"},venues_visited:{body:\"عدد المطاعم المختلفة التي تحجز فيها عبر TableCheck.\",title:\"الأماكن التي تمت زيارتها\"}},factors_intro:\"يُظهر تقييم العميل كيفية تناولك الطعام مع TableCheck ويستند إلى العوامل التالية:\",factors_title:\"عوامل التقييم\",faq:{booking_block:{answer:\"تقييمك لا يمنع أي حجز أبداً. ومع ذلك، قد تطلب بعض المطاعم عربونًا أو ضمان بطاقة قبل التأكيد.\",question:\"هل يمكن أن يمنعني تقييمي من الحجز؟\"},data_used:{answer:\"سجل الحجوزات والأماكن التي تمت زيارتها والمعاملات المكتملة عبر TableCheck. لا يتم استخدام أي شيء من خارج المنصة.\",question:\"ما هي البيانات المستخدمة؟\"},improve:{answer:\"التزم بالحجوزات التي تقوم بها، واحضر في الوقت المحدد، وألغِ مبكراً عندما تتغير الخطط. يرتفع تقييمك مع تراكم الحجوزات المكتملة.\",question:\"كيف أحسّن تقييمي؟\"},no_score:{answer:\"يظهر التقييم بمجرد إكمال بعض الحجوزات عبر TableCheck. حتى ذلك الحين، تراك المطاعم ببساطة كضيف جديد.\",question:\"لماذا ليس لدي تقييم بعد؟\"},no_show:{answer:\"لا. حالة عدم حضور واحدة لها تأثير محدود، ويتعافى تقييمك كلما واصلت الالتزام بالحجوزات التالية.\",question:\"هل حالة عدم حضور واحدة ستدمر تقييمي؟\"},who_can_see:{answer:\"فقط المطاعم التي تحجز معها. ترى تقييمك عند إجراء حجز — ولا ترى أبداً تفاصيل الأماكن الأخرى التي تناولت فيها الطعام.\",question:\"من يمكنه رؤية تقييمي؟\"}},faq_title:\"الأسئلة الشائعة\",hero_image_alt:\"عميل يتحقق من تقييمه في تطبيق TableCheck\",hero_subtitle:\"استخدم TableCheck واحصل على مكافآت.\",hero_title:\"تقييم العميل\",how_title:\"كيف يعمل؟\",other_faqs_cta:\"أسئلة شائعة أخرى\",perks:{membership:\"الوصول إلى العضوية\",offers:\"عروض وامتيازات\",venue_access:\"الوصول إلى مطاعم حصرية\"},steps:{avoid_cancel:{body:\"الإلغاءات في اللحظة الأخيرة وعدم الحضور قد تؤثر على تقييمك أكثر من غيرها، حاول تجنبها.\",title:\"تجنب الإلغاءات المتأخرة\"},benefits:{body:\"الحصول على تقييم أعلى سيكسبك عروضاً وامتيازات ووصولاً إلى مطاعم حصرية.\",title:\"استمتع بالمزايا\"},book:{body:\"إتمام الحجوزات عبر TableCheck يساعد في بناء تقييمك كعميل.\",title:\"احجز عبر TableCheck\"},habits:{body:\"كلما زاد عدد الحجوزات المكتملة لديك، زاد تقييمك بمرور الوقت.\",title:\"حافظ على عادات ثابتة\"}},what_is_intro:\"يعكس تقييمك كعميل مدى التزامك بالحجوزات التي تقوم بها، حتى تتمكن المطاعم من أن ترى في لمحة أنك ضيف يمكن الاعتماد عليه. كلما ارتفع تقييمك، زادت الامتيازات التي تحصل عليها، بما في ذلك:\",what_is_title:\"ما هو تقييم العميل؟\"},guidance:{frequency:{complete_visits:\"أكمل {{required_actions}} زيارات إضافية خلال الـ 90 يوماً القادمة لتحسين تقييمك.\"},recency:{come_back:\"احجز مرة أخرى خلال {{within_days}} يوماً لتحسين تقييمك.\"},reliability:{complete_reservations:\"أكمل {{required_actions}} حجوزات إضافية دون إلغاء لتحسين تقييمك.\"}},insights:{booking_frequency:{description:\"الحجز بشكل متكرر عبر TableCheck يرفع هذا المؤشر بأسرع طريقة. <actionLink>ابحث عن طاولة</actionLink>\",title_value_0:\"حجوزات حديثة: <bold>{{count}}</bold>\",title_value_1:\"حجوزات حديثة: <bold>{{count}}</bold>\",title_value_2:\"حجوزات حديثة: <bold>{{count}}</bold>\",title_value_3:\"حجوزات حديثة: <bold>{{count}}</bold>\",title_value_4:\"حجوزات حديثة: <bold>{{count}}</bold>\",title_value_5:\"حجوزات حديثة: <bold>{{count}}</bold>\"},improve_pill:\"حسّن تقييمك\",reliability:{description:\"يقيس الحجوزات التي تحضرها. الإلغاءات المتأخرة وحالات عدم الحضور تؤثر في هذا بشكل كبير.\",title_value:\"معدل الحضور: <bold>{{value}}</bold>\"},transactions:{description:\"العربون والمدفوعات التي تتم عبر TableCheck Pay تُحتسب ضمن هذا. <actionLink>كيف تعمل Pay</actionLink>\",title_value:\"الإنفاق: <bold>{{value}}</bold>\"},venues_visited:{description:\"الحجز في أماكن جديدة عبر TableCheck يرفع هذا المؤشر مع مرور الوقت. <actionLink>استكشف الأماكن</actionLink>\",title_value_0:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\",title_value_1:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\",title_value_2:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\",title_value_3:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\",title_value_4:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\",title_value_5:\"مطاعم تمت زيارتها: <bold>{{count}}</bold>\"}},insights_period:\"آخر 12 شهرًا\",insights_title:\"تحليل تقييمك\",levels:{excellent:\"ممتاز\",fair:\"مقبول\",good:\"جيد\",great:\"عظيم\",low:\"منخفض\"},offers:{book_with_offer:\"احجز باستخدام العرض\",claim_failed:\"تعذر المطالبة بهذا العرض. يرجى المحاولة مرة أخرى.\",code_copied:\"تم نسخ الرمز\",copy:\"نسخ\",promo_code:\"رمز ترويجي\",select_venue:\"اختر المطعم\"},offers_title:\"العروض والمزايا\",overall_score:\"النتيجة الإجمالية\",percentile:\"أعلى {{percent}}%\",perks:{claim:\"استلام\",claimed:\"تم الاستلام\",score_required:\"يتطلب تقييم {{level}}\"},status:{inactive:{description:\"يعود تقييمك بمجرد إكمال حجز آخر. يتم احتسابه من جديد في كل مرة من سجل حجوزاتك.\"},insufficient_history:{description:\"يظهر تقييمك بعد إكمال 5 حجوزات. الإلغاءات وحالات عدم الحضور لا تُحتسب.\"},score_suppressed:{description:\"يعود تقييمك بمجرد إكمال حجز آخر. يتم احتسابه من جديد في كل مرة من سجل حجوزاتك.\"},unavailable:{description:\"لا يمكننا عرض تقييمك في الوقت الحالي. حاول مرة أخرى قريباً.\"}},title:\"تقييم العميل\",venue_diversity_levels:{multi_venue:\"أماكن متعددة\",not_established:\"غير محدَّد\",single_venue:\"مكان واحد\"},verify:{code_input_label:\"رمز التحقق، الرقم {{index}}\",code_resent:\"تم إرسال الرمز\",code_sent:\"لقد أرسلنا رسالة نصية إلى <strong>{{phone}}</strong>. أدخل رمز التحقق أدناه.\",cta:\"إرسال الرمز\",heading:\"متاح لمستخدمي اليابان\",invalid_code:\"هذا الرمز غير صحيح. يرجى المحاولة مرة أخرى.\",japan_only:\"الرجاء إدخال رقم هاتف ياباني.\",phone_verified:\"تم التحقق من رقم الهاتف\",resend:\"إعادة إرسال الرمز\",resend_countdown:\"إعادة الإرسال خلال {{seconds}} ثانية\",title:\"التحقق من رقم الهاتف\"},verify_description:\"متوفر حاليًا للعملاء المقيمين في اليابان، وسنبدأ بتوسيع نطاق الخدمة لتشمل مناطق أخرى قريبًا. تحقق من رقم هاتفك المحمول الياباني لمعرفة تقييمك والمزايا التي يتيحها لك.\"},cMe={app_issue:\"عذراً، حدث خطأ داخل تطبيقنا.\",page_not_found:\"نحن آسفون ، الصفحة التي طلبتها لا يمكن العثور عليها\"},uMe={badge:{explanation:\"يدعم هذا المكان الحجز السريع، وهو أسرع طريقة لحجز مقعد.\"},book_now:\"احجز الآن\",confirmation_content:{add_request:\"أضف طلبًا إلى حجزك (اختياري)\",add_request_placeholder:\"مثال: أرجو أن يكون مقعدي قرب النافذة\",add_request_title:\"إضافة طلب\",added:\"تمت الإضافة\",agree_venue_policy_0:\"أوافق على سياسات المكان أعلاه.\",agree_venue_policy_1:\"أوافق على سياسة المكان أعلاه.\",agree_venue_policy_2:\"أوافق على سياستَي المكان أعلاه.\",agree_venue_policy_3:\"أوافق على سياسات المكان أعلاه.\",agree_venue_policy_4:\"أوافق على سياسات المكان أعلاه.\",agree_venue_policy_5:\"أوافق على سياسات المكان أعلاه.\",booking_policy:\"سياسة الحجز\",confirm_booking:\"تأكيد الحجز\",edit_email_hint:\"يمكنك تعديل عنوان بريدك الإلكتروني في TableCheck من صفحة <accountLink>الحساب</accountLink>.\",express_booking_description:\"الحجز السريع هو أسرع طريقة لحجز مقعد في بعض المطاعم المختارة. ولتجربة أكثر ملاءمة لتفضيلاتكم، يُرجى استكشاف خيارات المقاعد والقوائم أدناه\",fix_required_fields:\"يرجى تصحيح البيانات المطلوبة\",guest_details:\"بيانات الضيف\",guests:\"الضيوف: {{count}}\",holding_table:\"نحتفظ بالطاولة لك لمدة {{time}}\",optional:\"اختياري\",read_more:\"قراءة المزيد\",request_helper:\"مع أن الطلبات غير مضمونة، ستبذل المطاعم قصارى جهدها لتلبيتها.\",review_booking_policy:\"مراجعة سياسة الحجز\",seat_reservation_description:\"مع الحجز السريع، سيتم حجز طاولة لمجموعتكم. ولتجربة أكثر ملاءمة لتفضيلاتكم، يُرجى استكشاف خيارات المقاعد والقوائم.\",seat_reservation_title:\"حجز المقاعد\",table_expired:\"يمكنك محاولة إكمال الحجز الخاص بك، لكنه قد لا يكون متاحًا بعد الآن.\",terms_and_policy:\"بإرسال هذا النموذج، فإنك توافق على <termsLink>الشروط والسياسات</termsLink> ذات الصلة.\",title:\"راجع حجزك\",view_options:\"عرض الخيارات\",your_details:\"بياناتك\"},continue_without_login:\"المتابعة دون تسجيل الدخول\",description:\"احجز طاولة فورًا من خلال عرض المطاعم التي توفر الحجز السريع.\",error_content:{dupe_reservation:{banner:\"لديك بالفعل حجز مشابه في هذا الوقت. {{venueName}} لا يقبل الحجوزات المكررة.\",title:\"حجز مكرر\"},find_another_time_btn:\"البحث عن وقت آخر\",unexpected_error:{banner:\"حدث خطأ غير متوقع. لا يزال بإمكانكم حجز طاولة باستخدام الزر أدناه.\",title:\"لم ينجح الحجز\"},view_my_bookings_btn:\"عرض حجوزاتي\"},login_subheader:\"استخدم حساب TableCheck الحالي أو أنشئ حسابًا مجانًا لحجز <bold>{{venueName}}</bold>\",result_content:{booking_complete_title:\"تم تأكيد الحجز\",booking_pending_title:\"الحجز بانتظار التأكيد\",manage_booking:\"إدارة الحجز\",pending_subtext:\"سنخطرك على {{email}} عند تأكيده.\",pending_title:\"بانتظار تأكيد المطعم\",reservation_id:\"رقم الحجز\",success_title:\"تم تأكيد حجزكم بنجاح.\"},select_slot_content:{title:\"اختر التاريخ والوقت\"},title:\"الحجز السريع\"},dMe={all_you_can_eat:\"كل ما يمكنك أكله\",casual_lively:\"غير رسمي وحيوي\",chefs_counter:\"كاونتر الشيف\",entertainment:\"ترفيه\",fami