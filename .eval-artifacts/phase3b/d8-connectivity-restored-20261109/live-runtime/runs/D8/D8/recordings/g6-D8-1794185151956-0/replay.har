lanatory_text:\"फ़ोटो साझा करें, सूचियाँ दिखाएँ और सार्वजनिक प्रोफ़ाइल के साथ उपलब्धियाँ अनलॉक करें।\",popover_content:\"अपने स्वाद से समुदाय को प्रेरित करें! अपने TableCheck प्रोफ़ाइल को सक्षम करें और अतिरिक्त सुविधाएँ अनलॉक करें—अपनी सूचियाँ साझा करें, फ़ोटो अपलोड करें, और उपलब्धियाँ प्राप्त करें। आपकी व्यक्तिगत जानकारी गोपनीय रहेगी।\",title:\"सार्वजनिक प्रोफ़ाइल\"},photos:{community_policy:\"समुदाय नीति\",no_photos_description:\"इस उपयोगकर्ता के पास अभी कोई तस्वीरें नहीं हैं\",no_photos_description_owner:\"आपके पास अभी कोई तस्वीरें नहीं हैं\",no_photos_title:\"कोई तस्वीर नहीं\",photos_count:\"{{count}} फोटो\",photos_count_plural:\"{{count}} फोटो\",rejected_photos:\"अस्वीकृत तस्वीरें\",status:{pending:\"प्रतीक्षा में\",rejected:\"<VenueName>{{name}}</VenueName> के लिए आपका योगदान हमारी <CommunityLink>सामग्री नीति</CommunityLink> के अनुरूप नहीं था, इसलिए उसे अस्वीकृत कर दिया गया।\"}},privacy_toggle:{description:\"जब आपका खाता निजी होता है, तो आपकी प्रोफ़ाइल तक पहुँचा नहीं जा सकेगा और आपके सभी योगदान गुमनाम रहेंगे।\",title:\"खाता निजी बनाएं\"},private_profile_cta:\"मुझे होम पर ले चलें\",private_profile_description:\"इस उपयोगकर्ता की प्रोफाइल सार्वजनिक नहीं है\",private_profile_title:\"निजी प्रोफ़ाइल\",private_state_tooltip:\"आपकी प्रोफ़ाइल वर्तमान में निजी है, सार्वजनिक प्रोफ़ाइल में बदलने के लिए अपनी प्रोफ़ाइल संपादित करें\",public_profile_view:\"आप वर्तमान में अपनी सार्वजनिक प्रोफ़ाइल देख रहे हैं\",share:{copy_link:\"लिंक कॉपी करें\",on_fb:\"Facebook पर साझा करें\",on_x:\"X पर साझा करें\",public_account_on_tablecheck:\"TableCheck पर {{publicAccount}}\",via_email:\"ईमेल के माध्यम से साझा करें\"},share_modal_title:\"प्रोफ़ाइल साझा करें\",tabs:{achievements:\"उपलब्धियाँ\",activity:\"गतिविधि\",contributions:\"योगदान\",lists:\"सूचियाँ\",photos:\"तस्वीरें\",reviews:\"समीक्षाएँ\"}},public_profiles:{photos:{title:\"फ़ोटो\"}},saved_cards:\"सहेजे गए कार्ड\",sex_female:\"महिला\",sex_male:\"पुरुष\",sex_unspecified:\"अनिर्दिष्ट\",share_feedback:\"प्रतिक्रिया साझा करें\",social