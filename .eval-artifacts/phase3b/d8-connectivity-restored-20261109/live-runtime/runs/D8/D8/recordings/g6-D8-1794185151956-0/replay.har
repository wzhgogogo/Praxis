اً\",refunded_voucher_message:\"تم استرداد المبلغ في {{venueName}}\",reservation_details:\"تفاصيل الحجز\",reservation_id:\"معرف الحجز: {{reservationId}}\",reserved_status:\"محجوز في {{venueName}}\",select_quantity:\"يرجى تحديد عدد القسائم التي ترغب في استخدامها\",select_quantity_placeholder:\"حدد الكمية...\",select_quantity_qr:\"يرجى تحديد عدد القسائم التي ترغب في استخدامها\",select_venue_description:\"يمكن استخدام هذه القسيمة في عدة أماكن. يُرجى اختيار مكان لإتمام عملية الحجز.\",select_venue_placeholder:\"اختر مكانًا...\",total_value:\"القيمة الإجمالية: {{totalValue}}\",total_vouchers:\"إجمالي القسائم: {{totalVouchers}}\",valid_vouchers_0:\"لا توجد قسائم صالحة\",valid_vouchers_1:\"{{validVouchers}} قسيمة صالحة\",valid_vouchers_2:\"قسيمتان صالحتان\",valid_vouchers_3:\"{{validVouchers}} قسائم صالحة\",valid_vouchers_4:\"{{validVouchers}} قسيمة صالحة\",valid_vouchers_5:\"{{validVouchers}} قسيمة صالحة\",validity_message:\"صالحة حتى {{validityDate}}\",validity_range_message:\"صالحة من {{startDate}} حتى {{endDate}}\",voucher_count:\"قسائم {{voucherCount}}x\",voucher_id:\"معرفات القسيمة: {{voucherIds}}\"},error:{voucher_not_found:\"لم يتم العثور على القسيمة\"},status:{expired:\"منتهي الصلاحية\",redeemed:\"تم الاستخدام\",refunded:\"تم استرداد المبلغ\",transferred:\"تم الإهداء\"},tabs:{inactive:\"غير نشط\",no_inactive_vouchers:\"لا توجد قسائم غير نشطة\",no_redeemed_vouchers:\"لا توجد قسائم مستخدمة\",no_reserved_vouchers:\"لا توجد قسائم محجوزة\",no_valid_vouchers:\"لا توجد قسائم صالحة\",redeemable:\"قابلة للاستخدام\",redeemed:\"مستخدمة\",refunded:\"تم استرداد المبلغ\",reserved:\"محجوز\",valid:\"صالح\"},title:{expired_vouchers:\"القسائم منتهية الصلاحية\",expiry_message:\"ملاحظة: سيستخدم النظام القسيمة التي تنتهي صلاحيتها أولاً\",franchise:\"امتياز\",manage_vouchers:\"قسائم\",redeem_voucher:\"استخدام القسيمة\",redeemed_vouchers:\"القسائم المستخدمة\",refunded_vouchers:\"قسائم مستردة\",reservations:\"الحجوزات\",voucher_details:\"تفاصيل القسيمة\",voucher_id:\"رقم القسيمة\"}}},QEe=