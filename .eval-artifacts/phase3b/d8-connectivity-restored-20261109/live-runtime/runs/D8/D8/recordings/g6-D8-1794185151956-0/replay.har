លូវការ\"},b$e={kickstart_your_list:\"ចាប់ផ្តើមបង្កើតបញ្ជីរបស់អ្នក\",reasons:{similar_booked_venues:\"ស្រដៀងនឹងកន្លែងដែលអ្នកបានកក់\",similar_user_booked_venues:\"អ្នកដូចជាអ្នកក៏បានកក់ផងដែរ\",trending_venues:\"កន្លែងកំពុងពេញនិយម\"},recommendations_based_on:\"ការណែនាំរបស់យើងផ្អែកលើប្រវត្តិកក់ និងចំណូលចិត្តរបស់អ្នក។\",recommended_for_you:\"ណែនាំសម្រាប់អ្នក\",recommended_for_your_list:\"ណែនាំសម្រាប់បញ្ជីរបស់អ្នក\",settings:{subtitle:\"ជួយយើងកែសម្រួលការណែនាំឱ្យសមនឹងចំណូលចិត្តរបស់អ្នក និងបង្កើនបទពិសោធន៍ទទួលទានអាហាររបស់អ្នក។\",title:\"កែលម្អការណែនាំ\"},trending_venues:\"ភោជនីយដ្ឋានកំពុងពេញនិយម\"},y$e={active:\"សកម្ម\",any_date:\"កាលបរិច្ឆេទណាមួយ\",any_date_time:\"កាលបរិច្ឆេទ/ពេលវេលាណាមួយ\",any_time:\"ពេលណាក៏បាន\",datetime_at:\"{{date}} នៅ {{time}}\",datetime_between:\"{{date}} រវាង {{start}} - {{end}}\",details:\"ព័ត៌មានលម្អិត\",img_alt:{empty_requests:\"សំណើដែលកំពុងរង់ចាំ ឬសំណើពីមុនណាមួយ នឹងបង្ហាញនៅទីនេះ\"},inactive:\"អសកម្ម\",info_msg:\"គ្រប់គ្រងសំណើរបស់អ្នកបានយ៉ាងងាយស្រួល\",login_subheader:\"ដើម្បីដាក់សំណើសុំ វាតម្រូវឱ្យអ្នកចូលទៅក្នុង TableCheck។ អ្នកប្រើប្រាស់ថ្មីអាចបង្កើតគណនីនៅខាងក្រោម។\",login_to_use:\"សូមចូលគណនី ដើម្បីពិនិត្យមើលសំណើរបស់អ្នក\",meta:{description:\"មើល និងគ្រប់គ្រងសំណើកក់របស់អ្នកនៅលើ TableCheck — តាមដានសំណើដែលកំពុងដំណើរការ និងមើលសំណើកន្លងមក ឬដែលបានលុបចោលឡើងវិញ។\",title:\"TableCheck - សំណើកក់របស់ខ្ញុំ\"},no_active_requests:\"មិនមានសំណើសកម្មទេ\",no_inactive_requests:\"មិនមានសំណើអសកម្មទេ\",notify_me:\"ជូនដំណឹងខ្ញុំ\",notify_me_description:\"យើងនឹងជូនដំណឹងដល់អ្នក ប្រសិនបើតុមានកន្លែងទំនេរ។\",rebook:\"កក់ម្តងទៀត\",request_policy_title:\"គោលនយោបាយស្នើសុំការកក់\",sign_in_and_submit:\"ចូលគណនី ហើយដាក់ស្នើសំណើ\",status:{accepted:\"បានទទួលយក\",expired:\"ផុតកំណត់\",rejected:\"បានលុបចោល\",requested:\"បានស្នើសុំ\"},stop_notification:\"បញ្ឈប់ការជូនដំណឹង\",terms_and_policy:\"តាមរយៈការដាក់ស្នើទម្រង់នេះ អ្នកយល់ព្រមចំពោះ <a>លក្ខខណ្ឌ និងគោលការណ៍ពាក់ព័ន្ធរបស់ TableCheck</a>។\",title:\"សំណើកក់\"},v$e={book_now_future:\"អ្នកមិនមានការកក់ខាងមុខទេ។\\nសូមកក់តុបន្ទាប់របស់អ្នកឥឡូវនេះ\",book_now_past:\"អ្នកមិនមានការកក់ពីមុនមកទេ។\\nកក់តុបន្ទាប់របស់អ្នកឥឡូវនេះ\",details:\"ព័ត៌មានលម្អិត\",img_alt:{empty_bookings:\"ដៃច្រើនកំពុងចែករំលែកចានអាហារមួយ\"},info_msg:\"គ្រប់គ្រងការកក់របស់អ្នកដោយភាពងាយស្រួល\",login_to_use:\"ចូលគណនីដើម្បីពិនិត្យការកក់របស់អ្នក\",manage:\"គ្រប់គ្រង\",no_future_bookings:\"មិនមានការកក់ខាងមុខទេ\",no_past_bookings:\"មិនមានការកក់ពីមុនទេ\",onboarding:{panel:{description:\"បន្ទាប់ពីការកក់ណាមួយ សូមចែករំលែករូបថតអាហាររបស់អ្នក ដើម្បីទទួលបានផ្លាកសញ្ញា និងជួយសហគមន៍របស់យើងស្វែងរកកន្លែងដែលពួកគេចូលចិត្តបន្ទាប់\",title:\"ផ្ទុករូបថតឡើង និងដោះសោសមិទ្ធផល\"}},past:\"កន្លងមក\",rebook:\"កក់ឡើងវិញ\",status:{accepted:\"បានទទួល\",attended:\"បានមកដល់\",cancelled:\"បានលុបចោល\",confirmed:\"បានបញ្ជាក់\",delay:\"បានបញ្ជាក់\",expired:\"ហួសកាលកំណត់\",iou:\"តម្រូវទូទាត់\",iou_auth:\"តម្រូវប័ណ្ណ\",iou_deposit:\"តម្រូវប្រាក់កក់\",iou_prepay:\"តម្រូវទូទាត់ជាមុន\",late:\"បានបញ្ជាក់\",noshow:\"មិនបានមក\",pending:\"កំពុងរង់ចាំការបញ្ជាក់ពីភោជនីយដ្ឋាន\",rejected:\"បានបដិសេធចោល\",request:\"សំណើ\",tentative:\"ការកក់បណ្ដោះអាសន្ន\",unarrived:\"បានបញ្ជាក់\",waiting:\"កំពុងរង់ចាំ\",waitlist_called:\"បានបញ្ជាក់\"},title:\"ការកក់\",total:\"សរុប\",upcoming:\"ខាងមុខ\"},T$e={add_review:\"បន្ថែមការវាយតម្លៃ\",be_first_to_review:\"ក្លាយជាអ្នកដំបូងដែលវាយតម្លៃ!\",content_policy:\"គោលការណ៍មាតិកានៃការវាយតម្លៃ\",content_policy_agreement:\"ដោយការបង្ហោះការវាយតម្លៃ ខ្ញុំយល់ព្រមនឹង <span>គោលការណ៍មាតិការបស់ TableCheck</span>\",delete_review:\"លុបការវាយតម្លៃ\",delete_review_confirm:\"បាទ/ចាស លុប\",edit_review:\"កែប្រែការវាយតម្លៃ\",highlights:\"ចំណុចសំខាន់\",highlights_question:\"តើអ្វីខ្លះជាចំណុចសំខាន់?\",last_reviewed_on:\"បានវាយតម្លៃចុងក្រោយនៅ {{date}}\",last_visited_shop_at:\"ចុងក្រោយបានមកលេងនៅថ្ងៃទី {{date}}\",locals:\"អ្នកក្នុងតំបន់\",locals_say:\"អ្វីដែលអ្នកក្នុងតំបន់និយាយ\",no_reviews_description:\"អ្នកប្រើប្រាស់នេះមិនមានការវាយតម្លៃណា បច្ចុប្បន្ននេះទេ\",no_reviews_description_owner:\"ឥឡូវនេះអ្នកមិនមានការវាយតម្លៃទេ\",no_reviews_title:\"មិនមានការវាយតម្លៃ\",overall_rating:\"ពិន្ទុសរុប\",pick_up:\"ជ្រើសរើសរហូតដល់ 3\",rate_cta_question:\"តើអ្នកបានទៅទីនោះទេ? សូមចែករំលែកបទពិសោធន៍របស់អ្នក\",rate_review:\"ដាក់ពិន្ទុ និងវាយតម្លៃ\",rejected_photo_0:\"រូបថតបដិសេធ {{count}}\",review_created:\"បានបង្កើតការវាយតម្លៃ\",review_creation_error:\"មានបញ្ហា​ក្នុងការបង្កើតការវាយតម្លៃ\",review_prompt:\"តើអ្នកប្រាកដថាចង់លុបការវាយតម្លៃនេះមែនទេ?<br/>\\nការនេះនឹងលុប<b>រូបថតទាំងអស់ដែលបានផ្ទុកឡើង</b>ជាមួយការវាយតម្លៃផងដែរ ហើយមិនអាចត្រឡប់វិញបានទេ។\",review_reminder_subtitle:\"សូមវាយតម្លៃបទពិសោធន៍អាហារថ្មីៗរបស់អ្នក និងជួយផ្ដល់ព័ត៌មានដល់អ្នកដែលមានចំណូលចិត្តដូចគ្នា។\",review_text_rejected:\"យោបល់នេះត្រូវបានបដិសេធដោយសារតែវាមិនសម្របសម្រួលជាមួយ <Link>គោលការណ៍មាតិកា</Link> របស់យើង។ សូមធ្វើបច្ចុប្បន្នភាពការវាយតម្លៃរបស់អ្នកហើយព្យាយាមម្តងទៀត។\",review_update_error:\"មានកំហុសក្នុងការធ្វើបច្ចុប្បន្នភាពការវាយតម្លៃ\",review_updated:\"បានធ្វើបច្ចុប្បន្នភាពការវាយតម្លៃ\",reviewed_on:\"បានវាយតម្លៃនៅថ្ងៃទី {{date}}\",reviews_count_0:\"ការវាយតម្លៃ {{count}}\",reviews_reminder_title:\"តើអ្នករួចរាល់ក្នុងការវាយតម្លៃហើយឬនៅ?\",share_experience:\"ចែករំលែកបទពិសោធន៍របស់អ្នក\",share_image_description:\"ចែករំលែកពេលវេលាដ៏ពិសេសរបស់អ្នកពីការទស្សនាកន្លែង ដោយបញ្ចូលរូបភាពពីក្រោមនេះ។\",show_pictures_reviews:\"បង្ហាញតែការវាយតម្លៃដែលមានរូបថត\",show_verified_reviews:\"បង្ហាញតែការវាយតម្លៃដែលបានផ្ទៀងផ្ទាត់\",star_rating:\"{{rating}}/5\",title:\"ការវាយតម្លៃ\",top_rated:\"ពិន្ទុខ្ពស់បំផុត\",top_rated_description:\"ស្លាក ពិន្ទុខ្ពស់បំផុត បង្ហាញពីភោជនីយដ្ឋានដែលទទួលបានការវាយតម្លៃល្អលើសលប់ពីភ្ញៀវ។\",travelers_say:\"អ្វីដែលអ្នកដំណើរបាននិយាយ\",travellers:\"អ្នកដំណើរ\",verified:\"បានផ្ទៀងផ្ទាត់ហើយ\",went_wrong_question:\"តើមានអ្វីខុសឆ្គង?\",your_review:\"ការវាយតម្លៃរបស់អ្នក\"},C$e={action_btns:{search_area:\"ស្វែងរក​តំបន់​នេះ\",show_nearest_results:\"បង្ហាញលទ្ធផលដែលជិតបំផុត\",view_map:\"មើលផែនទី\"},ai_disclaimer:\"AI អាចធ្វើខុស។ ត្រូវប្រាកដថាអ្នកពិនិត្យមើលមុនពេលកក់!\",ai_suggestions:{afternoon_tea_for_2_this_saturday:\"តែពេលរសៀលសម្រាប់ 2 នាក់ ថ្ងៃសៅរ៍នេះ\",all_you_can_drink_for_4_people_tonight:\"4 នាក់ យប់នេះ\",available_today:\