:\"6000\",budget_dinner_avg:\"20000\",geocode:{lat:35.6942,lon:139.7026},name_translations:[{locale:le.english.code,translation:\"Sushi Kano\"},{locale:le.japanese.code,translation:\"鮨 加乃\"}],location_name_translations:[{locale:le.english.code,translation:\"Shinjuku\"},{locale:le.japanese.code,translation:\"新宿\"}],content_title_translations:[{locale:le.english.code,translation:\"Neighbourhood sushi with careful rice and seasonal fish\"},{locale:le.japanese.code,translation:\"丁寧なシャリと旬魚の近所の鮨\"}],content_body_translations:[{locale:le.english.code,translation:\"Kano offers lunch and dinner omakase near Shinjuku with balanced shari, clear soup, and nigiri that highlights shellfish and white fish in winter, fatty tuna in summer.\"},{locale:le.japanese.code,translation:\"新宿エリアでランチ・ディナーのおまかせ。冬は貝や白身、夏は脂ののった魚を中心に、バランスよく握ります。\"}],tagline_translations:[],search_image:\"https://image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F638ff5d6a163ff002a5725a0%2Fimages%2Foriginal%2F874731fc.jpg%3F1670378966\",images:[{id:\"kano-1\",original:\"https://4.image.cdn.tablecheck.com/unsafe/full-fit-in/528x528/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F638ff5df37bf8000412bb7cf%2Fimages%2Foriginal%2F5c440d36.jpg%3F1670378976\",thumbnail:\"https://4.image.cdn.tablecheck.com/unsafe/full-fit-in/528x528/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F638ff5df37bf8000412bb7cf%2Fimages%2Foriginal%2F5c440d36.jpg%3F1670378976\",caption:null},{id:\"kano-2\",original:\"https://2.image.cdn.tablecheck.com/unsafe/full-fit-in/1280x720/smart/filters:format(webp)/https%3A%2F%2Fcdn3.tablecheck.com%2Fimages%2F638ff5e6b2a04704278ced08%2Fimages%2Foriginal%2F89bd3e77.jpg%3F1670378983\",thumbnail:\"https://2.image.cdn.tablecheck.com/unsafe/full-fit-in/1280x720/smart/filters:format(webp)/https%3A%2F%2Fcdn3.tablecheck.com%2Fimages%2F638ff5e6b2a04704278ced08%2Fimages%2Foriginal%2F89bd3e77.jpg%3F