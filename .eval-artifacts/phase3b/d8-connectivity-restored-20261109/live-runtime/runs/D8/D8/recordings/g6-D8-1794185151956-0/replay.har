ata\",harajuku:\"Harajuku\",higashiyama:\"Higashiyama\",hiroshima:\"Hiroshima\",hokkaido:\"Hokkaido\",isezakicho:\"Isezakichō\",jr_central_towers:\"JR Central Towers\",kibune:\"Kibune\",kinshachi:\"Kinshachi\",kiyamachi:\"Kiyamachi\",kokusai_dori:\"Kokusai-dori\",kotoni:\"Kotoni\",kyoto:\"Kyoto\",kyoto_station:\"Bahnhof Kyoto\",makishi:\"Makishi\",marina_bay_sands:\"Marina Bay Sands\",maruyama:\"Maruyama\",minatomirai:\"Minatomirai\",motomachi:\"Motomachi\",nagahama:\"Nagahama\",nagoya:\"Nagoya\",naha:\"Naha\",nakasu:\"Nakasu\",nakazakicho:\"Nakazakicho\",niigata:\"Niigata\",noge:\"Noge\",odori:\"Odori Park\",okinawa:\"Okinawa\",omoromachi:\"Omoromachi\",orchard:\"Orchard\",osaka:\"Osaka\",osaka_station:\"Bahnhof Osaka\",osu:\"Osu\",pontocho:\"Pontocho\",raffles_place:\"Raffles Place\",roppongi:\"Roppongi\",sakae:\"Sakae\",sapporo:\"Sapporo\",sapporo_station:\"Bahnhof Sapporo\",sendai:\"Sendai\",shibuya:\"Shibuya\",shinjuku:\"Shinjuku\",shinsaibashi:\"Shinsaibashi\",shuri:\"Burg Shuri\",suntan:\"Suntan\",suntec:\"Suntec\",susukino:\"Susukino\",tanjong_pagar:\"Tanjong Pagar\",tanukikoji:\"Tanukikoji\",tenjin:\"Tenjin\",tennoji:\"Tennoji\",tokyo:\"Tokyo\",tsuboya:\"Tsuboya\",ueno:\"Ueno\",yokohama:\"Yokohama\"},VMe={back_to_login:\"Zurück zum Login\",check_email:\"Überprüfen Sie Ihre E-Mail\",check_inbox:\"Überprüfen Sie Ihren Posteingang\",check_inbox_msg:\"Um Ihre E-Mail-Adresse zu bestätigen, klicken Sie auf den Link in der E-Mail, die an <bold>{{email}}</bold> gesendet wurde.\",confirm_email:\"E-Mail bestätigen\",continue_with_facebook:\"Weiter mit Facebook\",continue_with_google_oauth2:\"Mit Google fortfahren\",continue_with_yahoojp:\"Weiter mit Yahoo! JAPAN\",create_password:\"xxxxxxxxxxxxxxxxxx\",email:\"E-Mail\",error:{confirm_email_no_match:\"Die Bestätigungs-E-Mail stimmt nicht mit der eingegebenen E-Mail überein\",email_invalid:\"Ungültige E-Mail\",email_required:\"Gültige E-Mail erforderlich\",first_name_required:\"Vorname erforderlich\",full_name_required:\"Vollständiger Name erforderlich\",invalid_login:\"Ungültige E-Mail-Adresse oder ungültiges Passwort\",last_name_required:\"Nachname erforderlich\",min_length:\"Mindestens 12 Zeichen\",one_lower_case:\"Mindestens 1 Kleinbuchstabe\",one_number:\"Mindestens 1 Ziffer\",one_symbol:\"Mindestens 1 Symbol\",one_upper_case:\"Mindestens 1 Großbuchstabe\",password_contains_email_substring:\"Darf keinen Teil der E-Mail enthalten\",phone_number_required:\"Gültige Telefonnummer erforderlich\"},first_name:\"Vorname\",forgot_password:\"xxxxxxxxxxxxxxxxxxx\",gender:\"Geschlecht\",last_name:\"Nachname\",login:\"Einloggen\",login_feat_unlock:\"<bold>Registrieren Sie sich</bold> oder <bold>melden Sie sich</bold> bei Ihrem kostenlosen Konto an, um alle Funktionen freizuschalten.\",logout:\"Ausloggen\",no_account:\"Haben Sie kein Konto?\",password:\"xxxxxxxx\",phone_number:\"Telefonnummer\",reset_instruction:\"Geben Sie Ihre E-Mail-Adresse ein und wir senden Ihnen einen Link zum Zurücksetzen Ihres Passworts\",reset_instruction_sent:\"Wenn ein Konto für <bold>{{email}}</bold> existiert, erhalten Sie innerhalb weniger Minuten eine E-Mail mit Anweisungen zum Zurücksetzen Ihres Passworts.\",reset_password:\"xxxxxxxxxxxxxxxxxxxxxx\",sign_up:\"Registrieren\",sign_up_email:\"Mit E-Mail registrieren\",terms_and_policy:\"Durch die Fortsetzung und Erstellung eines Kontos stimmen Sie den <bold>relevanten Geschäftsbedingungen und Richtlinien</bold> zu.\"},qMe={all_day:\"Den ganzen Tag\",any_party_size:\"Jede Gruppengröße\",book_from:\"Buchen Sie ab {{date}}\",book_from_day:\"Ab {{day}} buchen\",book_from_today:\"Ab heute buchen\",book_from_tomorrow:\"Ab morgen buchen\",explore_venues:\"Alle Restaurants in der Nähe entdecken\",find_avail:\"Verfügbarkeit finden\",find_venues:\"Verfügbare Restaurants finden\",more_avail:\"Mehr Verfügbarkeit finden\",no_avail_message:\"Wir konnten am <underline>{{date}}</underline> keinen Tisch für die ausgewählte Essenszeit finden. Bitte versuchen Sie es mit einer anderen Uhrzeit oder einem anderen Tag erneut.\",no_avail_message_pickup:\"Für <underline>{{date}}</underline> konnten wir keine verfügbaren Zeiten zur Abholung finden. Bitte versuchen Sie es mit einem anderen Zeitpunkt oder Tag erneut.\",no_time_slots:\"Kein Tisch im ausgewählten Zeitraum verfügbar\",non_tc_disclaimer:\"Wir können jedoch weder Verfügbarkeit anzeigen noch garantieren, daher empfehlen wir dringend, eine der unten aufgeführten Optionen zu buchen.\",pickup_from:\"Abholung ab {{date}} planen\",pickup_from_day:\"Abholung ab {{day}} planen\",pickup_from_today:\"Abholung ab heute planen\",pickup_from_tomorrow:\"Abholung ab morgen planen\",reset_to_default:\"Auf Standard zurücksetzen\",retry_banner:\"Es ist ein Fehler aufgetreten. Bitte versuchen Sie die Buchung erneut.\",shop_disabled_busy:\"{{shop}} verzeichnet derzeit ein sehr hohes Anfrageaufkommen und nimmt vorübergehend keine neuen Reservierungen an. Bitte warten Sie einige Minuten und versuchen Sie es dann erneut.\",shop_disabled_stopped:\"{{shop}} nimmt derzeit keine Online-Reservierungen an.\",time_slot_unavailable_message:\"Ihre ausgewählte Uhrzeit ist nicht verfügbar. Hier sind einige alternative Zeitfenster.\",walk_in:\"Dieses Restaurant nimmt eventuell auch Gäste ohne Reservierung an.\",when_dine:\"Wann möchten Sie speisen?\"},ZMe={description:\"Entdecken Sie kulinarische Einblicke, Restaurantempfehlungen und Geschichten zur Esskultur\",page_description:\"Lesen Sie die neuesten Artikel und Updates von TableCheck\",page_title:\"Blog | TableCheck\",post_not_found:\"Blogbeitrag nicht gefunden\",title:\"TableCheck Diner Blog\"},QMe={bishoku:{cta_text:\"Jetzt erkunden\",description:\"Genießen Sie die Gourmet-Restaurants von Kyoto vom 20. Januar (Montag) bis 19. März (Mittwoch)\",title:\"Kyoto Bishoku Meguri 2025\"},fastpass:{cta_text:\"Jetzt buchen\",description:\"Von lokalen Favoriten bis hin zu trendigen Restaurants. Genießen Sie ohne Wartezeit\",title:\"FastPass\"},ginza_week:{cta_text:\"Jetzt buchen\",description:\"Erleben Sie feinstes Essen in Ginza mit Gerichten, die von renommierten Köchen zubereitet werden.\",title:\"Diners Club Ginza Restaurantwoche Frühling 2025\"},hsbc:{cta_text:\"Jetzt buchen\",description:\"Genießen Sie 10% Rabatt auf spezielle Menüs in ausgewählten Tokioter Restaurants.\",terms:\"Es gelten die Allgemeinen Geschäftsbedingungen.\\nAusleihen oder nicht ausleihen? Leihen Sie nur, wenn Sie zurückzahlen können!\",title:\"Exklusives Angebot der HSBC Visa Signature Card\"},tc_app:{description:\"Nutzen Sie unsere kostenlose App, um ganz einfach von unterwegs zu buchen!\\nScannen Sie den QR-Code unten.\",title:\"Laden Sie die TableCheck-App herunter\"},tc_pay:{cta_text:\"Restaurants durchsuchen\",description:\"Bezahlen Sie sofort mit Ihrer registrierten Karte nach dem Essen.\\nSchaffen Sie Erinnerungen, nicht Ärger.\",title:\"TableCheck Pay\"},visa:{cta_text:\"Jetzt buchen\",description:\"Erhalten Sie 10 % Rabatt auf ausgewählte Menüs in teilnehmenden Restaurants in Tokio, Kyoto und Osaka.\",title:\"Essen Sie mit Visa in Japan\"},xmas:{cta_text:\"Jetzt buchen\",description:\"Entdecken Sie eine exklusive Restaurantauswahl zu Weihnachten!\",title:\"Weihnachtsaktion\"}},XMe={content_not_available:\"Die Inhaltsrichtlinie ist nicht verfügbar.\",meta_description:\"TableCheck-Inhaltsrichtlinie\",page_title:\"Inhaltsrichtlinie | TableCheck\"},eJe={android_description:\"Wir freuen uns, Ihnen mitteilen zu können, dass unsere neue Android-App in Kürze kostenlos verfügbar sein wird! Bis dahin nutzen Sie bitte unsere Website tablecheck.com\",android_title:\"Update demnächst\",continue_tc:\"Weiter zu tablecheck.com\",ios_description:\"Aktualisieren Sie kostenlos auf unsere neueste App-Version und schalten Sie neue Funktionen frei. Wenn Sie später aktualisieren möchten, können Sie auch mit tablecheck.com fortfahren.\",ios_title:\"App-Update verfügbar\",update_app:\"App aktualisieren\"},nJe={african:\"Afrikanisch\",agemono:\"Agemono (japanische Frittiergerichte)\",all_day_breakfast:\"Ganztägiges Frühstück\",american:\"Amerikanisch\",anago:\"Anago (Seeaal)\",asian:\"Asiatisch\",asian_noodles:\"Asiatische Nudeln\",australian:\"Australisch\",bagels:\"Bagels\",bakery:\"Bäckerei & Gebäck\",bar:\"Bar\",bbq:\"BBQ\",beer:\"Bier\",beer_garden:\"Biergarten\",beer_hall:\"Bierhalle\",beijing:\"Mandarin- & Peking-Küche\",belgian:\"Belgisch\",bistro:\"Bistro\",boat_cruise:\"Bootsfahrt\",brazilian:\"Brasilianisch\",breakfast:\"Frühstück\",british:\"Britisch\",brunch:\"Brunch\",buffet:\"Buffet\",burgers:\"Hamburger\",cafe:\"Café & Kaffeehaus\",cafe_and_brunch:\"Café & Brunch\",cafe_desserts:\"Café & Desserts\",cajun_caribbean:\"Cajun, Kreolisch & Karibisch\",californian:\"Kalifornisch & Modern-Amerikanisch\",cantonese:\"Kantonesisch\",champon:\"Champon (Nagasaki-Nudeln)\",chicken_wings:\"Scharfe Chicken Wings\",chinese:\"Chinesisch\",chinese_hotpot:\"Chinesischer Hotpot\",coffee_brunch:\"Kaffee & Brunch\",cold_noodles:\"Kalte Nudeln\",craft_beer:\"Craft-Bier\",creative:\"Kreativ\",crepes:\"Crepes\",curry:\"Curry\",deli:\"Feinkost\",dessert:\"Dessert\",desserts:\"Desserts\",dimsum:\"Dim Sum\",dining_bar:\"Dining Bar & Gastropub\",donuts:\"Donuts\",entertainment:\"Unterhaltung\",european:\"Europäisch\",european_curry:\"Europäisches Curry\",french:\"Französisch\",fugu:\"Fugu (Kugelfisch)\",fusion_international:\"Fusion & International\",german:\"Deutsch & Österreichisch\",greek:\"Griechisch\",gyoza:\"Gyoza (Teigtaschen)\",halal:\"Halal-zertifiziert\",hawaiian:\"Hawaiianisch & Pazifische Inseln\",healthy:\"Gesund\",horumon:\"Horumonyaki (gegrillte Innereien)\",hotpot:\"Hotpot\",ice_cream:\"Eis\",indian:\"Indisch\",indian_curry:\"Indisches Curry\",indonesian:\"Indonesisch\",inn:\"Gasthaus & Bed & Breakfast\",international_fusion:\"Fusion & International\",irish:\"Irisch\",italian:\"Italienisch\",izakaya:\"Izakaya (Japanische Taverne)\",izakaya_dining:\"Izakaya & Essen\",izakaya_short:\"Izakaya\",japanese:\"Japanisch\",japanese_curry:\"Ja