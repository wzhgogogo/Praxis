атель\"},current_progress:{login_prompt:\"Для просмотра вашего прогресса необходимо войти в систему\",title:\"Ваш прогресс по этому достижению\"},director:{title:\"Фотолюбитель\"},empty_description:\"Загляните позже!\",empty_title:\"Достижения не разблокированы\",explorer:{criteria:\"5 разных заведений\",description:\"Посетите 5 разных ресторанов и начните исследование.\",title:\"Исследователь\"},foodie:{criteria:\"25 бронирований\",description:\"Совершите 25 бронирований и докажите свою любовь к ресторанам.\",title:\"Преданный гость\"},gourmet_sensei:{criteria:\"50 бронирований\",description:\"Совершите 50 бронирований и станьте эталоном в мире гастрономии.\",title:\"Гурман-энтузиаст\"},influencer:{criteria:\"50 сохранений всего\",description:\"Наберите 50 сохранений во всех ваших списках и станьте доверенным куратором.\",title:\"Влиятельный создатель списков\"},legend:{criteria:\"50 разных заведений\",description:\"Посетите 50 разных ресторанов и станьте местной легендой.\",title:\"Местная легенда\"},list_maker:{criteria:\"Первый публичный список\",description:\"Создайте свой первый публичный список и начните собирать лучшие рестораны.\",title:\"Первый список\"},master_curator:{criteria:\"500 сохранений всего\",description:\"Достигните 500 сохранений во всех ваших списках и станьте мастером кураторства.\",title:\"Мастер-куратор\"},photo_archiver:{criteria:\"40 фотографий заведений\",description:\"Загрузите фотографии 40 заведений и создайте визуальную историю ваших посещений.\",title:\"Архиватор фотографий\"},photo_enthusiast:{criteria:\"10 фотографий заведений\",description:\"Загрузите фотографии из 10 ресторанов и помогите другим открыть для себя ваши впечатления от посещения.\",title:\"Любитель фотографий\"},photographer:{criteria:\"25 фотографий заведений\",description:\"Загрузите фотографии 25 ресторанов\",title:\"Фотограф\"},regular_diner:{criteria:\"5 бронирований\",description:\"Совершите 5 бронирований и сформируйте свой привычный стиль посещения.\",title