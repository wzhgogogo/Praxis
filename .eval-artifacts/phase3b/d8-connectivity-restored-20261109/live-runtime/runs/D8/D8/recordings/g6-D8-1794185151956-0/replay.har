lete_msg_warning:\"Nếu tiếp tục, tất cả thông tin tài khoản, đặt chỗ liên quan và Điểm TC của bạn sẽ bị xóa vĩnh viễn, hành động này không thể hoàn tác.\",delete_tc_account:\"Xoá tài khoản TableCheck\",delete_tc_account_title:\"Xóa tài khoản\",disconnect_account:\"Ngắt kết nối tài khoản\",disconnect_social_msg:\"Bạn có chắc chắn muốn ngắt kết nối tài khoản này không?\",discover_and_book:\"Khám phá, đặt chỗ và lưu những nhà hàng tốt nhất với tài khoản TableCheck miễn phí.\",empty_transaction_description:\"Bất kỳ giao dịch nào của bạn sẽ xuất hiện ở đây\",enter_current_password:\"xxxxxxxxxxxxxxxxxxxxxxxxx\",enter_name:\"Nhập tên của bạn\",enter_new_password:\"xxxxxxxxxxxxxxxxxxxxxxxxx\",errors:{password_incorrect:\"Mật khẩu hiện tại không chính xác\",password_used:\"Chọn mật khẩu mới, mật khẩu này đã được sử dụng trước đó\"},for_restaurateurs:\"Dành cho chủ nhà hàng\",generate_receipt:\"Tạo biên lai\",help:\"Trợ giúp\",membership:{joined:\"Ngày tham gia\",locations_used:\"Địa điểm sử dụng\",name_and_number:\"{{membership_name}} ({{membership_number}})\",no_memberships_msg:\"Bạn chưa liên kết thẻ thành viên nào.<br/>Bạn có thể liên kết thẻ thành viên khi đặt chỗ.\",number:\"Số thành viên\",program:\"Chương trình\",remove:\"Xóa thẻ thành viên\",remove_msg:\"Bạn có chắc chắn muốn xóa thẻ thành viên này khỏi tài khoản của bạn không?\",title:\"Thẻ thành viên\"},meta:{description:\"Xem lịch sử đặt chỗ của bạn: mọi thông tin đặt chỗ, từ đặt chỗ trước đây đến đặt chỗ sắp tới, đều có thể được quản lý trong một danh sách thuận tiện.\",title:\"TableCheck - Lịch sử đặt chỗ\"},new_password:\"xxxxxxxxxxxxxxxxxx\",no_transactions:\"Không có giao dịch\",notifications:{marketing_info:\"Nhận tin tức và cập nhật mới nhất từ nhóm TableCheck trước.\",notify_sms:\"Thông báo cho tôi về việc đặt chỗ qua SMS\",sms_info:\"Nhận thông báo từ nhà hàng bằng SMS. Bạn vẫn sẽ nhận được thông báo qua email.\",subscribe_tc_marketing:\"Đăng ký nhận bản tin TableCheck\",title:\"Quản lý thông báo\"},payment_method:{bank_transfer:\"Chuyển khoản ngân hàng\"},payment_status:{deposit:\"Đặt cọc\",paid:\"Đã thanh toán\",refunded:\"Đã hoàn trả\"},payment_type:{auth_hold:\"Giữ trước\",cancel_fee:\"Phí hủy bỏ\",contactless_pay:\"TableCheck Pay\",prepay:\"Thanh toán trước\"},please_confirm_email:\"Vui lòng xác nhận email của bạn\",please_confirm_email_change:\"Vui lòng xác nhận thay đổi email\",profile:\"Hồ sơ\",providers:{facebook:\"Facebook\",google_oauth2:\"Google\",yahoojp:\"Yahoo! JAPAN\"},public_profile:{achievements:{adventurer:{criteria:\"20 địa điểm khác nhau\",description:\"Ghé thăm 20 nhà hàng khác nhau và mở rộng tầm nhìn của bạn.\",title:\"Nhà thám hiểm\"},baby_diner:{criteria:\"Đặt bàn đầu tiên\",description:\"Hoàn tất đặt chỗ đầu tiên trên TableCheck.\",title:\"Thực khách mới\"},categories:{content_creator:\"Người tạo nội dung\",content_creator_description:\"Mở khóa các thành tích này bằng cách tải ảnh lên cho các địa điểm bạn đã ghé thăm qua TableCheck.\",default:\"Mặc định\",explorer:\"Khám phá\",explorer_description:\"Mở khóa thành tích này khi bạn đặt chỗ qua TableCheck.\",influencer:\"Người có sức ảnh hưởng\",influencer_description:\"Mở khóa thành tích này khi có người dùng khác theo dõi danh sách của bạn.\",list_curator:\"Người tuyển chọn danh sách\",list_curator_description:\"Mở khóa thành tích này bằng cách tạo các danh sách.\",reservations:\"Đặt chỗ\",reservations_description:\"Mở khóa thành tích này khi bạn đặt chỗ qua TableCheck.\",trending:\"Xu hướng\",trending_description:\"Mở khóa thành tích này khi danh sách của bạn được nhiều người xem.\"},century_club:{criteria:\"100 lượt đặt chỗ\",description:\"Hoàn thành 100 lượt đặt chỗ và gia nhập câu lạc bộ ẩm thực cao cấp.\",title:\"Câu lạc bộ Trăm Lượt\"},collection_builder:{criteria:\"10 danh sách công khai\",description:\"Tạo 10 danh sách công khai khác nhau với các chủ đề và ẩm thực đa dạng.\",title:\"Nhà sưu tầm danh sách\"},consistent_creator:{criteria:\"5 ảnh chụp nhà hàng\",description:\"Tải lên ảnh của 5 nhà hàng để thể hiện sự đều đặn của bạn.\",title:\"Người sáng tạo đều đặn\"},current_progress:{login_prompt:\"Bạn cần đăng nhập để xem tiến trình của mình\",title:\"Tiến trình đạt được thành tích này của bạn\"},director:{title:\"Người đam mê nhiếp ảnh\"},empty_description:\"Hãy quay lại sớm nhé!\",empty_title:\"Chưa có thành tích nào được mở khóa\",explorer:{criteria:\"5 địa điểm khác nhau\",description:\"Ghé thăm 5 nhà hàng khác nhau và bắt đầu khám phá.\",title:\"Nhà thám hiểm\"},foodie:{criteria:\"25 lượt đặt chỗ\",description:\"Hoàn thành 25 lần đặt chỗ để thể hiện sự tận tâm với việc thưởng thức ẩm thực.\",title:\"Thực khách tận tâm\"},gourmet_sensei:{criteria:\"50 lượt đặt chỗ\",description:\"Hoàn thành 50 lượt đặt chỗ và trở thành người sành ăn đáng tin cậy.\",title:\"Người mê ẩm thực\"},influencer:{criteria:\"Tổng 50 lượt lưu\",description:\"Đạt tổng số 50 lượt lưu trên tất cả các danh sách của bạn và trở thành người giới thiệu đáng tin cậy.\",title:\"Người có sức ảnh hưởng\"},legend:{criteria:\"50 địa điểm khác nhau\",description:\"Ghé thăm 50 nhà hàng khác nhau và trở thành huyền thoại địa phương.\",title:\"Huyền thoại địa phương\"},list_maker:{criteria:\"Danh sách công khai đầu tiên\",description:\"Tạo danh sách công khai đầu tiên và bắt đầu lựa chọn trải nghiệm ẩm thực.\",title:\"Khởi đầu danh sách\"},master_curator:{criteria:\"500 lượt lưu tổng cộng\",description:\"Đạt 500 lượt lưu tổng cộng trên tất cả các danh sách của bạn và trở thành bậc thầy trong nghệ thuật tuyển chọn.\",title:\"Bậc thầy tuyển chọn\"},photo_archiver:{criteria:\"40 ảnh địa điểm\",description:\"Tải lên ảnh của 40 địa điểm và tạo nên lịch sử ẩm thực bằng hình ảnh.\",title:\"Người lưu trữ ảnh\"},photo_enthusiast:{criteria:\"10 ảnh nhà hàng\",description:\"Tải lên ảnh của 10 nhà hàng và giúp mọi người khám phá trải nghiệm ẩm thực của bạn.\",title:\"Người yêu thích ảnh chụp nhà hàng\"},photographer:{criteria:\"25 ảnh của địa điểm\",description:\"Tải lên ảnh của 25 nhà hàng\",title:\"Nhiếp ảnh gia chuyên nghiệp\"},regular_diner:{criteria:\"5 lượt đặt chỗ\",description:\"Hoàn thành 5 lượt đặt chỗ và thiết lập thói quen thưởng thức ẩm thực của bạn.\",title:\"Thực khách thường xuyên\"},snap_shooter:{criteria:\"Ảnh đầu tiên\",description:\"Tải lên ảnh đầu tiên của bạn và giúp những thực khách khác khám phá món ăn tuyệt vời.\",title:\"Ảnh đầu tiên đăng tải\"},taste_curator:{criteria:\"250 lượt xem danh sách\",description:\"Nhận 250 lượt xem trên danh sách của bạn và giúp cộng đồng khám phá những địa điểm tuyệt vời.\",title:\"Người hỗ trợ cộng đồng\"},title:\"Thành tích\",trend_setter:{criteria:\"200 lượt lưu tổng cộng\",description:\"Đạt 200 lượt lưu tổng cộng trên tất cả các danh sách của bạn và trở thành người tuyển chọn được yêu thích.\",title:\"Người tuyển chọn được yêu thích\"},unlocked_at:\"Đã mở khóa {{date}}\",viral_selection:{criteria:\"500 lượt xem danh sách\",description:\"Nhận 500 lượt xem trên các danh sách của bạn\",title:\"Danh sách nổi bật phổ biến\"}},actions_btns:{share:\"Chia sẻ\"},activity:{empty_description:\"Sẽ có hoạt động sớm thôi!\",empty_title:\"Chưa có hoạt động nào\"},bookings:\"Đặt chỗ\",contributions:\"Đóng góp\",edit_profile:\"Chỉnh sửa hồ sơ\",experience_info:\"Kiếm XP bằng cách đặt chỗ, hoàn thành thử thách, chia sẻ ảnh và nhiều hơn nữa\",fetch_error:\"Lỗi khi lấy thông tin hồ sơ của bạn, <button>làm mới</button>\",image:{uploaded_at:\"Đã đăng vào {{date}} bởi {{username}}\"},joined_at:\"Tham gia {{date}}\",level:\"Cấp độ {{level}}\",lists:{no_lists_description:\"Người dùng này hiện chưa có danh sách công khai nào\",no_lists_description_owner:\"Bạn hiện chưa có danh sách nào\",no_lists_title:\"Không có danh sách công khai nào\"},modal:{badge_change_info:\"Nhận huy hiệu khi hoàn thành thử thách\",change_badge:\"Thay đổi huy hiệu\",change_banner:\"Thay đổi biểu ngữ\",change_user_image:\"Thay đổi ảnh hồ sơ\",error:{invalid_characters:\"{{field}} chứa ký tự không hợp lệ\",pristine_state:'{{field}} không được đặt là 