            "size": 279666,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head prefix=\"og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#\">\n    <title>Tabelog - Japan Food &amp; Restaurant Guide for Travelers</title>\n    <meta content=\"Find and book your perfect restaurant with &quot;Tabelog&quot;! Explore 906,966 restaurants across Japan. Discover top-rated spots in various categories based on unique rankings, user reviews, and photos that fit your purpose and budget!\" name=\"description\" />\n    <link media=\"only screen and (max-width: 640px)\" rel=\"alternate\" />\n    <meta content=\"width=1260\" name=\"viewport\" />\n    <link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/css/inbound/desktop/application.css?rst-v1-202611061746-86cebb7e3b9fb564dbb294f2f68e9421e64453e28f8afd11f00b2adfaa402df0\" />\n    <link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/inbound/desktop/object.css?rst-v1-202611061746-7d826142ecde9ac774d5131d7ee6762b36684b1b48d2d1b00af8bb6f3efa7d98\" /><link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/css/inbound/desktop/list/list_common.css?rst-v1-202611061746-9902ffa7f36079a6e2d5e5ade15816a9ac61d671bb16e38ad3ed780c1d840a85\" /><noscript></noscript><link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/css/restaurant/desktop/list/list_common_noscript.css?rst-v1-202611061746-f023e4d3b009df7585fe9d9cd876558abd98602594a2a231066e63fdd03f10d7\" /><link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/lib/jquery-ui-1.12.1.smoothness.custom.min.css?rst-v1-202611061746-c5c60f20207a5470c978a2855615ae604b3b20f88b7a4841de1711c46339e78d\" />\n    <link rel=\"stylesheet\" media=\"all\" href=\"https://tblg.k-img.com/stylesheets/lib/colorbox.css?rst-v1-202611061746-f4cec0ed48e7e3432e067401c68ea1a23d8b239c132f3ab90e4e940e24efb1ee\" /><link rel=\"stylesheet\" media=\"screen\" href=\"https://tblg.k-im