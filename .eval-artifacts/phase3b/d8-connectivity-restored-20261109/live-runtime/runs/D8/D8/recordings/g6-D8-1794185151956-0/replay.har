gories:{content_creator:\"יוצר תוכן\",content_creator_description:\"השג את ההישגים האלו על ידי העלאת תמונות מהמקומות שבהם ביקרת דרך TableCheck.\",default:\"ברירות מחדל\",explorer:\"חוקר\",explorer_description:\"השג את ההישגים האלו על ידי ביצוע הזמנות דרך TableCheck.\",influencer:\"משפיען\",influencer_description:\"השג את ההישגים האלו כשמשתמשים אחרים עוקבים אחרי הרשימות שלך.\",list_curator:\"אוצר רשימות\",list_curator_description:\"השג את ההישגים האלו על ידי יצירת רשימות.\",reservations:\"הזמנות\",reservations_description:\"השג את ההישגים האלו על ידי ביצוע הזמנות דרך TableCheck.\",trending:\"חם עכשיו\",trending_description:\"השג את ההישגים האלו על ידי קבלת צפיות ברשימות שלך.\"},century_club:{criteria:\"100 הזמנות\",description:\"השלם 100 הזמנות והצטרף למועדון הסועדים היוקרתי.\",title:\"מועדון המאה\"},collection_builder:{criteria:\"10 רשימות ציבוריות\",description:\"צור 10 רשימות ציבוריות שונות המכסות נושאים וסוגי מטבחים מגוונים.\",title:\"בונה אוספים\"},consistent_creator:{criteria:\"5 תמונות של מסעדות\",description:\"העלה תמונות של 5 מסעדות והראה את העקביות שלך.\",title:\"יוצר עקבי\"},current_progress:{login_prompt:\"יש להתחבר כדי לצפות בהתקדמות שלך\",title:\"ההתקדמות שלך בהישג זה\"},director:{title:\"חובב צילום\"},empty_description:\"בדוק שוב בקרוב!\",empty_title:\"עדיין לא נפתח אף הישג\",explorer:{criteria:\"5 מקומות שונים\",description:\"בקר ב-5 מסעדות שונות והתחל לגלות.\",title:\"חוקר בדרך\"},foodie:{criteria:\"25 הזמנות\",description:\"השלם 25 הזמנות והראה את המחויבות שלך לאכילה במסעדות.\",title:\"אורח מחויב\"},gourmet_sensei:{criteria:\"50 הזמנות\",description:\"השלם 50 הזמנות והפוך למומחה קולינרי.\",title:\"חובב אוכל\"},influencer:{criteria:\"50 שמירות בסך הכל\",description:\"השג 50 שמירות בסך הכל בכל הרשימות שלך והפוך לאוצר אמין.\",title:\"משפיען רשימות\"},legend:{criteria:\"50 מקומות שונים\",description:\"בקר ב-50 מסעדות שונות והפוך לאגדה מקומית.\",title:\"אגדה מקומית\"},list_maker:{criteria:\"הרשימה הציבורית הראשונה\",description:\"צור את הרשימה הציבורית ה