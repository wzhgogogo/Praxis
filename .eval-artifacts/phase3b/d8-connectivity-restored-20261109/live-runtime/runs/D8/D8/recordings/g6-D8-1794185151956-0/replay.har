u:\"Fugu (pez globo)\",fusion_international:\"Fusión e Internacional\",german:\"Alemán & austríaco\",greek:\"Griego\",gyoza:\"Gyoza (empanadillas)\",halal:\"Certificado halal\",hawaiian:\"Hawaiano y de las islas del Pacífico\",healthy:\"Saludable\",horumon:\"Horumonyaki (casquería a la parrilla)\",hotpot:\"Hot pot\",ice_cream:\"Helado\",indian:\"Indio\",indian_curry:\"Curry indio\",indonesian:\"Indonesio\",inn:\"Posada y alojamiento con desayuno\",international_fusion:\"Fusión & internacional\",irish:\"Irlandés\",italian:\"Italiano\",izakaya:\"Izakaya (taberna japonesa)\",izakaya_dining:\"Izakaya y restaurantes\",izakaya_short:\"Izakaya\",japanese:\"Japonés\",japanese_curry:\"Curry japonés\",japanese_noodles:\"Soba & Udon\",japanese_sweets:\"Dulces japoneses\",kaiseki:\"Kaiseki (japonés formal)\",kaiten_zushi:\"Sushi de cinta transportadora\",kamameshi:\"Kamameshi (pilaf japonés)\",kappo:\"Kappo (japonés tradicional)\",karaoke:\"Karaoke\",kissaten:\"Café japonés\",korean:\"Coreano\",korean_hotpot:\"Hot pot coreano\",kosher:\"Certificado kosher\",kushiage:\"Kushiage (pinchos fritos)\",kyoto_cuisine:\"Cocina de Kioto\",lounge:\"Salón\",malaysian:\"Malasio\",meat:\"Carne\",mediterranean:\"Mediterráneo\",mexican:\"Mexicano\",middle_eastern:\"Oriente Medio\",modern_asian:\"Asiático moderno\",modern_french:\"Francés moderno\",modern_indian:\"Indio moderno\",modern_italian:\"Italiano moderno\",modern_mexican:\"Mexicano moderno\",modern_spanish:\"Español moderno\",modern_sushi:\"Sushi de estilo occidental\",mongolian:\"Mongol\",mongolian_bbq:\"Barbacoa de Mongolia\",moroccan:\"Marroquí y norteafricano\",motsunabe:\"Nabe y motsunabe (hot pot)\",multiple_cuisines:\"{{cuisine}} + {{other_selected_cuisines_count}}\",nabe:\"Nabe (hot pot japonés)\",natural:\"Natural\",nepalese:\"Nepalés\",new_zealand:\"Neozelandés\",nightclub:\"Discoteca\",noodles:\"Ramen y fideos asiáticos\",oceanic:\"Oceánico\",oden:\"Oden (guiso japonés)\",okinawan:\"Okinawense\",okinawan_soba:\"Soba de Okina