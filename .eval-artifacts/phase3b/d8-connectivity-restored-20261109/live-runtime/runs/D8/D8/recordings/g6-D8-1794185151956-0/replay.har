other_selected_lists_count}}\",my_lists:\"รายการของฉัน\",no_followed_lists:\"คุณยังไม่ได้บันทึกรายการใด ๆ\",no_venue_saved_yet:\"ยังไม่ได้บันทึกร้านอาหาร\",open_until:\"<bold>เปิดบริการ</bold>จนถึง {{time}}\",ownership:{anonymous:\"โดย<span>ผู้ไม่ออกนาม</span>\",private:\"รายการส่วนตัว\",you:\"โดย<a>คุณ</a>\"},privacy_private_info:\"รายการของคุณจะมองเห็นได้เฉพาะคุณเท่านั้น\",privacy_public_info:\"ทุกคนจะมองเห็นรายการของคุณได้\",privacy_toggle:{description:\"เมื่อรายการของคุณถูกตั้งค่าเป็นส่วนตัว จะถูกแสดงผลและเข้าถึงได้โดยคุณเท่านั้น มีเพียงรายการสาธารณะที่จะถูกแบ่งปันให้ผู้อื่น\",title:\"ตั้งค่ารายการเป็นส่วนตัว\"},private_list_warning:\"รายการนี้ถูกทำให้เป็นส่วนตัวโดยเจ้าของ\",remove:\"ลบ\",save_list_info_msg:\"แตะไอคอนบันทึกบนร้านอาหารใดก็ได้ แล้วเลือกชื่อรายการนี้เพื่อเริ่มเพิ่มร้าน\",save_to_list:\"บันทึกไปยังรายการ\",saved_lists:\"รายการที่บันทึกไว้\",share_list:\"แบ่งปันรายการ\",share_list_info:\"สามารถแชร์จากลิงก์ได้เฉพาะรายการที่ตั้งค่าเป็นสาธารณะเท่านั้น ตรวจสอบและปรับการตั้งค่าการมองเห็นของคุณด้านล่าง\",switch_to_public_profile:\"เปลี่ยนเป็นโปรไฟล์สาธารณะ\",title:\"รายการ\",unavailable:\"รายการนี้ไม่สามารถใช้ได้\",unavailable_info:\"เจ้าของได้ตั้งค่าเป็นส่วนตัวหรือลบรายการออกไป\",unfollow:\"เลิกติดตาม\",update_list:\"อัปเดตรายการ\",venue_number:\"{{count}} ร้าน\",venue_number_plural:\"{{count}} ร้าน\",view_all_venues:\"ดูร้านอาหารทั้งหมด {{count}} ร้าน\"},xVe={description:\"ค้นพบและจองร้านอาหารที่ดีที่สุดในประเทศญี่ปุ่น ไม่ว่าคุณกำลังมองหาอาหารทานง่ายๆ หรืออาหารหรูๆ TableCheck คือทางเลือกที่ดีสำหรับคุณ ค้นหาร้านอาหารและจองโต๊ะได้ทุกที่\",explore_title:\"ค้นหาแผนที่ - {{universe}}\",keywords:{local_recommendation:\"แนะนำโดยคนท้องถิ่น\"},list_title:\"{{list}} | คัดสรรโดย TableCheck\",profile_description:\"{{bio_suffix}} | ชุมชน TableCheck\",profile_title:\"{{name}} - TableCheck\",shop_description:\"ค้นหาและจองที่ร้านอาหารที่ดีที่สุดในญี่ปุ่นด้วย TableCheck เริ่มการจองอย่างง่ายดายที่ร้าน {{shop_name}} เพื่อประสบการณ์ที่ยากจะลืมเลือน!\",shop_title:\"{{title}} - คู่มือร้านอาหาร - TableCheck\",title:\"TableCheck - จองที่ร้านอาหารยอดนิยมในประเทศญี่ปุ่น\"},zVe={account:\"บัญชี\",bookings:\"การจอง\",explore:\"สำรวจ\",home:\"หน้าแรก\",lists:\"รายการ\",requests:\"คำขอจอง\",vouchers:\"บัตรกำนัล\"},AVe={subtitle:\"มาหาอะไรอร่อยๆ ให้คุณทานกันเถอะ\",title:\"หน้านี้ถูกลบออกจากเมนูแล้ว\"},wVe={aichi:\"จังหวัดไอจิ\",fukuoka:\"จังหวัดฟุกุโอกะ\",hiroshima:\"จังหวัดฮิโรชิม่า\",hokkaido:\"จังหวัดฮอกไกโด\",kanagawa:\"จังหวัดคานากาว่า\",kyoto:\"จังหวัดเกียวโต\",miyagi:\"จังหวัดมิยากิ\",niigata:\"จังหวัดนีงาตะ\",okinawa:\"จังหวัดโอกินาว่า\",osaka:\"จังหวัดโอซากะ\",tokyo:\"จังหวัดโตเกียว\"},SVe={meta_description:\"นโยบายความเป็นส่วนตัวของ TableCheck\",page_title:\"นโยบายความเป็นส่วนตัว | TableCheck\"},LVe={content_not_available:\"นโยบายความเป็นส่วนตัวไม่สามารถใช้งานได้ในขณะนี้\"},RVe={event_details:\"ดูรายละเอียดอีเวนต์\",explore_map:\"สำรวจแผนที่\",help_page:\"หน้าวิธีใช้\",link_to_all_stores:\"ดูร้านอาหารทั้งหมด\",official_website:\"เว็บไซต์อย่างเป็นทางการ\"},jVe={kickstart_your_list:\"เริ่มสร้างรายการของคุณ\",reasons:{similar_booked_venues:\"ร้านอาหารที่คล้ายกับร้านที่คุณจอง\",similar_user_booked_venues:\"คนที่คล้ายกับคุณก็จองร้านเหล่านี้เช่นกัน\",trending_venues:\"ร้านอาหารที่กำลังได้รับความนิยม\"},recommendations_based_on:\"คำแนะนำของเราอ้างอิงจากประวัติการจองและความชอบของคุณ\",recommended_for_you:\"แนะนำสำหรับคุณ\",recommended_for_your_list:\"แนะนำสำหรับรายการของคุณ\",settings:{subtitle:\"ช่วยให้เราปรับคำแนะนำให้ตรงกับคุณและยกระดับประสบการณ์การรับประทานอาหารโดยรวมของคุณ\",title:\"ปรับคำแนะนำให้ดียิ่งขึ้น\"},trending_venues:\"ร้านอาหารที่กำลังเป็นที่นิยม\"},NVe={active:\"ดำเนินการอยู่\",any_date:\"วันใดก็ได้\",any_date_time:\"วัน/เวลาใดก็ได้\",any_time:\"ทุกเวลา\",datetime_at:\"{{date}} เวลา {{time}}\",datetime_between:\"{{date}} ระหว่าง {{start}} - {{end}}\",details:\"รายละเอียด\",img_alt:{empty_requests:\"คำขอที่รอดำเนินการหรือที่ผ่านมา จะแสดงที่นี่\"},inactive:\"ที่ผ่านมา\",info_msg:\"จัดการคำขอของคุณได้อย่างง่ายดาย\",login_subheader:\"ในการส่งคำขอ คุณต้องเข้าสู่ระบบ TableCheck ก่อน ผู้ใช้ใหม่สามารถสร้างบัญชีได้ด้านล่าง\",login_to_use:\"เข้าสู่ระบบเพื่อตรวจสอบคำขอของคุณ\",meta:{description:\"ดูและจัดการคำขอจองของคุณบน TableCheck — ติดตามคำขอที่ยังดำเนินการอยู่ และกลับไปดูคำขอในอดีตหรือที่ยกเลิกแล้ว\",title:\"TableCheck - คำขอจองของฉัน\"},no_active_requests:\"ไม่มีคำขอที่ดำเนินการอยู่\",no_inactive_requests:\"ไม่มีคำขอที่ผ่านมา\",notify_me:\"แจ้งให้ฉันทราบ\",notify_me_description:\"เราจะแจ้งให้คุณทราบหากมีโต๊ะว่าง\",rebook:\"จองอีกครั้ง\",request_policy_title:\"นโยบายการขอจอง\",sign_in_and_submit:\"ลงชื่อเข้าใช้และส่งคำขอ\",status:{accepted:\"ยืนยันแล้ว\",expired:\"หมดอายุแล้ว\",rejected:\"ยกเลิกแล้ว\",requested:\"กำลังรอการตอบรับ\"},stop_notification:\"หยุดการแจ้งเตือน\",terms_and_policy:\"เมื่อคุณส่งแบบฟอร์มนี้ แสดงว่าคุณยอมรับ<a>ข้อกำหนดและนโยบายที่เกี่ยวข้อง</a>ของ TableCheck\",title:\"คำขอจอง\"},EVe={book_now_future:\"คุณยังไม่มีการจองในอนาคต\\nจองโต๊ะถัดไปของคุณได้เลยตอนนี้\",book_now_past:\"คุณไม่มีประวัติการจองใดๆ มาก่อน\\nจองโต๊ะของคุณได้เลยตอนนี้\",details:\"รายละเอียด\",img_alt:{empty_bookings:\"มือหลายมือแบ่งจานแชร์\"},info_msg:\"จัดการการจองของคุณได้อย่างง่ายดาย\",login_to_use:\"เข้าสู่ระบบเพื่อตรวจสอบการจองของคุณ\",manage:\"จัดการ\",no_future_bookings:\"ไม่มีการจองในอนาคต\",no_past_bookings:\"ไม่มีการจองในอดีต\",onboarding:{panel:{description:\"หลังจองโต๊ะแล้ว แชร์รูปอาหารของคุณเพื่อรับตราและช่วยชุมชนของเราในการค้นหาร้านโปรดแห่งใหม่\",title:\"อัปโหลดรูปภาพและปลดล็อกความสำเร็จ\"}},past:\"อดีต\",rebook:\"จองใหม่\",status:{accepted:\"ตอบรับแล้ว\",attended:\"เข้าร่วมแล้ว\",cancelled:\"ยกเลิกแล้ว\",confirmed:\"ยืนยันแล้ว\",delay:\"ยืนยันแล้ว\",expired:\"หมดอายุแล้ว\",iou:\"ต้องชำระเงิน\",iou_auth:\"ต้องใช้บัตรเครดิต\",iou_deposit:\"ต้องชำระเงินมัดจำ\",iou_prepay:\"ต้องชำระเงิน\",late:\"ยืนยันแล้ว\",noshow:\"ไม่มาตามนัด\",pending:\"รอการยืนยันจากร้าน\",rejected:\"ปฏิเสธแล้ว\",request:\"คำขอ\",tentative:\"จองชั่วคราว\",unarrived:\"ยืนยันแล้ว\",waiting:\"เข้ารายการรอใช้บริการ\",waitlist_called:\"ยืนยันแล้ว\"},title:\"การจอง\",total:\"รวม\",upcoming:\"กำลังจะมาถึง\"},MVe={add_review:\"เพิ่มรีวิว\",be_first_to_review:\"เป็นคนแรกที่รีวิว!\",content_policy:\"นโยบายเนื้อหารีวิว\",content_policy_agreement:\"การโพสต์รีวิว แสดงว่าข้าพเจ้าได้ตกลงตาม <span>นโยบายเนื้อหาของ TableCheck</span>\",delete_review:\"ลบรีวิว\",delete_review_confirm:\"ใช่ ลบ\",edit_review:\"แก้ไขรีวิว\",highlights:\"ไฮไลท์\",highlights_question:\"ไฮไลท์มีอะไรบ้าง?\",last_reviewed_on:\"รีวิวล่าสุดเมื่อ {{date}}\",last_visited_shop_at:\"เยี่ยมชมล่าสุดเมื่อ {{date}}\",locals:\"คนท้องถิ่น\",locals_say:\"ความคิดเห็นจากคนท้องถิ่น\",no_reviews_description:\"ผู้ใช้รายนี้ยังไม่มีรีวิวในขณะนี้\",no_reviews_description_owner:\"คุณยังไม่มีรีวิวในขณะนี้\",no_reviews_title:\"ยังไม่มีรีวิว\",overall_rating:\"คะแนนรวม\",pick_up:\"เลือกได้สูงสุด 3 รายการ\",rate_cta_question:\"ท่านเคยมาใช้บริการไหม? แชร์ประสบการณ์ของท่านได้เลย\",rate_review:\"ให้คะแนนและรีวิว\",rejected_photo_0:\"รูปภาพที่ถูกปฏิเสธ {{count}} รูป\",review_created:\"รีวิวถูกสร้างขึ้นแล้ว\",review_creation_error:\"เกิดข้อผิดพลาดขณะสร้างรีวิว\",review_prompt:\"คุณแน่ใจหรือว่าต้องการลบรีวิวนี้?<br/>\\nการลบนี้จะรวมถึงการลบ <b>รูปภาพทั้งหมดที่อัปโหลด</b> พร้อมกับรีวิว และไม่สามารถย้อนกลับได้\",review_reminder_subtitle:\"กรุณาให้คะแนนประสบการณ์การรับประทานล่าสุดของท่าน เพื่อช่วยเหลือผู้ที่มีความสนใจเหมือนกัน\",review_text_rejected:\"ความเห็นนี้ถูกปฏิเสธเนื่องจากไม่สอดคล้องกับ <Link>นโยบายเนื้อหา</Link>ของเรา กรุณาแก้ไขรีวิวและลองใหม่อีกครั้ง\",review_update_error:\"เกิดข้อผิดพลาดในการอัปเดตรีวิว\",review_updated:\"รีวิวได้รับการอัปเดตแล้ว\",reviewed_on:\"รีวิววันที่ {{date}}\",reviews_count_0:\"รีวิว {{count}} รายการ\",reviews_reminder_title:\"พร้อมให้รีวิวหรือยัง?\",share_experience:\"แบ่งปันประสบการณ์ของคุณ\",share_image_description:\"แบ่งปันช่วงเวลาที่คุณชื่นชอบจากการเยี่ยมชมโดยการอัปโหลดรูปภาพไม่กี่รูปด้านล่างนี้\",show_pictures_reviews:\"แสดงเฉพาะรีวิวที่มีรูปภาพ\",show_verified_reviews:\"แสดงเฉพาะรีวิวที่ผ่านการยืนยัน\",star_rating:\"{{rating}}/5\",title:\"รีวิว\",top_rated:\"ได้รับคะแนนสูงสุด\",top_rated_description:'ป้าย \"ได้รับคะแนนสูงสุด\" แสดงร้านอาหารที่ได้รับคะแนนยอดเยี่ยมจากลูกค้า',travelers_say:\"ความคิดเห็นจากนักท่องเที่ยว\",travellers:\"นักเดินทาง\",verified:\"ยืนยันแล้ว\",went_wrong_question:\"มีปัญหาอะไรเกิดขึ้นบ้าง?\",your_review:\"รีวิวของคุณ\"},JVe={action_btns:{search_area:\"ค้นหาในพื้นที่นี้\",show_nearest_results:\"แสดงผลลัพธ์ที่ใกล้เคียงที่สุด\",view_map:\"ดูแผนที่\"},ai_disclaimer:\"AI สามารถผิดพลาดได้ โปรดตรวจสอบก่อนจอง!\",ai_suggestions:{afternoon_tea_for_2_this_saturday:\"ชายามบ่ายสำหรับ 2 ท่านวันเสาร์นี้\",all_you_can_drink_for_4_people_tonight:\"4 ท่าน คืนนี้\",available_today:\"ว่างวันนี้\",brunch_in_tokyo:\"บรันช์ในโตเกียว\",business_lunch_near_tokyo_station:\"มื้อเที่ยงธุรกิจใกล้สถานีโตเกียว\",desserts_in_kyoto:\"ขนมหวานในเกียวโต\",family_restaurant_nearby:\"ร้านอาหารครอบครัวใกล้ๆ\",friday_night_for_2:\"คืนวันศุกร์ สำหรับ 2 ท่าน\",italian_for_2_saturday_night:\"อาหารอิตาเลียนสำหรับ 2 ท่าน คืนวันเสาร์\",izakaya_for_4_tonight:\"อิซากายะสำหรับ 4 ท่าน คืนนี้\",japanese_in_asakusa_at_7pm:\"อาหารญี่ปุ่นที่อาซากุสะ เวลา 19:00 น.\",kaiseki_for_2_next_week:\"ไคเซกิสำหรับ 2 ท่านสัปดาห์หน้า\",\"late-night_dinner_omotesando\":\"ซูชิมื้อกลางวันวันเสาร์\",ramen_near_shinjuku:\"ราเมนใกล้ชินจูกุ\",sushi_near_me:\"ซูชิใกล้ฉัน\",tempura_in_asakusa_at_7pm:\"อาซากุสะ 19:00 น.\",tempura_in_ebisu:\"เทมปุระในโอซาก้า\",traditional_japanese_dining:\"การรับประทานอาหารญี่ปุ่นแบบดั้งเดิม\",vegetarian_options_near_me:\"ตัวเลือกมังสวิรัติใกล้ฉัน\",yakiniku_in_shibuya:\"ยากินิกุในชิบูย่า\"},alternative_suggestions:\"ตัวเลือกอื่น ๆ ที่แนะนำ\",are_you_looking_for:\"คุณกำลังมองหา...\",available_for_your_date:\"ว่างในวันที่คุณเลือก\",bookable_now:\"จองได้ทันที\",budget:\"งบประมาณ\",clear_filters:\"ล้างตัวกรองทั้งหมด\",cuisines_search_no_results:\"ไม่มีประเภทอาหารที่ตรงกับการค้นหาของคุณ\",cuisines_search_placeholder:\"ค้นหาประเภทอาหาร\",diners_favourites:\"ร้านอาหารโปรดของนักทาน\",explore_further:\"สำรวจเ