hort:\"御好燒\",omakase:\"主廚搭配\",omurice:\"蛋包飯\",organic:\"有機認證\",other:\"其他\",oyster:\"生蠔吧\",pancakes:\"鬆餅\",pasta:\"義大利麵\",pho:\"越南河粉\",pizza:\"披薩\",portuguese:\"葡萄牙料理\",poultry:\"雞肉、禽肉料理\",pub:\"酒館\",ramen:\"拉麵\",robatayaki:\"爐端燒\",russian:\"俄羅斯與東歐料理\",ryokan:\"日本旅館\",sake_bar:\"清酒、燒酎酒吧\",sandwiches:\"三明治\",scandinavian:\"瑞典、斯堪的納維亞料理\",scottish:\"蘇格蘭料理\",seafood:\"海鮮\",shabu_shabu:\"涮涮鍋（火鍋）\",shabu_shabu_short:\"涮涮鍋\",shanghai:\"上海菜\",shellfish:\"蟹、貝類\",sichuan:\"川菜\",singaporean:\"新加坡料理\",soba:\"蕎麥麵\",soba_short:\"蕎麥麵\",soba_udon:\"蕎麥麵和烏龍麵\",south_american:\"拉美、南美料理\",spanish:\"西班牙料理\",sports_bar:\"體育觀賽酒吧\",steak:\"牛排\",sukiyaki:\"壽喜燒\",suppon:\"甲魚\",sushi:\"壽司\",sushi_sashimi:\"壽司及生魚片\",sweets:\"甜點\",taiwanese:\"台灣料理\",takoyaki:\"章魚燒\",tantanmen:\"擔擔麵\",tapas:\"西班牙小菜\",tea:\"下午茶\",tempura:\"天婦羅\",teppanyaki:\"鐵板燒\",texmex:\"美國西南、德州墨西哥料理\",thai:\"泰國料理\",thai_curry:\"泰國咖哩\",thai_hotpot:\"泰式火鍋\",title:\"料理類型\",tofu:\"豆腐\",tonkatsu:\"炸豬排\",tsukemen:\"沾麵\",turkish:\"土耳其料理\",udon:\"烏龍麵\",udon_short:\"烏龍麵\",unagi:\"鰻魚\",vegan:\"純素\",vegetables:\"蔬菜\",vegetarian:\"素食\",vietnamese:\"越南料理\",western:\"西式料理\",wine_bar:\"葡萄酒吧\",wine_cocktails:\"葡萄酒和雞尾酒\",yakiniku:\"燒肉、韓式烤肉\",yakiniku_bbq:\"烤肉和燒烤\",yakiniku_short:\"燒肉\",yakisoba:\"日式炒麵\",yakitori:\"燒鳥、串燒\",yakitori_short:\"燒鳥\",yoshoku:\"日式西餐（洋食）\"},IXe={description:\"您的客戶評分顯示您遵守預訂的可靠程度，讓餐廳知道您是值得信賴的客人。評分越高，可解鎖的福利越多。\",explainer:{factors:{reliability:{body:\"準時赴約是提升客戶評分最快的方式。\",title:\"可靠性\"},reservation_history:{body:\"您長期以來在 TableCheck 餐廳預訂和用餐的頻率。\",title:\"預訂紀錄\"},transactions:{body:\"透過平台完成的預訂和消費。\",title:\"交易\"},venues_visited:{body:\"您透過 TableCheck 預訂過的不同餐廳數量。\",title:\"到訪餐廳\"}},factors_intro:\"客戶評分反映您在 TableCheck 上的用餐情況，基於以下要素：\",factors_title:\"評分要素\",faq:{booking_block:{answer:\"您的評分絕不會阻止預訂。但部分餐廳可能會在確認預訂前要求支付訂金或提供信用卡擔保。\",question:\"評分會阻止我預訂嗎？\"},data_used:{answer:\"僅使用您透過 TableCheck 的預訂紀錄、到訪餐廳和已完成的交易。平台以外的資料一律不使用。\",question:\"會使用哪些資料？\"},improve:{answer:\"遵守您的預訂、準時到店，並在計劃有變時盡早取消。隨著完成的預訂不斷累積，評分也會逐步提升。\",question:\"如何提高我的評分？\"},no_score:{answer:\"在透過 TableCheck 完成幾次預訂後才會產生評分。在此之前，餐廳只會將您視為新客。\",question:\"為什麼我還沒有評分？\"},no_show:{answer:\"不會。單次失約的影響有限，只要繼續遵守後續的預訂，評分就會恢復。\",question:\"一次失約會毀掉我的評分嗎？\"},who_can_see:{answer:\"只有您預訂的餐廳可以看到。餐廳在您預訂時只會看到您的評分，絕不會看到您在其他餐廳用餐的詳細資訊。\",question:\"誰能看到我的評分？\"}},faq_title:\"常見問題\",hero_image_alt:\"一位顧客正在 TableCheck 應用程式中查看自己的客戶評分\",hero_subtitle:\"使用 TableCheck，獲得回饋。\",hero_title:\"客戶評分\",how_title:\"如何運作？\",other_faqs_cta:\"其他常見問題\",perks:{membership:\"會員資格申請權\",offers:\"優惠與福利\",venue_access:\"專屬餐廳預訂資格\"},steps:{avoid_cancel:{body:\"臨時取消和未到店（失約）對評分影響最大，請盡量避免。\",title:\"避免臨時取消\"},benefits:{body:\"更高的評分將為您帶來優惠、福利以及專屬餐廳的預訂資格。\",title:\"享受福利\"},book:{body:\"透過 TableCheck 完成預訂有助於提升您的客戶評分。\",title:\"在 TableCheck 上預訂\"},habits:{body:\"完成的預訂越多，評分就會隨時間不斷提升。\",title:\"保持穩定的用餐習慣\"}},what_is_intro:\"客戶評分反映您遵守預訂的可靠程度，讓餐廳一眼就能看出您是值得信賴的客人。評分越高，獲得的福利越多，包括：\",what_is_title:\"什麼是客戶評分？\"},guidance:{frequency:{complete_visits:\"在90天內再完成{{required_actions}}次到店，有助於提升您的評分。\"},recency:{come_back:\"在{{within_days}}天內再次預訂，有助於提升您的評分。\"},reliability:{complete_reservations:\"再完成{{required_actions}}次無取消的預訂，有助於提升您的評分。\"}},insights:{booking_frequency:{description:\"透過TableCheck更頻繁地預訂是提升此項最快的方式。<actionLink>尋找餐廳</actionLink>\",title_value_0:\"近期預訂: <bold>{{count}}</bold>\"},improve_pill:\"提升您的評分\",reliability:{description:\"衡量您如約到店的預訂情況。臨時取消和未到店影響最大。\",title_value:\"可靠率: <bold>{{value}}</bold>\"},transactions:{description:\"透過TableCheck Pay支付的訂金和付款計入此項。<actionLink>Pay的使用方式</actionLink>\",title_value:\"消費金額: <bold>{{value}}</bold>\"},venues_visited:{description:\"透過TableCheck預訂新餐廳會隨時間提升此項。<actionLink>探索餐廳</actionLink>\",title_value_0:\"到訪餐廳: <bold>{{count}}</bold>\"}},insights_period:\"過去12個月\",insights_title:\"您的評分分析\",levels:{excellent:\"極佳\",fair:\"普通\",good:\"良好\",great:\"優秀\",low:\"偏低\"},offers:{book_with_offer:\"使用優惠預訂\",claim_failed:\"無法領取此優惠，請重試。\",code_copied:\"已複製優惠碼\",copy:\"複製\",promo_code:\"優惠碼\",select_venue:\"選擇餐廳\"},offers_title:\"優惠和福利\",overall_score:\"總分\",percentile:\"前 {{percent}}%\",perks:{claim:\"領取\",claimed:\"已領取\",score_required:\"需達到「{{level}}」評分\"},status:{inactive:{description:\"完成下一次預訂後，您的評分將恢復。每次根據您的預訂記錄重新計算。\"},insufficient_history:{description:\"完成5次預訂後，您的評分將會顯示。取消和未到店不計入總數。\"},score_suppressed:{description:\"完成下一次預訂後，您的評分將恢復。每次根據您的預訂記錄重新計算。\"},unavailable:{description:\"我們暫時無法顯示您的評分。請稍後再試。\"}},title:\"客戶評分\",venue_diversity_levels:{multi_venue:\"多家餐廳\",not_established:\"尚未確定\",single_venue:\"單一餐廳\"},verify:{code_input_label:\"驗證碼，第 {{index}} 位\",code_resent:\"驗證碼已發送\",code_sent:\"我們已向 <strong>{{phone}}</strong> 發送了簡訊。請在下方輸入驗證碼。\",cta:\"發送驗證碼\",heading:\"僅限日本使用者\",invalid_code:\"驗證碼不正確，請再試一次。\",japan_only:\"請輸入日本手機號碼。\",phone_verified:\"手機號碼已驗證\",resend:\"重新發送驗證碼\",resend_countdown:\"{{seconds}} 秒後重新發送\",title:\"驗證手機號碼\"},verify_description:\"目前僅開放給日本的使用者，即將推廣至其他地區。驗證您的日本手機號碼，即可查看您的評分及可享受的福利。\"},OXe={app_issue:\"很抱歉，應用程式發生錯誤。\",page_not_found:\"很抱歉，找不到您要求的頁面\"},WXe={badge:{explanation:\"此店家支援快速預訂，讓您能以最快的方式預訂座位。\"},book_now:\"立即預訂\",confirmation_content:{add_request:\"為您的預訂新增需求（選填）\",add_request_placeholder:\"例如：請安排靠窗座位\",add_request_title:\"新增需求\",added:\"已新增\",agree_venue_policy_0:\"我同意上述餐廳政策。\",booking_policy:\"預訂政策\",confirm_booking:\"確認預訂\",edit_email_hint:\"您可以在<accountLink>帳戶</accountLink>頁面變更您的 TableCheck 電子郵件地址。\",express_booking_description:\"快速預訂是於指定餐廳預訂座位最快速的方式。如需更符合您需求的體驗，請參閱下方座位與菜單選項\",fix_required_fields:\"請修正必填資訊\",guest_details:\"用餐者資訊\",guests:\"{{count}} 位賓客\",holding_table:\"我們正在為您保留座位，剩餘 {{time}}\",optional:\"選填\",read_more:\"閱讀更多\",request_helper:\"餐廳無法保證滿足所有需求，但會盡力為您安排。\",review_booking_policy:\"查看預訂政策\",seat_reservation_description:\"透過快速預訂，將為您的同行賓客預留一張餐桌。如需更符合您需求的體驗，請參閱座位與菜單選項。\",seat_reservation_title:\"座位預訂\",table_expired:\"座位保留時間已過，您仍可嘗試完成預訂，但可能已無空位。\",terms_and_policy:\"送出此表單即表示您同意相關<termsLink>條款與政策</termsLink>。\",title:\"確認您的預訂\",view_options:\"查看選項\",your_details:\"您的資訊\"},continue_without_login:\"不登入繼續\",description:\"顯示提供快速預訂的店家，讓您立即預訂座位。\",error_content:{dupe_reservation:{banner:\"您已在此時段預訂了類似的訂位。{{venueName}} 不接受重複訂位。\",title:\"重複訂位\"},find_another_time_btn:\"尋找其他時間\",unexpected_error:{banner:\"發生未預期的錯誤。您仍可透過下方按鈕訂位。\",title:\"訂位未成功\"},view_my_bookings_btn:\"查看我的訂位\"},login_subheader:\"使用現有的 TableCheck 帳戶，或免費建立帳戶以預訂 <bold>{{venueName}}</bold>\",result_content:{booking_complete_title:\"訂位已完成\",booking_pending_title:\"訂位待確認\",manage_booking:\"管理訂位\",pending_subtext:\"確認後，我們會透過 {{email}} 通知您。\",pending_title:\"餐廳確認中\",reservation_id:\"訂位編號\",success_title:\"已成功為您完成訂位。\"},select_slot_content:{title:\"選擇日期與時間\"},title:\"快速預訂\"},FXe={all_you_can_eat:\"吃到飽\",casual_lively:\"休閒活潑\",chefs_counter:\"主廚吧台\",entertainment:\"娛樂\",family_friendly:\"適合家庭\",gluten_free:\"不含麩質\",great_view:\"風景優美\",intimate_setting:\"私密環境\",large_groups:\"大型團體\",late_night_dining:\"深夜用餐\",pet_friendly:\"允許攜帶寵物\",private_dining:\"私人用餐\",rooftop_terrace:\"屋頂和露台\",seasonal_menu:\"季節菜單\",traditional_setting:\"傳統環境\",vegetarian:\"素食\"},DXe={ramen:\"拉麵\",sushi:\"壽司\"},$Xe={add:\"新增\",all:\"全部\",amount:\"金額\",api_issues:\"我們目前遇到一些問題，正在積極處理中。\",apply:\"套用\",average:\"平均 {{amount}}\",average_dinner:\"晚餐人均\",average_lunch:\"午餐人均\",back:\"返回\",balance:\"餘額\",book:\"預訂\",browse_venues:\"瀏覽所有餐廳\",campaign_period:\"活動期間\",cancel:\"取消\",city_region:\"{{city}}, {{region}}\",clear:\"清除\",close:\"關閉\",closed:\"未營業\",confirm:\"確認\",connect:\"連接\",daily:\"每天\",date:\"日期\",date_time:\"時間\",days_week:{friday:\"星期五\",monday:\"星期一\",saturday:\"星期六\",sunday:\"星期日\",thursday:\"星期四\",tuesday:\"星期二\",wednesday:\"星期三\"},days_week_short:{friday:\"週五\",monday:\"週一\",saturday:\"週六\",sunday:\"週日\",thursday:\"週四\",tuesday:\"週二\",wednesday:\"週三\"},delete:\"刪除\",dinner:\"晚餐\",disconnect:\"解除連接\",download_app:{android:\"Android應用程式即將上線！\",android_redirection:\"將為您導向TableCheck的網站\",ios:\"TableCheck正在為您導向，請稍等一下...\"},earned:\"獲得\",edit:\"編輯\",entered:\"已參加\",error_load_more:\"載入更多內容時發生錯誤\",filters:\"篩選器\",go_to_next_page:\"前往下一頁\",go_to_page:\"前往第 {{page}} 頁\",go_to_previous_page:\"回到上一頁\",got_it:\"明白了\",holiday