តូម៉េ និង ប្រាំងស៊ីប\",SV:\"អែលសាល់វ៉ាឌ័រ\",SX:\"សីងម៉ាធីន\",SY:\"ស៊ីរី\",SZ:\"ស្វាស៊ីឡង់\",TA:\"ទ្រីស្តង់ដាចូនហា\",TC:\"កោះទួរក់ និងកៃកូស\",TD:\"ឆាដ\",TF:\"ដែនដីបារាំងនៅភាគខាងត្បូង\",TG:\"តូហ្គោ\",TH:\"ថៃ\",TJ:\"តាហ្ស៊ីគីស្ថាន\",TK:\"តូខឺឡៅ\",TL:\"ទីម័រខាងកើត\",TM:\"តួកម៉េនីស្ថាន\",TN:\"ទុយនីស៊ី\",TO:\"តុងហ្គា\",TR:\"ទួរគៀ\",TT:\"ត្រីនីដាដ និងតោបាហ្គូ\",TV:\"ទូវាឡូ\",TW:\"តៃវ៉ាន់\",TZ:\"តង់សានី\",UA:\"អ៊ុយក្រែន\",UG:\"អ៊ូហ្គង់ដា\",UM:\"កោះអៅឡាយីងអាមេរិក\",US:\"សហរដ្ឋអាមេរិក\",UY:\"អ៊ុយរូហ្គាយ\",UZ:\"អ៊ូសបេគីស្ថាន\",VA:\"បុរីវ៉ាទីកង់\",VC:\"សង់វីងសិន និង ហ្គ្រើណាឌីន\",VE:\"វេនេហ្ស៊ូអេឡា\",VG:\"កោះវឺជិនចក្រភពអង់គ្លេស\",VI:\"កោះវឺជីនអាមេរិក\",VN:\"វៀតណាម\",VU:\"វ៉ានូទូ\",WF:\"វ៉ាលីស និង ហ្វួទូណា\",WS:\"សាម័រ\",XK:\"គូសូវ៉ូ\",YE:\"យេម៉ិន\",YT:\"ម៉ាយុត\",ZA:\"អាហ្វ្រិកខាងត្បូង\",ZM:\"សំប៊ី\",ZW:\"ស៊ីមបាវេ\",ZZ:\"តំបន់មិនស្គាល់\"}},HDe={about_tc:\"អំពី TableCheck\",action_btns:{change:\"ផ្លាស់​ប្តូរ\",create:\"បង្កើត\",download_receipt:\"ទាញយកបង្កាន់ដៃអេឡិចត្រូនិករបស់អ្នក\",issue_receipt:\"ចេញបង្កាន់ដៃ\",remove:\"យក​ចេញ\",resend_confirmation_email:\"ផ្ញើអ៊ីមែលបញ្ជាក់របស់អ្នកឡើងវិញ\",save_profile:\"រក្សាទុកប្រវត្តិរូប\",show_receipt:\"បង្ហាញបង្កាន់ដៃ\"},change_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",communications:{subscriptions:{body_text:\"អ្នកកំពុងទទួលព័ត៌មានថ្មីៗតាមអ៊ីមែលពីភោជនីយដ្ឋានខាងក្រោម\",empty_description:\"ជាវទៅកាន់កន្លែងនានា ដើម្បីទទួលបានព័ត៌មានថ្មីៗចុងក្រោយបង្អស់\",none:\"អ្នកមិនមានការជាវទេ\",remove_msg:\"តើអ្នកប្រាកដថាចង់ឈប់តាមដាន {{shop_name}} មែនទេ?\",title:\"ការជាវ\",unsubscribe:\"ឈប់ជាវ\",your_subscriptions:\"ការជាវរបស់អ្នក\"},title:\"ភោជនីយដ្ឋានដែលបានតាមដាន\"},confirm_email_change_msg:\"ដើម្បីបញ្ចប់ការផ្លាស់ប្តូរអ៊ីមែលរបស់អ្នកទៅ <bold> {{newEmail}} </bold> សូមប្រើតំណផ្ទៀងផ្ទាត់ដែលបានផ្ញើទៅ <bold> {{currentEmail}} </bold>\",confirm_email_msg:\"យើងបានផ្ញើអ៊ីមែលទៅ <bold>{{email}}</bold> សូមបញ្ជាក់វាដើម្បីការពារគណនីរបស់អ្នក។\\nប្រសិនបើអ៊ីមែលមិនត្រឹមត្រូវ អ្នកនឹងមិនទទួលបានព័ត៌មានថ្មីៗអំពីការកក់ទេ។ សូមបង្កើតគណនីថ្មីដើម្បីកែតម្រូវ។\",create_password:{message:\"កំណត់ពាក្យសម្ងាត់ថ្មី ដើម្បីចូលតាមអ៊ីមែល និងប្រើកម្មវិធីរបស់យើង\",title:\"បង្កើតពាក្យសម្ងាត់\"},credit_cards:{details:\"{{brand}} **** {{last_four_digits}}\",empty_description:\"កាតដែលបានរក្សាទុកនឹងបង្ហាញនៅទីនេះ\",expires:\"ផុតកំណត់\",none:\"មិនមានប័ណ្ណឥណទានដែលបានរក្សាទុកទេ។\",primary:\"ចម្បង\",remove:\"ដកប័ណ្ណចេញ\",remove_msg:\"តើអ្នកប្រាកដថាចង់ដកប័ណ្ណនេះចេញមែនទេ?\"},credits:{balance:\"សមតុល្យរបស់អ្នក៖\",credit_amount:\"0 ក្រេឌីត\",more_info:\"តើក្រេឌីតជាអ្វី?\",title:\"ក្រេឌីត TableCheck\"},current_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",delete_account:\"លុប​គណនី\",delete_msg_warning:\"ប្រសិនបើអ្នកបន្ត ព័ត៌មានគណនី និងការកក់ពាក់ព័ន្ធទាំងអស់ ព្រមទាំងពិន្ទុ TC របស់អ្នកនឹងត្រូវលុបជាអចិន្ត្រៃយ៍ ហើយសកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។\",delete_tc_account:\"លុប​គណនី TableCheck\",delete_tc_account_title:\"ការលុបគណនី\",disconnect_account:\"ផ្ដាច់គណនី\",disconnect_social_msg:\"តើអ្នកប្រាកដថាចង់ផ្ដាច់គណនីនេះមែនទេ?\",discover_and_book:\"ស្វែងរក កក់ និងរក្សាទុកភោជនីយដ្ឋានល្អៗបំផុត ជាមួយគណនី TableCheck ឥតគិតថ្លៃ។\",empty_transaction_description:\"ប្រតិបត្តិការណាមួយដែលអ្នកមាននឹងបង្ហាញនៅទីនេះ\",enter_current_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",enter_name:\"បញ្ចូល​ឈ្មោះ​របស់​អ្នក\",enter_new_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",errors:{password_incorrect:\"ពាក្យសម្ងាត់បច្ចុប្បន្នមិនត្រឹមត្រូវ\",password_used:\"សូមជ្រើសរើសពាក្យសម្ងាត់ថ្មី ពាក្យសម្ងាត់នេះធ្លាប់ត្រូវបានប្រើពីមុនហើយ\"},for_restaurateurs:\"សម្រាប់ម្ចាស់ភោជនីយដ្ឋាន\",generate_receipt:\"បង្កើតបង្កាន់ដៃ\",help:\"ជំនួយ\",membership:{joined:\"បានចូលរួម\",locations_used:\"ទីតាំងដែលបានប្រើ\",name_and_number:\"{{membership_name}} ({{membership_number}})\",no_memberships_msg:\"អ្នកមិនទាន់បានភ្ជាប់សមាជិកភាពណាមួយនៅឡើយទេ។<br/>អ្នកអាចភ្ជាប់សមាជិកភាពនៅពេលធ្វើការកក់។\",number:\"លេខសមាជិក\",program:\"កម្មវិធី\",remove:\"ដកសមាជិកភាពចេញ\",remove_msg:\"តើអ្នកប្រាកដថាចង់ដកសមាជិកភាពនេះចេញពីគណនីរបស់អ្នកមែនទេ?\",title:\"សមាជិកភាព\"},meta:{description:\"មើលប្រវត្តិនៃការកក់របស់អ្នក៖ រាល់ព័ត៌មាននៃការកក់របស់អ្នក ពីអតីតកាលរហូតដល់ការកក់នាពេលខាងមុខ អាចត្រូវបានគ្រប់គ្រងនៅក្នុងបញ្ជីងាយស្រួលមួយ។\",title:\"TableCheck - ប្រវត្តិនៃការកក់\"},new_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",no_transactions:\"មិនមានប្រតិបត្តិការទេ។\",notifications:{marketing_info:\"ទទួលបានព័ត៌មាន និងព័ត៌មានថ្មីៗពីក្រុម TableCheck ជាមុនសិន។\",notify_sms:\"ជូនដំណឹងខ្ញុំអំពីការកក់តាមរយៈសារ SMS\",sms_info:\"ទទួលបានការជូនដំណឹងពីភោជនីយដ្ឋានដោយប្រើសារ SMS ។ អ្នកនឹងនៅតែទទួលបានការជូនដំណឹងតាមអ៊ីមែល។\",subscribe_tc_marketing:\"ជាវព្រឹត្តិប័ត្រព័ត៌មាន TableCheck\",title:\"គ្រប់គ្រងការជូនដំណឹង\"},payment_method:{bank_transfer:\"ការផ្ទេរប្រាក់តាមធនាគារ\"},payment_status:{deposit:\"ប្រាក់កក់\",paid:\"បានបង់\",refunded:\"បានសងប្រាក់វិញ\"},payment_type:{auth_hold:\"ការបង្កកប្រាក់\",cancel_fee:\"ថ្លៃលុបចោល\",contactless_pay:\"TableCheck Pay\",prepay:\"ការទូទាត់ជាមុន\"},please_confirm_email:\"សូមបញ្ជាក់អ៊ីមែលរបស់អ្នក។\",please_confirm_email_change:\"សូមបញ្ជាក់ការផ្លាស់ប្តូរអ៊ីមែល\",profile:\"ប្រវត្តិរូប\",providers:{facebook:\"Facebook\",google_oauth2:\"Google\",yahoojp:\"Yahoo! JAPAN\"},public_profile:{achievements:{adventurer:{criteria:\"20 កន្លែងផ្សេងៗ\",description:\"ធ្វើដំណើរទៅតាមភោជនីយដ្ឋាន 20 ផ្សេងៗ ហើយពង្រីកទស្សនៈរបស់អ្នក។\",title:\"អ្នកដើរផ្សងព្រេង\"},baby_diner:{criteria:\"ការកក់ដំបូង\",description:\"សូមបញ្ចប់ការកក់ដំបូងរបស់អ្នកលើ TableCheck។\",title:\"ស្វាគមន៍ភ្ញៀវអាហារ\"},categories:{content_creator:\"អ្នកបង្កើតមាតិកា\",content_creator_description:\"បើកសមិទ្ធិផលទាំងនេះដោយផ្ទុករូបថតទៅកាន់កន្លែងដែលអ្នកបានទៅពិនិត្យតាមរយៈ TableCheck។\",default:\"លំនាំដើម\",explorer:\"អ្នកស្វែងរក\",explorer_description:\"បើកសមិទ្ធិផលទាំងនេះសម្រាប់ការកក់តាម TableCheck។\",influencer:\"អ្នកមានឥទ្ធិពល\",influencer_description:\"បើកសមិទ្ធិផលទាំងនេះដោយមានអ្នកប្រើប្រាស់ផ្សេងទៀតតាមដានបញ្ជីរបស់អ្នក។\",list_curator:\"អ្នករៀបចំបញ្ជី\",list_curator_description:\"បើកសមិទ្ធិផលទាំងនេះដោយបង្កើតបញ្ជីជាច្រើន។\",reservations:\"ការកក់\",reservations_description:\"បើកសមិទ្ធិផលទាំងនេះសម្រាប់ការកក់តាម TableCheck។\",trending:\"ពេញនិយម\",trending_description:\"បើកសមិទ្ធិផលទាំងនេះដោយទទួលបានការមើលលើបញ្ជីរបស់អ្នក។\"},century_club:{criteria:\"ការកក់ ១០០ ដង\",description:\"បំពេញការកក់ ១០០ ដង ហើយចូលរួមក្លឹបអ្នកបរិភោគលំដាប់កំពូល។\",title:\"ក្លឹបរយឆ្នាំ\"},collection_builder:{criteria:\"បញ្ជីសាធារណៈចំនួន 10\",description:\"បង្កើតបញ្ជីសាធារណៈចំនួន 10 ផ្សេងៗគ្នា ដែលគ្របដណ្ដប់លើប្រធានបទ និងម្ហូបផ្សេងៗ។\",title:\"អ្នកប្រមូលបញ្ជី\"},consistent_creator:{criteria:\"រូបថតភោជនីយដ្ឋាន 5\",description:\"ផ្ទុករូបថតសម្រាប់ភោជនីយដ្ឋាន 5 ហាង ដើម្បីបង្ហាញពីភាពមានស្ដង់ដាររបស់អ្នក។\",title:\"អ្នកបង្ហោះជាប្រចាំ\"},current_progress:{login_prompt:\"អ្នកត្រូវតែចូលគណនីដើម្បីមើលវឌ្ឍនភាពរបស់អ្នក\",title:\"វឌ្ឍនភាពរបស់អ្នកចំពោះសមិទ្ធផលនេះ\"},director:{title:\"អ្នកចូលចិត្តថតរូប\"},empty_description:\"សូមត្រឡប់មកមើលម្តងទៀតពេលក្រោយ!\",empty_title:\"មិនមានសមិទ្ធផលណាមួយបានបើក\",explorer:{criteria:\"៥ កន្លែងផ្សេងគ្នា\",description:\"ចូលទៅកាន់ភោជនីយដ្ឋាន ៥ កន្លែង និងចាប់ផ្ដើមស្វែងរក។\",title:\"អ្នកស្វែងរក\"},foodie:{criteria:\"ការកក់ 25 ដង\",description:\"បំពេញការកក់ 25 ដង ហើយបង្ហាញពីការតាំងចិត្តរបស់អ្នកក្នុងការបរិភោគអាហារ។\",title:\"អ្នកបរិភោគដែលមានការតាំងចិត្ត\"},gourmet_sensei:{criteria:\"ការកក់ ៥០ ដង\",description:\"បំពេញការកក់ ៥០ ដង ហើយក្លាយជាគំរូផ្នែកម្ហូបអាហារ។\",title:\"អ្នកចូលចិត្តម្ហូបអាហារ\"},influencer:{criteria:\"ការរក្សាទុកសរុប ៥០ ដង\",description:\"ទទួលបានការរក្សាទុកចំនួនសរុប ៥០ ដងនៅក្នុងបញ្ជីទាំងអស់របស់អ្នក ហើយក្លាយជាអ្នករៀបចំដែលទទួលបានការជឿទុកចិត្ត។\",title:\"អ្នកមានឥទ្ធិពលលើបញ្ជី\"},legend:{criteria:\"៥០ កន្លែងផ្សេងៗ\",description:\"ចូលទៅកាន់ភោជនីយដ្ឋាន ៥០ កន្លែងផ្សេងៗ ហើយក្លាយជាអ្នកល្បីប្រចាំតំបន់។\",title:\"អ្នកល្បីប្រចាំតំបន់\"},list_maker:{criteria:\"បញ្ជីសាធារណៈលើកដំបូង\",description:\"បង្កើតបញ្ជីសាធារណៈលើកដំបូងរបស់អ្នក ហើយចាប់ផ្តើមរៀបចំបទពិសោធន៍បរិភោគអាហារ។\",title:\"អ្នកចាប់ផ្តើមបញ្ជី\"},master_curator:{criteria:\"រក្សាទុកចំនួនសរុប ៥០០ ដង\",description:\"ឈានទៅរកការរក្សាទុកចំនួនសរុប ៥០០ ដងនៅលើបញ្ជីរបស់អ្នកទាំងអស់ ហើយក្លាយជាអ្នកជំនាញក្នុងការជ្រើសរើសព័ត៌មាន។\",title:\"អ្នកជ្រើសរើសដ៏ជំនាញ\"},photo_archiver:{criteria:\"រូបថតកន្លែង 40\",description:\"ផ្ទុករូបភាព​នៃ​កន្លែង 40 និង​បង្កើត​ប្រវត្តិ​អាហារដោយរូបភាព។\",title:\"អ្នករក្សាទុករូបថត\"},photo_enthusiast:{criteria:\"រូបថតភោជនីយដ្ឋាន ១០\",description:\"ផ្ទុករូបថតឡើងសម្រាប់ភោជនីយដ្ឋាន ១០ ហើយជួយអ្នកដទៃស្វែងរកបទពិសោធន៍បរិភោគអាហាររបស់អ្នក។\",title:\"អ្នកចូលចិត្តថតរូប\"},photographer:{criteria:\"រូបថតកន្លែងចំនួន ២៥\",description:\"បញ្ចូលរូបថតរបស់ភោជនីយដ្ឋានចំនួន ២៥\",title:\"អ្នកថតរូប\"},regular_diner:{criteria:\"ការកក់ 5 ដង\",description:\"បំពេញការកក់ 5 ដង ហើយបង្កើតទម្លាប់បរិភោគអាហាររបស់អ្នក។\",title:\"អតិថិជនទៀងទាត់\"},snap_shooter:{criteria:\"រូបថតដំបូង\",description:\"ផ្ទុករូបថតដំបូងរបស់អ្នក និងជួយអតិថិជនផ្សេងទៀតរកម្ហូបឆ្ងាញ់។\",title:\"អ្នកថតរូបដំបូង​\"},taste_curator:{criteria:\"ការមើលបញ្ជី ២៥០ ដង\",description:\"ទទួលបានការមើលបញ្ជីរបស់អ្នក ២៥០ ដង ហើយជួយសហគមន៍រកឃើញកន្លែងល្អៗ។\",title:\"អ្នកជួយសហគមន៍\"},title:\"ការសម្រេចបាន\",trend_setter:{criteria:\"ការរក្សាទុកសរុប ២០០ ដង\",description:\"សម្រេចបានការរក្សាទុកសរុប ២០០ ដង នៅក្នុងបញ្ជីទាំងអស់របស់អ្នក ហើយក្លាយជាអ្នករៀបចំបញ្ជីដែលពេញនិយម។\",title:\"អ្នករៀបចំបញ្ជីដែលពេញនិយម\"},unlocked_at:\"បានបើក {{date}}\",viral_selection:{criteria:\"មើលបញ្ជីបាន ៥០០ ដង\",description:\"ទទួលបានការមើល ៥០០ ដងលើបញ្ជីរបស់អ្នក\",title:\"បញ្ជីពេញនិយម\"}},actions_btns:{share:\"ចែករំលែក\"},activity:{empty_description:\"សូមត្រឡប់មកមើលម្តងទៀតពេលក្រោយ!\",empty_title:\"មិនមានសកម្មភាពនៅឡើយទេ\"},bookings:\"ការកក់\",contributions:\"ការចូលរួមចំណែក\",edit_profile:\"កែប្រែប្រវត្តិរូប\",experience_info:\"ទទួលបាន XP ដោយធ្វើការកក់ បំពេញការប្រកួតប្រជែង ចែករំលែករូបថត និងច្រើនទៀត\",fetch_error:\"កំហុសក្នុងការទាញយកប្រវត្តិរូបរបស់អ្នក, <button>ធ្វើបច្ចុប្បន្នភាព</button>\",image:{uploaded_at:\"បានបង្ហោះនៅ {{date}} ដោយ {{username}}\"},joined_at:\"ចូលរួម {{date}}\",level:\"លំដាប់ {{level}}\",lists:{no_lists_description:\"អ្នកប្រើនេះមិនមានបញ្ជីសាធារណៈណាមួយនៅពេលនេះទេ\",no_lists_description_owner:\"អ្នកមិនមា