ách\",explore_venues:\"Khám phá địa điểm\",favorites:\"Yêu thích\",img_alt:{empty_followed_lists:\"Nhiều bàn tay cùng chia sẻ một đĩa thức ăn\",hand_with_food:\"Tay cầm đồ ăn\"},info_msg:\"Danh sách giúp bạn theo dõi địa điểm và dễ dàng tìm chỗ trống\",info_msg_followed_lists:\"Bất kỳ danh sách nào từ cộng đồng bạn lưu sẽ xuất hiện ở đây\",list_name:\"Tên danh sách\",list_view:{make_profile_public_prompt:\"Danh sách của bạn đang được nhiều người quan tâm! Hãy chuyển hồ sơ sang chế độ công khai để mở khóa các thành tích đóng góp.\",make_profile_public_prompt_title:\"🎉 Đã có 50 lượt xem và còn tiếp tục!\"},list_visibility:\"Hiển thị danh sách\",lists_page:{make_profile_public_prompt:\"Công khai hồ sơ của bạn để tăng cơ hội danh sách của bạn được giới thiệu trong các mục phổ biến của chúng tôi.\",make_profile_public_prompt_title:\"Tăng cơ hội của bạn\"},login_to_use:\"Đăng nhập để sử dụng danh sách\",login_to_view_list:\"Vui lòng đăng nhập trước để xem danh sách này.\",manage_list:\"Quản lý danh sách\",multiple_lists:\"{{first_list_name}} + {{other_selected_lists_count}}\",my_lists:\"Danh sách của tôi\",no_followed_lists:\"Bạn chưa lưu bất kỳ danh sách nào\",no_venue_saved_yet:\"Chưa có địa điểm nào được lưu.\",open_until:\"<bold>Mở cửa</bold> đến {{time}}\",ownership:{anonymous:\"Bởi <span>Ẩn danh</span>\",private:\"Danh sách riêng tư\",you:\"Bởi <a>bạn</a>\"},privacy_private_info:\"Danh sách của bạn sẽ chỉ có bạn nhìn thấy.\",privacy_public_info:\"Danh sách của bạn sẽ hiển thị cho mọi người.\",privacy_toggle:{description:\"Khi danh sách của bạn ở chế độ riêng tư, chỉ bạn mới có thể xem và truy cập. Chỉ danh sách công khai mới có thể được chia sẻ với người khác.\",title:\"Đặt danh sách thành riêng tư\"},private_list_warning:\"Danh sách này đã được chủ sở hữu của nó chuyển sang chế độ riêng tư\",remove:\"Xóa\",save_list_info_msg:\"Chạm vào biểu tượng lưu trên bất kỳ địa điểm nào, sau đó chọn tên danh sách này để bắt đầu thêm vào đó.\",save_to_list:\"Lưu vào danh sách\",saved_lists:\"Danh sách đã lưu\",share_list:\"Chia sẻ danh sách\",share_list_info:\"Chỉ những danh sách được đặt là Công khai mới có thể được chia sẻ từ liên kết. Kiểm tra và điều chỉnh cài đặt hiển thị của bạn bên dưới.\",switch_to_public_profile:\"Chuyển sang hồ sơ công khai\",title:\"Danh sách\",unavailable:\"Danh sách này không có sẵn\",unavailable_info:\"Chủ sở hữu đã đặt danh sách ở chế độ riêng tư hoặc đã xóa danh sách.\",unfollow:\"Bỏ theo dõi\",update_list:\"Cập nhật danh sách\",venue_number:\"{{count}} địa điểm\",venue_number_plural:\"{{count}} địa điểm\",view_all_venues:\"Xem tất cả {{count}} địa điểm\"},rQe={description:\"Khám phá và đặt chỗ tại những địa điểm tốt nhất tại Nhật Bản. Dù bạn đang tìm kiếm để ăn nhanh hay ẩm thực đẳng cấp, TableCheck sẽ đáp ứng mọi nhu cầu của bạn. Tìm địa điểm và đặt bàn bất cứ nơi nào bạn đến.\",explore_title:\"Tìm kiếm trên bản đồ - {{universe}}\",keywords:{local_recommendation:\"Đề xuất địa phương\"},list_title:\"{{list}} | Danh sách chọn lọc trên TableCheck\",profile_description:\"{{bio_suffix}} | Cộng đồng TableCheck\",profile_title:\"{{name}} - TableCheck\",shop_description:\"Khám phá và đặt chỗ tại những nhà hàng ưu tú nhất ở Nhật Bản với TableCheck. Dễ dàng đặt bàn tại {{shop_name}} để có trải nghiệm đáng nhớ.\",shop_title:\"{{title}} - Hướng dẫn nhà hàng - TableCheck\",title:\"TableCheck - Đặt chỗ tại những nhà hàng tốt nhất tại Nhật Bản\"},sQe={account:\"Tài khoản\",bookings:\"Đặt chỗ\",explore:\"Khám phá\",home:\"Trang chủ\",lists:\"Danh sách\",requests:\"Yêu cầu\",vouchers:\"Voucher\"},lQe={subtitle:\"Hãy cùng tìm cho bạn món gì đó ngon miệng nhé!\",title:\"Trang này không có trong thực đơn\"},cQe={aichi:\"Tỉnh Aichi\",fukuoka:\"Tỉnh Fukuoka\",hiroshima:\"Tỉnh Hiroshima\",hokkaido:\"Tỉnh Hokkaido\",kanagawa:\"Tỉnh Kanagawa\",kyoto:\"Phủ Kyoto\",miyagi:\"Tỉnh Miyagi\",niigata:\"Tỉnh Niigata\",okinawa:\"Tỉnh Okinawa\",osaka:\"Tỉnh Osaka\",tokyo:\"Tokyo\"},uQe={meta_description:\"Chính sách bảo mật TableCheck\",p