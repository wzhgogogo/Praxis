ल दर्ज किए गए ईमेल से मेल नहीं खाता\",email_invalid:\"अमान्य ईमेल\",email_required:\"मान्य ईमेल आवश्यक है\",first_name_required:\"पहला नाम आवश्यक है\",full_name_required:\"कृपया पूरा नाम भरें\",invalid_login:\"अमान्य ईमेल या पासवर्ड\",last_name_required:\"अंतिम नाम आवश्यक है\",min_length:\"कम से कम 12 वर्ण\",one_lower_case:\"कम से कम 1 लोअर केस अक्षर\",one_number:\"कम से कम 1 नंबर\",one_symbol:\"कम से कम 1 प्रतीक\",one_upper_case:\"कम से कम 1 अपरकेस अक्षर\",password_contains_email_substring:\"ईमेल का हिस्सा नहीं होना चाहिए\",phone_number_required:\"मान्य फ़ोन नंबर आवश्यक है\"},first_name:\"पहला नाम\",forgot_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",gender:\"लिंग\",last_name:\"उपनाम\",login:\"लॉगिन\",login_feat_unlock:\"अपने मुफ़्त खाते में <bold>साइन अप</bold> या <bold>लॉग इन</bold> करें और हमारी सभी सुविधाएँ अनलॉक करें।\",logout:\"लॉगआउट\",no_account:\"खाता नहीं है?\",password:\"xxxxxxxxxxxxxxxxxxxxx\",phone_number:\"फ़ोन नंबर\",reset_instruction:\"अपना ईमेल पता दर्ज करें और हम आपको आपका पासवर्ड रीसेट करने का लिंक भेजेंगे\",reset_instruction_sent:\"अगर <bold>{{email}}</bold> के लिए एक खाता मौजूद है, तो आपको कुछ मिनटों में आपके पासवर्ड रीसेट करने के निर्देश वाला ईमेल मिलेगा।\",reset_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",sign_up:\"साइन अप\",sign_up_email:\"ईमेल से साइन अप करें\",terms_and_policy:\"आगे बढ़कर और खाता बनाकर, आप <bold>संबंधित नियमों और नीतियों</bold> से सहमत होते हैं।\"},yOe={all_day:\"पूरे दिन\",any_party_size:\"मेहमानों की कोई भी संख्या\",book_from:\"{{date}} से बुक करें\",book_from_day:\"इस {{day}} से बुक करें\",book_from_today:\"आज से बुक करें\",book_from_tomorrow:\"कल से बुक करें\",explore_venues:\"आस-पास के सभी स्थान खोजें\",find_avail:\"उपलब्धता खोजें\",find_venues:\"उपलब्ध स्थान ढूंढें\",more_avail:\"अधिक उपलब्धता खोजें\",no_avail_message:\"हमें <underline>{{date}}</underline> को चुने गए भोजन समय के लिए कोई टेबल नहीं मिली, कृपया किसी अन्य समय या दिन के साथ पुनः प्रयास करें\",no_avail_message_pickup:\"चयनित पिकअप समय के लिए <underline>{{date}}</underline> को कोई उपलब्धता नहीं मिली, कृपया किसी अन्य समय या दिन पर पुनः प्रयास करें\",no_time_slots:\"चुनी गई अवधि में कोई टेबल उपलब्ध नहीं\",non_tc_disclaimer:\"हालांकि, हम उपलब्धता दिखाने या उसकी गारंटी देने में असमर्थ हैं, इसलिए हम नीचे दिए गए विकल्पों में से किसी एक से बुकिंग करने की पुरज़ोर सलाह देते हैं।\",pickup_from:\"{{date}} से पिकअप निर्धारित करें\",pickup_from_day:\"{{day}} से पिकअप निर्धारित करें\",pickup_from_today:\"आज से पिकअप निर्धारित करें\",pickup_from_tomorrow:\"कल से पिकअप निर्धारित करें\",reset_to_default:\"डिफ़ॉल्ट पर रीसेट करें\",retry_banner:\"कुछ गलत हो गया। कृपया फिर से बुकिंग करने का प्रयास करें।\",shop_disabled_busy:\"{{shop}} पर इस समय बहुत अधिक ट्रैफ़िक है और उसने अस्थायी रूप से नए आरक्षण स्वीकार करना रोक दिया है। कृपया कुछ मिनट प्रतीक्षा करें, फिर पुनः प्रयास करें।\",shop_disabled_stopped:\"{{shop}} वर्तमान में ऑनलाइन आरक्षण स्वीकार नहीं कर रहा है।\",time_slot_unavailable_message:\"आपका चुना हुआ समय उपलब्ध नहीं है। यहाँ कुछ वैकल्पिक समय स्लॉट दिए गए हैं।\",walk_in:\"यह रेस्तरां वॉक-इन मेहमानों को स्वीकार कर सकता है\",when_dine:\"आप कब भोजन करना चाहेंगे?\"},vOe={description:\"भोजन संबंधी जानकारी, रेस्तरां संबंधी सुझाव और भोजन संस्कृति की कहानियाँ जानें\",page_description:\"TableCheck से नवीनतम लेख और अपडेट पढ़ें\",page_title:\"ब्लॉग | TableCheck\",post_not_found:\"ब्लॉग पोस्ट नहीं मिला\",title:\"TableCheck डाइनर ब्लॉग\"},TOe={bishoku:{cta_text:\"अब खोजें\",description:\"20 जनवरी (सोम) - 19 मार्च (बुध) तक क्योटो के बेहतरीन रेस्तरां का आनंद लें\",title:\"क्योटो बिशोकु मेगुरी 2025\"},fastpass:{cta_text:\"अभी बुक करें\",description:\"स्थानीय पसंदीदा से लेकर ट्रेंडिंग रेस्तरां तक। बिना इंतज़ार किए आनंद लें\",title:\"FastPass\"},ginza_week:{cta_text:\"अभी बुक करें\",description:\"प्रसिद्ध शेफ द्वारा तैयार किए गए व्यंजनों के साथ गिन्ज़ा में बेहतरीन भोजन का अनुभव लें।\",title:\"डाइनर्स क्लब गिनजा रेस्टोरेंट सप्ताह 2025 वसंत\"},hsbc:{cta_text:\"अभी बुक करें\",description:\"टोक्यो के चुनिंदा रेस्तरां में विशेष मेनू पर 10% छूट का आनंद लें।\",terms:\"नियम और शर्तें लागू होती हैं।\\nउधार लेना है या नहीं? केवल तभी उधार लें जब आप वापस कर सकें!\",title:\"HSBC Visa Signature Card का विशेष प्रस्ताव\"},tc_app:{description:\"आसानी से चलते-फिरते बुक करने के लिए हमारे निःशुल्क ऐप का उपयोग करें! \\n नीचे दिए गए QR कोड को स्कैन करें।\",title:\"TableCheck ऐप डाउनलोड करें\"},tc_pay:{cta_text:\"स्थान ब्राउज़ करें\",description:\"भोजन करने के बाद अपने पंजीकृत कार्ड से तुरंत चेकआउट करें।\\nयादें बनाएँ, परेशानी नहीं।\",title:\"TableCheck Pay\"},visa:{cta_text:\"अभी बुक करें\",description:\"टोक्यो, क्योटो और ओसाका में भाग लेने वाले रेस्तरां में चुनिंदा मेनू पर 10% की छूट पाएं।\",title:\"जापान में Visa के साथ भोजन करें\"},xmas:{cta_text:\"अभी बुक करें\",description:\"क्रिसमस के लिए रेस्तरां का एक विशेष चयन खोजें!\",title:\"क्रिसमस अभियान\"}},COe={content_not_available:\"सामग्री नीति उपलब्ध नहीं है।\",meta_description:\"TableCheck सामग्री नीति\",page_title:\"सामग्री नीति | TableCheck\"},xOe={android_description:\"हम खुश हैं कि हमारा नया Android ऐप आने वाला है और यह मुफ्त में उपलब्ध होगा! तब तक, कृपया हमारी वेबसाइट tablecheck.com का उपयोग करें।\",android_title:\"जल्द ही अपडेट आ रहा है\",continue_tc:\"tablecheck.com पर जारी रखें\",ios_description:\"मुफ़्त में हमारे नवीनतम ऐप संस्करण में अपडेट करें और नई सुविधाएँ अनलॉक करें। यदि आप बाद में अपडेट करना चाहते हैं, तो आप tablecheck.com पर भी जारी रख सकते हैं।\",ios_title:\"ऐप अपडेट उपलब्ध है\",update_app:\"ऐप अपडेट करें\"},zOe={african:\"अफ्रीकी\",agemono:\"अगेमोनो (जापानी फ्राइड)\",all_day_breakfast:\"दिन भर नाश्ता\",american:\"अमेरिकी\",anago:\"अनागो (कॉन्गर ईल)\",asian:\"एशियाई\",asian_noodles:\"एशियाई नूडल्स\",australian:\"ऑस्ट्रेलियाई\",bagels:\"बेगल्स\",bakery:\"बेकरी और पेस्ट्रीज़\",bar:\"बार\",bbq:\"बार्बीक्यू\",beer:\"बीयर\",beer_garden:\"बीयर गार्डन\",beer_hall:\"बीयर हॉल\",beijing:\"मंदारिन और बीजिंग चीनी\",belgian:\"बेल्जियन\",bistro:\"बिस्त्रो\",boat_cruise:\"नाव क्रूज\",brazilian:\"ब्राजीलियाई\",breakfast:\"नाश्ता\",british:\"ब्रिटिश\",brunch:\"ब्रं