change_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",communications:{subscriptions:{body_text:\"คุณกำลังได้รับอีเมลอัปเดตจากร้านอาหารต่อไปนี้\",empty_description:\"ติดตามร้านอาหารเพื่อรับข้อมูลอัปเดตล่าสุด\",none:\"คุณไม่มีการสมัครรับข้อมูล\",remove_msg:\"คุณแน่ใจหรือไม่ว่าต้องการเลิกติดตาม {{shop_name}}?\",title:\"การสมัครรับข้อมูล\",unsubscribe:\"เลิกติดตาม\",your_subscriptions:\"การสมัครรับข้อมูลของคุณ\"},title:\"ร้านอาหารที่ติดตาม\"},confirm_email_change_msg:\"หากต้องการเปลี่ยนอีเมลของคุณเป็น <bold> {{newEmail}} </bold> โปรดใช้ลิงก์ยืนยันที่ส่งไปที่ <bold> {{currentEmail}} </bold>\",confirm_email_msg:\"เราได้ส่งอีเมลไปที่ <bold>{{email}}</bold> แล้ว โปรดยืนยันเพื่อรักษาความปลอดภัยให้กับบัญชีของคุณ\\nหากอีเมลไม่ถูกต้อง คุณจะไม่ได้รับข้อมูลอัปเดตการจอง โปรดสร้างบัญชีใหม่เพื่อแก้ไข\",create_password:{message:\"ตั้งรหัสผ่านใหม่เพื่อเข้าสู่ระบบด้วยอีเมลและใช้งานแอปของเรา\",title:\"สร้างรหัสผ่าน\"},credit_cards:{details:\"{{brand}} **** {{last_four_digits}}\",empty_description:\"การ์ดที่บันทึกไว้จะปรากฏที่นี่\",expires:\"หมดอายุ\",none:\"ยังไม่มีบัตรเครดิตที่บันทึกไว้\",primary:\"หลัก\",remove:\"ลบบัตร\",remove_msg:\"คุณแน่ใจว่าคุณต้องการจะลบบัตรเครดิตนี้?\"},credits:{balance:\"ยอดคงเหลือของคุณ:\",credit_amount:\"0 เครดิต\",more_info:\"เครดิตคืออะไร\",title:\"เครดิต TableCheck\"},current_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",delete_account:\"ลบบัญชี\",delete_msg_warning:\"หากคุณดำเนินการต่อ ข้อมูลบัญชีของคุณ ข้อมูลการจองที่เกี่ยวข้อง และคะแนน TC ทั้งหมดจะถูกลบออกอย่างถาวร การกระทำนี้ไม่สามารถย้อนกลับได้\",delete_tc_account:\"ลบบัญชี TableCheck\",delete_tc_account_title:\"การลบบัญชี\",disconnect_account:\"ยกเลิกการเชื่อมต่อบัญชี\",disconnect_social_msg:\"คุณแน่ใจหรือว่าต้องการตัดการเชื่อมต่อบัญชีนี้?\",discover_and_book:\"ค้นพบ จอง และบันทึกร้านอาหารที่ดีที่สุดด้วยบัญชี TableCheck ฟรี\",empty_transaction_description:\"ธุรกรรมใด ๆ ที่คุณมีจะปรากฏที่นี่\",enter_current_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",enter_name:\"ป้อนชื่อของคุณ\",enter_new_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",errors:{password_incorrect:\"รหัสผ่านปัจจุบันไม่ถูกต้อง\",password_used:\"เลือกรหัสผ่านใหม่ เนื่องจากเคยใช้รหัสผ่านนี้ก่อนหน้านี้\"},for_restaurateurs:\"สำหรับเจ้าของร้านอาหาร\",generate_receipt:\"สร้างใบเสร็จ\",help:\"ช่วยเหลือ\",membership:{joined:\"เข้าร่วม\",locations_used:\"สถานที่ที่ใช้\",name_and_number:\"{{membership_name}} ({{membership_number}})\",no_memberships_msg:\"คุณยังไม่ได้เชื่อมต่อโปรแกรมสมาชิกใด ๆ<br/>คุณสามารถเชื่อมต่อโปรแกรมสมาชิกได้เมื่อทำการจอง\",number:\"หมายเลขสมาชิก\",program:\"โปรแกรม\",remove:\"ลบโปรแกรมสมาชิก\",remove_msg:\"คุณแน่ใจหรือไม่ว่าต้องการลบโปรแกรมสมาชิกนี้ออกจากบัญชีของคุณ?\",title:\"โปรแกรมสมาชิก\"},meta:{description:\"ดูประวัติการจองของคุณ: ข้อมูลการจองทั้งหมดของคุณ ตั้งแต่การจองที่ผ่านมาจนถึงการจองที่จะเกิดขึ้น สามารถจัดการได้ในรายการเดียวที่สะดวก\",title:\"TableCheck - การจองของฉัน\"},new_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",no_transactions:\"ไม่มีการทำธุรกรรม\",notifications:{marketing_info:\"รับข่าวสารและอัปเดตล่าสุดจากทีมงาน TableCheck ก่อนใคร\",notify_sms:\"แจ้งเตือนการจองผ่าน SMS\",sms_info:\"รับการแจ้งเตือนจากร้านอาหารผ่าน SMS คุณจะยังได้รับการแจ้งเตือนผ่านทางอีเมล\",subscribe_tc_marketing:\"สมัครรับจดหมายข่าว TableCheck\",title:\"จัดการการแจ้งเตือน\"},payment_method:{bank_transfer:\"โอนเงินผ่านธนาคาร\"},payment_status:{deposit:\"มัดจำ\",paid:\"ชำระแล้ว\",refunded:\"คืนเงินแล้ว\"},payment_type:{auth_hold:\"การกันวงเงิน\",cancel_fee:\"ค่าธรรมเนียมการยกเลิก\",contactless_pay:\"TableCheck Pay\",prepay:\"การชำระล่วงหน้า\"},please_confirm_email:\"กรุณายืนยันอีเมลของคุณ\",please_confirm_email_change:\"กรุณายืนยันการเปลี่ยนแปลงอีเมล\",profile:\"โปรไฟล์\",providers:{facebook:\"Facebook\",google_oauth2:\"Google\",yahoojp:\"Yahoo! JAPAN\"},public_profile:{achievements:{adventurer:{criteria:\"20 ร้านที่ต่างกัน\",description:\"เยี่ยมชมร้านอาหาร 20 แห่งที่แตกต่างกันและเปิดประสบการณ์ใหม่ของคุณ\",title:\"นักผจญภัย\"},baby_diner:{criteria:\"การจองแรก\",description:\"ทำการจองครั้งแรกผ่าน TableCheck\",title:\"ยินดีต้อนรับนักชิม\"},categories:{content_creator:\"ผู้สร้างคอนเทนต์\",content_creator_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยอัปโหลดผลงานจากร้านที่คุณเคยไปใช้บริการผ่าน TableCheck\",default:\"ค่าเริ่มต้น\",explorer:\"นักสำรวจ\",explorer_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยทำการจองผ่าน TableCheck\",influencer:\"อินฟลูเอนเซอร์\",influencer_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยให้ผู้ใช้รายอื่นติดตามรายการของคุณ\",list_curator:\"ผู้คัดสรรรายการ\",list_curator_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยสร้างรายการของคุณ\",reservations:\"การจอง\",reservations_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยทำการจองผ่าน TableCheck\",trending:\"กำลังมาแรง\",trending_description:\"ปลดล็อกความสำเร็จเหล่านี้โดยให้ผู้ใช้อื่นดูรายการของคุณ\"},century_club:{criteria:\"จองครบ 100 ครั้ง\",description:\"ทำการจองให้ครบ 100 ครั้งและเข้าร่วมคลับนักชิมระดับแนวหน้า\",title:\"Century Club\"},collection_builder:{criteria:\"รายการสาธารณะ 10 รายการ\",description:\"สร้างรายการสาธารณะ 10 รายการที่ครอบคลุมธีมและประเภทอาหารที่หลากหลาย\",title:\"ผู้สร้างสรรค์คอลเลคชั่น\"},consistent_creator:{criteria:\"ผลงานจาก 5 ร้าน\",description:\"อัปโหลดรูปภาพสำหรับ 5 ร้านอาหารและแสดงความสม่ำเสมอของคุณ\",title:\"ครีเอเตอร์ที่สม่ำเสมอ\"},current_progress:{login_prompt:\"จำเป็นต้องเข้าสู่ระบบเพื่อดูความคืบหน้าของคุณ\",title:\"ความก้าวหน้าของคุณในการบรรลุเป้าหมายนี้\"},director:{title:\"ผู้ชื่นชอบการถ่ายภาพ\"},empty_description:\"โปรดกลับมาตรวจสอบอีกครั้งเร็วๆ นี้!\",empty_title:\"ยังไม่มีความสำเร็จที่ปลดล็อก\",explorer:{criteria:\"5 ร้านที่ต่างกัน\",description:\"เยี่ยมชมร้านอาหาร 5 ร้านและเริ่มต้นการสำรวจ\",title:\"นักสำรวจ\"},foodie:{criteria:\"การจอง 25 ครั้ง\",description:\"ทำการจองให้ครบ 25 ครั้งและแสดงความมุ่งมั่นในการทานอาหารของคุณ\",title:\"นักชิมชั้นยอด\"},gourmet_sensei:{criteria:\"การจอง 50 ครั้ง\",description:\"ทำการจองให้ครบ 50 ครั้งและกลายเป็นผู้แนะนำร้านอาหาร\",title:\"ผู้ชื่นชอบการทานอาหาร\"},influencer:{criteria:\"รายการได้รับการบันทึก 50 ครั้ง\",description:\"ได้รับยอดการบันทึกรวม 50 ครั้งจากรายการทั้งหมดของคุณ และเป็นผู้คัดสรรที่น่าเชื่อถือ\",title:\"อินฟลูเอนเซอร์ขึ้นชื่อ\"},legend:{criteria:\"50 ร้านที่ต่างกัน\",description:\"เยี่ยมชมร้านอาหาร 50 แห่งที่แตกต่างกันและกลายเป็นตำนานท้องถิ่น\",title:\"ตำนานท้องที่\"},list_maker:{criteria:\"รายการสาธารณะอันแรก\",description:\"สร้างรายการสาธารณะอันแรกของคุณและเริ่มต้นสร้างสรรค์แบ่งปันประสบการณ์การทานอาหารของคุณ\",title:\"ผู้เริ่มสร้างรายการ\"},master_curator:{criteria:\"รายการถูกบันทึกครบ 500 ครั้ง\",description:\"ได้รับยอดการบันทึกรวม 500 ครั้งจากรายการทั้งหมดของคุณ และเป็นสุดยอดผู้คัดสรร\",title:\"สุดยอดผู้คัดสรร\"},photo_archiver:{criteria:\"ผลงานจาก 40 ร้าน\",description:\"อัปโหลดผลงานจาก 40 ร้านและสร้างประวัติศาสตร์แห่งการรับประทานอาหาร\",title:\"นักสะสมรูปภาพ\"},photo_enthusiast:{criteria:\"ผลงานจาก 10 ร้าน\",description:\"อัปโหลดผลงานจาก 10 ร้าน และช่วยให้ผู้อื่นได้ค้นพบประสบการณ์การรับประทานอาหารของคุณ\",title:\"ผู้ชื่นชอบการถ่ายภาพ\"},photographer:{criteria:\"ผลงานจาก 25 ร้าน\",description:\"อัปโหลดรูปภาพของร้านอาหาร 25 แห่ง\",title:\"ช่างภาพมืออาชีพ\"},regular_diner:{criteria:\"การจอง 5 ครั้ง\",description:\"ทำการจองให้ครบ 5 ครั้งและเสริมสร้างรูทีนการทานอาหารของคุณ\",title:\"นักชิมขาประจำ\"},snap_shooter:{criteria:\"ผลงานแรก\",description:\"อัปโหลดผลงานแรกของคุณและช่วยให้ผู้ใช้อื่นได้ค้นพบอาหารชั้นเลิศ\",title:\"ช่างถ่ายภาพ\"},taste_curator:{criteria:\"ได้รับยอดการรับชม 250 ครั้ง\",description:\"ได้รับยอดการรับชม 250 ครั้งจากรายการของคุณ และช่วยให้ชุมชนได้ค้นพบร้านใหม่ๆ\",title:\"ผู้สนับสนุนชุมชน\"},title:\"ความสำเร็จ\",trend_setter:{criteria:\"รายการได้รับการบันทึก 200 ครั้ง\",description:\"ได้รับยอดการบันทึกรวม 200 ครั้งจากรายการทั้งหมดของคุณ และเป็นผู้คัดสรรยอดนิยม\",title:\"ผู้คัดสรรยอดนิยม\"},unlocked_at:\"ปลดล็อกเมื่อ {{date}}\",viral_selection:{criteria:\"ยอดการรับชม 500 ครั้ง\",description:\"ได้รับยอดการรับชม 500 ครั้งจากรายการของคุณ\",title:\"ตัวเลือกที่ได้รับความนิยม\"}},actions_btns:{share:\"แชร์\"},activity:{empty_description:\"โปรดกลับมาตรวจสอบอีกครั้งเร็วๆ นี้!\",empty_title:\"ยังไม่มีรายการกิจกรรม\"},bookings:\"การจองโต๊ะ\",contributions:\"การมีส่วนร่วม\",edit_profile:\"แก้ไขโปรไฟล์\",experience_info:\"รับ XP เมื่อทำการจอง ทำภารกิจ แชร์รูปภาพ และอื่นๆ\",fetch_error:\"เกิดข้อผิดพลาดในการดึงข้อมูลโปรไฟล์ของคุณ, <button>รีเฟรช</button>\",image:{uploaded_at:\"โพสต์เมื่อ {{date}} โดย {{username}}\"},joined_at:\"เข้าร่วมเมื่อ {{date}}\",level:\"ระดับ {{level}}\",lists:{no_lists_description:\"ผู้ใช้นี้ยังไม่มีรายการสาธารณะในขณะนี้\",no_lists_description_owner:\"ตอนนี้คุณยังไม่มีรายการใด\",no_lists_title:\"ไม่มีรายการที่เผยแพร่สาธารณะอยู่ในขณะนี้\"},modal:{badge_change_info:\"รับตราสัญลักษณ์โดยการทำภารกิจให้สำเร็จ\",change_badge:\"เปลี่ยนตราสัญลักษณ์\",change_banner:\"เปลี่ยนแบนเนอร์\",change_user_image:\"เปลี่ยนภาพโปรไฟล์\",error:{invalid_characters:\"มีตัวอักษรที่ไม่อนุญาตใน {{field}}\",pristine_state:'{{field}} ไม่สามารถตั้งเป็น \"user\" ได้',required:\"กรุณากรอก {{field}}\",too_long:\"{{field}} ยาวเกินไป ต้องไม่เกิน {{rule}} ตัวอักษร\",too_short:\"{{field}} สั้นเกินไป ต้องมีอย่างน้อย {{rule}} ตัวอักษร\"},handle_check_error:{invalid_format:\"รูปแบบชื่อผู้ใช้ไม่ถูกต้อง\",taken:\"ชื่อผู้ใช้นี้ถูกใช้ไปแล้ว\"},is_public:\"การตั้งค่าการแสดงโปรไฟล์\",private:\"โปรไฟล์ของคุณจะไม่ถูกแสดงต่อผู้ใช้รายอื่น และคุณจะถูกแสดงเป็นผู้ใช้ไม่ระบุชื่อในเนื้อหาที่แชร์\",public:\"โปรไฟล์ของคุณจะแสดงต่อผู้ใช้รายอื่น และโปรไฟล์ของคุณจะปรากฏในเนื้อหาที่แชร์\",public_bio:\"ประวัติส่วนตัว\",public_handle:\"ชื่อผู้ใช้\",public_link:\"ลิงก์\",public_name:\"ชื่อที่แสดง\",set_badge:\"ใช้ตราสัญลักษณ์\",set_user_upload:\"อัปโหลดรูปภาพ\",success:{handle:\"ชื่อนี้สามารถใช้งานได้\"},suggestions:\"คำแนะนำ\",title:\"แก้ไขโปรไฟล์ของฉัน\",toast:{update_error:\"เกิดข้อผิดพลาดในการอัปเดตโปรไฟล์สาธารณะ\",update_success:\"อัปเดตโปรไฟล์สาธารณะเรียบร้อยแล้ว\"}},onboarding_avatar:{explanatory_text:\"แบ่งปันรูปภาพของคุณ อวดรายการ และปลดล็อกความสำเร็จด้วยโปรไฟล์สาธารณะ\",popover_content:\"สร้างแรงบันดาลใจให้ชุมชนด้วยรสนิยมของคุณ! เปิดใช้งานโปรไฟล์ TableCheck เพื่อปลดล็อกฟีเจอร์พิเศษ เช่น แชร์รายการของคุณ อัปโหลดรูปภาพ และรับความสำเร็จ ข้อมูลส่วนตัวของคุณจะถูกเก็บไว้เป็นส่วนตัว\",title:\"โปรไฟล์สาธารณะ\"},photos:{community_policy:\"นโยบายชุมชน\",no_photos_description:\"ผู้ใช้นี้ยังไม่มีรูปภาพในขณะนี้\",no_photos_description_owner:\"คุณยังไม่มีรูปภาพในขณะนี้\",no_photos_title:\"ไม่มีรูปภาพ\",photos_count_0:\"{{count}} รูปภาพ\",rejected_photos:\"ผลงานที่ถูกปฏิเสธ\",status:{pending:\"รอดำเนินการ\",rejected:\"ผลงานของคุณสำหรับ <VenueName>{{name}}</VenueName> ถูกปฏิเสธเนื่องจากไม่สอดคล้องกับ<CommunityLink>นโยบายเนื้อหา</CommunityLink>ของเรา\"}},privacy_toggle:{description:\"เมื่อบัญชีของคุณถูกตั้งค่าเป็นส่วนตัว โปรไฟล์ของคุณและผลงานจะไม่สามารถถูกเข้าถึงได้ และจะไม่ระบุตัวตน\",title:\"ตั้งค่าบัญชีเป็นส่วนตัว\"},private_profile_cta:\"พากลับไปหน้าหลัก\",private_profile_description:\"โปรไฟล์ผู้ใช้นี้ไม่เปิดเผยต่อสาธารณะ\",private_profile_title:\"โปรไฟล์ส่วนตัว\",private_state_tooltip:\"โปรไฟล์ของคุณถูกตั้งค่าเป็นส่วนตัวในขณะนี้ แก้ไขโปรไฟล์ของคุณเพื่อสลับเป็นโปรไฟล์สาธารณะ\",public_profile_view:\"คุณกำลังดูโปรไฟล์สาธารณะของคุณ\",share:{copy_link:\"คัดลอกลิงก์\",on_fb:\"แชร์บน Facebook\",on_x:\"แชร์บน X\",public_account_on_tablecheck:\"{{publicAccount}} บน TableCheck\",via_email:\"แชร์ทางอีเมล\"},share_modal_title:\"แชร์โปรไฟล์\",tabs:{achievements:\"ความสำเร็จ\",activity:\"กิจกรรม\",contributions:\"การมีส่วนร่วม\",lists:\"รายการ\",photos:\"รูปภาพ\",reviews:\"รีวิว\"}},public_profiles:{photos:{title:\"รูปภาพ\"}},saved_cards:\"บัตรที่บันทึกไว้\",sex_female:\"หญิง\",sex_male:\"ชาย\",sex_unspecified:\"ไม่ระบุ\",share_feedback:\"แบ่งปันคำติชม\",social_accounts:\"บัญชีโซเชียล\",terms_conditions:{content_policy:\"นโยบายเนื้อหา\",diner_terms:\"ข้อกำหนดสำหรับผู้ใช้บริการ\",payment_policy:\"นโยบายการชำระ\",privacy_policy:\"นโยบายความเป็นส่วนตัว\",title:\"ข้อกำหนดและเงื่อนไข\",trust_center:\"ศูนย์ความน่าเชื่อถือ\"},title:\"บัญชี\",transactions:\"ประวัติการชำระเงิน\",view_payment:\"รายละเอียด\",vouchers:{actions:{back:\"กลับไปที่บัตรกำนัล\",back_to_voucher_details:\"กลับไปที่รายละเอียดบัตรกำนัล\",book_online:\"จองออนไลน์\",call_venue:\"โทรหาร้าน\",generate:\"สร้าง\",generate_qr_code:\"สร้างรหัส QR\",get_qr_code:\"รับรหัส QR\",get_qr_code_multiple:\"รับคิวอาร์โค้ดสำหรับบัตรกำนัลหลายใบ\",reserve:\"จอง\",select_venue:\"เลือกร้าน\"},default_venue:\"ร้าน\",details:{download_receipt:\"ดาวน์โหลดใบเสร็จ\",expired_status:\"บัตรกำนัลนี้หมดอายุแล้ว\",expired_voucher_message:\"บัตรกำนัลหมดอายุที่ {{venueName}}\",gifted_voucher_message:\"คุณได้มอบบัตรกำนัลนี้เป็นของขวัญ\",included_message:\"บัตรกำนัลที่รวมอยู่ในการจองนี้\",make_a_reservation:\"ทำการสำรองที่นั่ง\",multiple_venues:\"ร้านหลายแห่ง\",order_details:\"รายละเอียดการสั่งซื้อ\",price:\"ราคา: {{voucherPrice}}\",qr_code_redeem_message:\"แสดง QR Code นี้เพื่อแลกรับบัตรกำนัลของคุณ\",qr_gallery_counter:\"{{current}} / {{total}}\",qr_split_per_voucher:\"สร้างคิวอาร์โค้ดแยกต่างหากสำหรับรหัสบัตรกำนัลแต่ละใบ\",quantity_selector:\"จำนวนบัตรกำนัลที่ใช้: \",redeemable_at_message:\"แลกได้ที่ {{venueName}}\",redeemed_message:\"บัตรกำนัลที่แลกในการทำธุรกรรมนี้\",redeemed_status:\"ใช้บริการแล้วที่ {{venueName}}\",redemption_message:\"หมายเหตุ: ระบบจะแลกใช้บัตรกำนัลที่จะหมดอายุก่อน\",refunded_voucher_message:\"คืนเงินที่ {{venueName}}\",reservation_details:\"รายละเอียดการจอง\",reservation_id:\"รหัสการจอง: {{reservationId}}\",reserved_status:\"จองแล้วที่ {{venueName}}\",select_quantity:\"โปรดเลือกจำนวนบัตรกำนัลที่คุณต้องการใช้\",select_quantity_placeholder:\"เลือกจำนวน...\",select_quantity_qr:\"กรุณาเลือกจำนวนบัตรกำนัลที่คุณต้องการใช้\",select_venue_description:\"บัตรกำนัลนี้สามารถใช้ได้ที่ร้านหลายแห่ง กรุณาเลือกร้านเพื่อดำเนินการจอง\",select_venue_placeholder:\"เลือกร้าน...\",total_value:\"มูลค่ารวม: {{totalValue}}\",total_vouchers:\"ยอดรวมบัตรกำนัล: {{totalVouchers}}\",valid_vouchers_0:\"บัตรกำนัลที่ใช้ได้ {{validVouchers}} ใบ\",validity_message:\"ใช้ได้ถึง {{validityDate}}\",validity_range_message:\"ใช้ได้ตั้งแต่ {{startDate}} จนกระทั่ง {{endDate}}\",voucher_count:\"บัตรกำนัล {{voucherCount}} ใบ\",voucher_id:\"รหัสบัตรกำนัล: {{voucherIds}}\"},error:{voucher_not_found:\"ไม่พบบัตรกำนัล\"},status:{expired:\"หมดอายุแล้ว\",redeemed:\"แลกแล้ว\",refunded:\"คืนเงินแล้ว\",transferred:\"มอบเป็นของขวัญแล้ว\"},tabs:{inactive:\"ไม่ได้ใช้งาน\",no_inactive_vouchers:\"ไม่มีบัตรกำนัลที่ไม่ได้ใช้งาน\",no_redeemed_vouchers:\"ไม่มีบัตรกำนัลที่ถูกแลก\",no_reserved_vouchers:\"ไม่มีบัตรกำนัลที่จองไว้\",no_valid_vouchers:\"ไม่มีบัตรกำนัลที่ใช้ได้\",redeemable:\"สามารถแลกได้\",redeemed:\"แลกแล้ว\",refunded:\"คืนเงินแล้ว\",reserved:\"จองแล้ว\",valid:\"ใช้ได้\"},title:{expired_vouchers:\"บัตรกำนัลหมดอายุ\",expiry_message:\"หมายเหตุ: ระบบจะแลกใช้บัตรกำนัลที่จะหมดอายุก่อน\",franchise:\"แฟรนไชส์\",manage_vouchers:\"บัตรกำนัล\",redeem_voucher:\"แลกรับบัตรกำนัล\",redeemed_vouchers:\"บัตรกำนัลที่แลกแล้ว\",refunded_vouchers:\"บัตรกำนัลคืนเงิน\",reservations:\"การจอง\",voucher_details:\"รายละเอียดบัตรกำนัล\",voucher_id:\"รหัสบัตรกำนัล\"}}},iVe={home_banner:\"แบนเนอร์หน้าแรกของพอร์ทัลร้านอาหาร TableCheck\",landing_banner:\"แบนเนอร์หน้า Landing Page\"},oVe={birthday_celebration:\"วันเกิด & งานฉลอง\",business_suitable:\"เหมาะกับธุรกิจ\",casual:\"ไม่เป็นทางการ\",good_for_groups:\"เหมาะสำหรับกลุ่ม\",multiple_ambiences:\"{{ambience}} + {{other_selected_ambiences_count}}\",romantic:\"โรแมนติก\",title:\"บรรยากาศ\",traditional:\"แบบดั้งเดิม\"},rVe={akihabara:\"อากิฮาบาระ\",american_village:\"หมู่บ้านอเมริกัน\",asakusa:\"อาซากุสะ\",bugis:\"บูกิส\",chinatown:\"ไชนาทาวน์\",clarke_quay:\"คลาร์กคีย์\",daimyo:\"ไดเมียว\",dempsey:\"เดมป์ซีย์\",dotonbori:\"โดทงโบริ\",fukuoka:\"ฟุกุโอกะ\",fukushima:\"ฟุกุชิมะ\",fushimi:\"ฟุชิมิ\",ginza:\"กินซ่า\",hakata:\"ฮากาตะ\",harajuku:\"ฮาราจูกุ\",higashiyama:\"ฮิงาชิยามะ\",hiroshima:\"ฮิโรชิม่า\",hokkaido:\"ฮอกไกโด\",isezakicho:\"อิเซะซากิโจ\",jr_central_towers:\"ตึก JR Central\",kibune:\"คิบุเนะ\",kinshachi:\"คินชาจิ\",kiyamachi:\"คิยามาจิ\",kokusai_dori:\"โคคุซาอิโดริ\",kotoni:\"โคโตนิ\",kyoto:\"เกียวโต\",kyoto_station:\"สถานีเกียวโต\",makishi:\"มากิชิ\",marina_bay_sands:\"มาริน่า เบย์ แซนด์ส\",maruyama:\"มารุยามะ\",minatomirai:\"มินาโตะมิไร\",motomachi:\"โมโตมาชิ\",nagahama:\"นากาฮามะ\",nagoya:\"นาโกย่า\",naha:\"นะฮะ\",nakasu:\"นากาสุ\",nakazakicho:\"นากาซากิโจ\",niigata:\"นีงาตะ\",noge:\"โนเกะ\",odori:\"สวนโอโดริ\",okinawa:\"โอกินาวา\",omoromachi:\"โอโมโรมาจิ\",orchard:\"ออร์ชาร์ด\",osaka:\"โอซาก้า\",osaka_station:\"สถานีโอซาก้า\",osu:\"โอสุ\",pontocho:\"ปอนโตะโช\",raffles_place:\"ราฟเฟิลส์ เพลซ\",roppongi:\"รปปงหงิ\",sakae:\"ซาคาเอะ\",sapporo:\"ซัปโปโร\",sapporo_station:\"สถานีซัปโปโร\",sendai:\"เซนได\",shibuya:\"ชิบูย่า\",shinjuku:\"ชินจูกุ\",shinsaibashi:\"ชินไซบาชิ\",shuri:\"ปราสาทชูริ\",suntan:\"ซันทัน\",suntec:\"ซันเทค\",susukino:\"สึสึคิโนะ\",tanjong_pagar:\"ตันจง ปาการ์\",tanukikoji:\"ทานุกิโคจิ\",tenjin:\"เทนจิน\",tennoji:\"เท็นโนจิ\",tokyo:\"โตเกียว\",tsuboya:\"สึโบยะ\",ueno:\"อุเอโนะ\",yokohama:\"โยโกฮาม่า\"},sVe={back_to_login:\"กลับไปที่หน้าเข้าสู่ระบบ\",check_email:\"ตรวจสอบอีเมล\",check_inbox:\"ตรวจสอบกล่องจดหมายของคุณ\",check_inbox_msg:\"หากต้องการยืนยันที่อยู่อีเมลของคุณ ให้คลิกลิงก์ในอีเมลที่ส่งไปที่ <bold> {{email}} </bold>\",confirm_email:\"ยืนยันอีเมล\",continue_with_facebook:\"ดำเนินการต่อด้วย Facebook\",continue_with_google_oauth2:\"ดำเนินการต่อด้วย Google\",continue_with_yahoojp:\"ดำเนินการต่อด้วย Yahoo! JAPAN\",create_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",email:\"อีเมล\",error:{confirm_email_no_match:\"อีเมลยืนยันไม่ตรงกับอีเมลที่ป้อน\",email_invalid:\"อีเมลไม่ถูกต้อง\",email_required:\"ต้องมีอีเมลที่ถูกต้อง\",first_name_required:\"จำเป็นต้องมีชื่อ\",full_name_required:\"จำเป็นต้องมีชื่อและนามสกุล\",invalid_login:\"อีเมลหรือรหัสผ่านไม่ถูกต้อง\",last_name_required:\"จำเป็นต้องมีนามสกุล\",min_length:\"อย่างต่ำ 12 ตัวอักษร\",one_lower_case:\"ต้องมีตัวพิมพ์เล็กอย่างน้อย 1 ตัว\",one_number:\"ต้องมีตัวเลขอย่างน้อย 1 ตัว\",one_symbol:\"ต้องมีสัญลักษณ์อย่างน้อย 1 ตัว\",one_upper_case:\"ต้องมีตัวพิมพ์ใหญ่อย่างน้อย 1 ตัว\",password_contains_email_substring:\"ต้องไม่มีส่วนของอีเมล\",phone_number_required:\"ต้องใส่หมายเลขโทรศัพท์ที่ถูกต้อง\"},first_name:\"ชื่อ\",forgot_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",gender:\"เพศ\",last_name:\"นามสกุล\",login:\"เข้าสู่ระบบ\",login_feat_unlock:\"<bold>ลงทะเบียน</bold>หรือ<bold>เข้าสู่ระบบ</bold>บัญชีฟรีของคุณเพื่อปลดล็อกฟีเจอร์ทั้งหมดของเรา\",logout:\"ออกจากระบบ\",no_account:\"ยังไม่มีบัญชี?\",password:\"xxxxxxxxxxxxxxxxxxxxxxxx\",phone_number:\"หมายเลขโทรศัพท์\",reset_instruction:\"กรอกที่อยู่อีเมลของคุณ และเราจะส่งลิงก์ให้คุณรีเซ็ตรหัสผ่าน\",reset_instruction_sent:\"หากมีบัญชีสำหรับ <bold>{{email}}</bold> คุณจะได้รับอีเมลที่มีคำแนะนำในการรีเซ็ตรหัสผ่านของคุณภายในไม่กี่นาที\",reset_password:\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",sign_up:\"ลงทะเบียน\",sign_up_email:\"ลงทะเบียนด้วยอีเมล\",terms_and_policy:\"ด้วยการดำเนินการต่อและสร้างบัญชี คุณยินยอม <bold>ข้อกำหนดและนโยบายที่เกี่ยวข้อง</bold>\"},lVe={all_day:\"ทั้งวัน\",any_party_size:\"ขนาดคณะใดก็ได้\",book_from:\"จองได้ตั้งแต่ {{date}}\",book_from_day:\"จองได้ตั้งแต่ {{day}}\",book_from_today:\"จองได้ตั้งแต่วันนี้\",book_from_tomorrow:\"จองได้ตั้งแต่พรุ่งนี้\",explore_venues:\"ค้นพบร้านอาหารทั้งหมดใกล้เคียง\",find_avail:\"ค้นหาที่ว่าง\",find_venues:\"ค้นหาร้านอาหารที่ว่าง\",more_avail:\"ค้นหาที่ว่างเพิ่มเติม\",no_avail_message:\"เราไม่พบโต๊ะว่างในวัน <underline>{{date}}</underline> สำหรับช่วงเวลาอาหารที่เลือก โปรดลองเวลาหรือวันอื่น\",no_avail_message_pickup:\"เราไม่พบตัวเลือกว่างใน<underline>{{date}}</underline>สำหรับเวลาที่คุณเลือก กรุณาเลือกวันที่และเวลาใหม่อีกครั้ง\",no_time_slots:\"ไม่มีโต๊ะว่างในช่วงเวลาที่เลือก\",non_tc_disclaimer:\"อย่างไรก็ตาม เนื่องจากเราไม่สามารถแสดงหรือรับประกันที่ว่างได้ เราขอแนะนำให้จองจากหนึ่งในตัวเลือกที่แสดงด้านล่างนี้\",pickup_from:\"นัดรับอาหารได้ตั้งแต่ {{date}}\",pickup_from_day:\"นัดรับอาหารได้ตั้งแต่ {{day}}\",pickup_from_today:\"นัดรับอาหารได้ตั้งแต่วันนี้\",pickup_from_tomorrow:\"นัดรับอาหารได้ตั้งแต่พรุ่งนี้\",reset_to_default:\"รีเซ็ตเป็นค่าเริ่มต้น\",retry_banner:\"เกิดข้อผิดพลาด กรุณาลองจองอีกครั้ง\",shop_disabled_busy:\"{{shop}} กำลังประสบกับปริมาณการใช้ข้อมูลสูงและได้หยุดรับการจองใหม่ชั่วคราว โปรดรอสักครู่แล้วลองอีกครั้งในภายหลัง\",shop_disabled_stopped:\"{{shop}} ไม่รับการจองออนไลน์ในขณะนี้\",time_slot_unavailable_message:\"เวลาที่คุณเลือกไม่ว่าง กรุณาเลือกช่วงเวลาอื่นแทน\",walk_in:\"ร้านนี้อาจรับลูกค้าที่ไม่ได้จองล่วงหน้า\",when_dine:\"คุณต้องการรับประทานอาหารเมื่อไหร่?\"},cVe={description:\"ค้นพบข้อมูลเชิงลึกเกี่ยวกับการรับประทานอาหาร คำแนะนำร้านอาหาร และเรื่องราวเกี่ยวกับวัฒนธรรมอาหาร\",page_description:\"อ่านบทความและอัปเดตล่าสุดจาก TableCheck\",page_title:\"บล็อก | TableCheck\",post_not_found:\"ไม่พบโพสต์บล็อก\",title:\"บล็อกร้านอาหาร TableCheck\"},uVe={bishoku:{cta_text:\"สำรวจตอนนี้\",description:\"ลิ้มรสอาหารรสเลิศจากร้านอาหารในเกียวโต 20 ม.ค. (จันทร์) – 19 มี.ค. (พุธ)\",title:\"เกียวโต บิโชกุ เมกุริ 2025\"},fastpass:{cta_text:\"จองเลย\",description:\"จากร้านอาหารท้องถิ่นยอดนิยมสู่ร้านอาหารที่กำลังมาแรง เพลิดเพลินโดยไม่ต้องรอนาน\",title:\"FastPass\"},ginza_week:{cta_text:\"จองเลยตอนนี้\",description:\"สัมผัสประสบการณ์การรับประทานอาหารชั้นเลิศในกินซ่าพร้อมคอร์สอาหารที่รังสรรค์จากเชฟชื่อดัง\",title:\"สัปดาห์อาหารในร้าน Diners Club Ginza ปี 2025 ฤดูใบไม้ผลิ\"},hsbc:{cta_text:\"จองทันที\",description:\"รับส่วนลด 10% สำหรับเมนูพิเศษที่ร้านอาหารที่ร่วมรายการในโตเกียว\",terms:\"มีข้อกำหนดและเงื่อนไข\\nจะกู้หรือไม่กู้? กู้เฉพาะเมื่อคุณสามารถชำระคืนได้!\",title:\"ข้อเสนอพิเศษสำหรับการ์ด HSBC Visa Signature\"},tc_app:{description:\"ใช้แอปฟรีของเราเพื่อจองได้อย่างง่ายดายทุกที่ทุกเวลา! \\n สแกนรหัส QR ด้านล่าง\",title:\"ดาวน์โหลดแอป TableCheck\"},tc_pay:{cta_text:\"ค้นหาร้าน\",description:\"ชำระเงินอย่างรวดเร็วด้วยบัตรที่ลงทะเบียนแล้วหลังจากทานอาหาร\\nสร้างความทรงจำ ไม่ใช่ความยุ่งยาก\",title:\"TableCheck Pay\"},visa:{cta_text:\"จองเลย\",description:\"รับส่วนลด 10% สำหรับเซ็ตเมนูที่ร้านอาหารที่ร่วมรายการในโตเกียว เกียวโต และโอซาก้า\",title:\"รับประทานอาหารกับ Visa ในญี่ปุ่น\"},xmas:{cta_text:\"จองเลย\",description:\"ค้นพบร้านอาหารที่คัดสรรมาเป็นพิเศษในช่วงคริสต์มาส!\",title:\"แคมเปญคริสต์มาส\"}},dVe={content_not_available:\"นโยบายเนื้อหาไม่สามารถใช้งานได้\",meta_description:\"นโยบายเนื้อหาของ TableCheck\",page_title:\"นโยบายเนื้อหา | TableCheck\"},hVe={android_description:\"เราตื่นเต้นที่จะได้แจ้งคุณว่าแอป Android ของเราใกล้จะเปิดตัวและสามารถใช้งานได้ฟรี! ในระหว่างนี้สามารถใช้งานผ่านเว็บไซต์ของเรา tablecheck.com\",android_title:\"จะมีการอัปเดตเร็ว ๆ นี้\",continue_tc:\"ดำเนินการต่อที่ tablecheck.com\",ios_description:\"อัปเดตแอปเป็นเวอร์ชันล่าสุดได้ฟรีและปลดล็อกฟีเจอร์ใหม่ ๆ เลย! คุณสามารถดำเนินการต่อได้ที่ tablecheck.com หากต้องการอัปเดตในภายหลัง\",ios_title:\"มีการอัปเดตใหม่สำหรับแอปพลิเคชัน\",update_app:\"อัปเดตแอป\"},mVe={african:\"แอฟริกัน\",agemono:\"อาเกะโมโนะ (ของทอดแบบญี่ปุ่น)\",all_day_breakfast:\"อาหารเช้าตลอดวัน\",american:\"อเมริกัน\",anago:\"อะนาโกะ (ปลาไหลทะเลญี่ปุ่น)\",asian:\"เอเชีย\",asian_noodles:\"บะหมี่เอเชีย\",australian:\"ออสเตรเลีย\",bagels:\"เบเกิล\",bakery:\"เบเกอรี่ & เพสตรี้\",bar:\"บาร์\",bbq:\"บาร์บีคิว\",beer:\"เบียร์\",beer_garden:\"สวนเบียร์\",beer_hall:\"ฮอลล์เบียร์\",beijing:\"จีนแมนดาริน & จีนปักกิ่ง\",belgian:\"เบลเยี่ยม\",bistro:\"บิสโทร\",boat_cruise:\"เรือสำราญ\",brazilian:\"บราซิล\",breakfast:\"อาหารเช้า\",british:\"อังกฤษ\",brunch:\"บรันช์\",buffet:\"บุฟเฟ่ต์\",burgers:\"เบอร์เกอร์\",cafe:\"คาเฟ่ & ร้านกาแฟ\",cafe_and_brunch:\"คาเฟ่และบรันช์\",cafe_desserts:\"คาเฟ่ & ของหวาน\",cajun_caribbean:\"เคจัน, ครีโอล & คาริบเบียน\",californian:\"แคลิฟอร์เนีย & อเมริกาสมัยใหม่\",cantonese:\"จีนกวางตุ้ง\",champon:\"จัมปง (บะหมี่น้ำนางาซากิ)\",chicken_wings:\"ปีกไก่สุดฮอต\",chinese:\"จีน\",chinese_hotpot:\"หม้อไฟสไตล์จีน\",coffee_brunch:\"กาแฟ & บรันช์\",cold_noodles:\"บะหมี่เย็น\",craft_beer:\"คราฟต์เบียร์\",creative:\"สร้างสรรค์\",crepes:\"เครป\",curry:\"แกงกะหรี่\",deli:\"เดลิ\",dessert:\"ของหวาน\",desserts:\"ของหวาน\",dimsum:\"ติ่มซำ\",dining_bar:\"ห้องอาหารกึ่งบาร์ & แกสโตร บาร์\",donuts:\"โดนัท\",entertainment:\"ความบันเทิง\",european:\"ยุโรป\",european_curry:\"แกงยุโรป\",french:\"ฝรั่งเศส\",fugu:\"ฟุกุ (ปลาปักเป้า)\",fusion_international:\"ฟิวชั่นและอินเตอร์เนชั่นแนล\",german:\"เยอรมัน & ออสเตรีย\",greek:\"กรีก\",gyoza:\"เกี๊ยวซ่า (เกี๊ยวทอด)\",halal:\"รับรองมาตรฐานอาหารฮาลาล\",hawaiian:\"ฮาวาย & หมู่เกาะแปซิฟิก\",healthy:\"อาหารเพื่อสุขภาพ\",horumon:\"ฮอรุมุนยากิ (เครื่องในบาร์บีคิวย่าง)\",hotpot:\"หม้อไฟ\",ice_cream:\"ไอศกรีม\",indian:\"อินเดีย\",indian_curry:\"แกงอินเดีย\",indonesian:\"อินโดนีเซีย\",inn:\"โรงเตี๊ยม & ที่พักพร้อมอาหารเช้า\",international_fusion:\"ฟิวชั่น & สากล\",irish:\"ไอริช\",italian:\"อิตาเลียน\",izakaya:\"อิซากายะ (ร้านเหล้าแบบญี่ปุ่น)\",izakaya_dining:\"อิซากายะและร้านอาหาร\",izakaya_short:\"อิซากายะ\",japanese:\"ญี่ปุ่น\",japanese_curry:\"แกงกะหรี่ญี่ปุ่น\",japanese_noodles:\"โซบะ & อุด้ง\",japanese_sweets:\"ขนมหวานญี่ปุ่น\",kaiseki:\"ไคเซกิ\",kaiten_zushi:\"ซูชิจานหมุน\",kamameshi:\"คามาเมชิ (ข้าวอบญี่ปุ่น)\",kappo:\"คัปโปะ (ญี่ปุ่นดั้งเดิม)\",karaoke:\"คาราโอเกะ\",kissaten:\"ร้านกาแฟญี่ปุ่น\",korean:\"เกาหลี\",korean_hotpot:\"หม้อไฟสไตล์เกาหลี\",kosher:\"รับรองมาตรฐานอาหารยิว (โคเชอร์)\",kushiage:\"คุชิอาเกะ (อาหารทอดเสียบไม้)\",kyoto_cuisine:\"อาหารเกียวโต\",lounge:\"เลาจน์\",malaysian:\"มาเลเซีย\",meat:\"เนื้อสัตว์\",mediterranean:\"เมดิเตอร์เรเนียน\",mexican:\"เม็กซิกัน\",middle_eastern:\"ตะวันออกกลาง\",modern_asian:\"เอเชียสมัยใหม่\",modern_french:\"ฝรั่งเศสสมัยใหม่\",modern_indian:\"อินเดียสมัยใหม่\",modern_italian:\"อิตาเลียนสมัยใหม่\",modern_mexican:\"เม็กซิกันสมัยใหม่\",modern_spanish:\"สเปนสมัยใหม่\",modern_sushi:\"ซูชิสไตล์ตะวันตก\",mongolian:\"มองโกเลีย\",mongolian_bbq:\"บาร์บีคิวมองโกเลีย\",moroccan:\"โมร็อกโก & แอฟริกาเหนือ\",motsunabe:\"นาเบะ & โมตสึนาเบะ (หม้อไฟ)\",multiple_cuisines:\"{{cuisine}} + {{other_selected_cuisines_count}}\",nabe:\"นาเบะ (หม้อไฟญี่ปุ่น)\",natural:\"ธรรมชาติ\",nepalese:\"เนปาล\",new_zealand:\"นิวซีแลนด์\",nightclub:\"ไนต์คลับ\",noodles:\"ราเมน & บะหมี่เอเชีย\",oceanic:\"โอเชียเนีย\",oden:\"โอเด้ง (สตูว์ญี่ปุ่น)\",okinawan:\"โอกินาวา\",okinawan_soba:\"โซบะโอกินาวา\",okonomiyaki:\"โอโกโนมิยากิ & มอนจะยากิ\",okonomiyaki_short:\"โอโคโนมิยากิ\",omakase:\"โอมากาเสะ\",omurice:\"ข้าวห่อไข่สไตล์ญี่ปุ่น (ข้าวห่อไข่ออมเล็ต)\",organic:\"รับรองมาตรฐานออแกนิก\",other:\"อื่นๆ\",oyster:\"บาร์หอยนางรม\",pancakes:\"แพนเค้ก\",pasta:\"พาสต้า\",pho:\"เฝอ (บะหมี่ญวน)\",pizza:\"พิซซ่า\",portuguese:\"โปรตุเกส\",poultry:\"ไก่ & สัตว์ปีก\",pub:\"ผับ\",ramen:\"ราเมน\",robatayaki:\"โรบาทายากิ\",russian:\"รัสเซีย & ยุโรปตะวันออก\",ryokan:\"เรียวกัง (โรงแรมขนาดเล็กของญี่ปุ่น)\",sake_bar:\"บาร์สาเก & โชจู\",sandwiches:\"แซนวิช\",scandinavian:\"สวีเดน & สแกนดิเนเวีย\",scottish:\"สก็อตแลนด์\",seafood:\"อาหารทะเล\",shabu_shabu:\"ชาบู ชาบู (หม้อไฟ)\",shabu_shabu_short:\"ชาบูชาบู\",shanghai:\"จีนเซี่ยงไฮ้\",shellfish:\"ปู & สัตว์ทะเลเปลือกแข็ง\",sichuan:\"จีนเสฉวน\",singaporean:\"สิงคโปร์\",soba:\"บะหมี่โซบะ\",soba_short:\"โซบะ\",soba_udon:\"โซบะ&อุด้ง\",south_american:\"ละติน & อเมริกาใต้\",spanish:\"สเปน\",sports_bar:\"บาร์กีฬา\",steak:\"สเต็ก\",sukiyaki:\"สุกี้ยากี้\",suppon:\"ซุปปง (ตะพาบน้ำ)\",sushi:\"ซูชิ\",sushi_sashimi:\"ซูชิ & ซาซิมิ\",sweets:\"ของหวาน & ขนมหวาน\",taiwanese:\"จีนไต้หวัน\",takoyaki:\"ทาโกะยากิ (ปลาหมึกยักษ์ทอด)\",tantanmen:\"ทันทันเมง\",tapas:\"ทาปาส & อาหารจานเล็ก\",tea:\"ชายามบ่าย\",tempura:\"เทมปุระ\",teppanyaki:\"เทปันยากิ\",texmex:\"ตำรับเซาท์เวสต์ & อาหารเท็กซัส-เม็กซิกัน\",thai:\"ไทย\",thai_curry:\"แกงไทย\",thai_hotpot:\"หม้อไฟสไตล์ไทย\",title:\"ประเภทอาหาร\",tofu:\"เต้าหู้\",tonkatsu:\"หมูทงคัตสึ (สันนอกติดมันทอด)\",tsukemen:\"ทสึเคเมน (ราเมนจิ้มจุ่ม)\",turkish:\"ตุรกี\",udon:\"อุด้ง\",udon_short:\"อุด้ง\",unagi:\"อุนางิ (ปลาไหลน้ำจืดญี่ปุ่น)\",vegan:\"วีแกน\",vegetables:\"ผัก\",vegetarian:\"มังสวิรัติ\",vietnamese:\"เวียดนาม\",western:\"ตะวันตก\",wine_bar:\"ไวน์บาร์\",wine_cocktails:\"ไวน์และค็อกเทล\",yakiniku:\"ยากินิกุ & บาร์บีคิวเกาหลี\",yakiniku_bbq:\"ยากินิกุ & บาร์บีคิว\",yakiniku_short:\"ยากินิกุ\",yakisoba:\"ยากิโซบะ (บะหมี่ผัด)\",yakitori:\"ยากิโทริ & คุชิยากิ (อาหารเสียบไม้ย่าง)\",yakitori_short:\"ยากิโทริ\",yoshoku:\"โยโชคุ (อาหารตะวันตกสไตล์ญี่ปุ่น)\"},pVe={description:\"คะแนนลูกค้าของคุณแสดงให้เห็นว่าคุณมาตามการจองได้อย่างสม่ำเสมอเพียงใด เพื่อให้ร้านอาหารเห็นว่าคุณเป็นแขกที่วางใจได้ ยิ่งคะแนนสูง คุณก็ยิ่งปลดล็อกสิทธิพิเศษได้มากขึ้น\",explainer:{factors:{reliability:{body:\"การมาร้านตามการจองเป็นวิธีที่เร็วที่สุดในการสร้างคะแนนลูกค้าของคุณ\",title:\"ความน่าเชื่อถือ\"},reservation_history:{body:\"ความถี่ที่คุณจองและรับประทานอาหารที่ร้าน TableCheck ในช่วงเวลาที่ผ่านมา\",title:\"ประวัติการจอง\"},transactions:{body:\"การจองที่สำเร็จและยอดใช้จ่ายผ่านแพลตฟอร์ม\",title:\"ธุรกรรม\"},venues_visited:{body:\"จำนวนร้านอาหารที่แตกต่างกันที่คุณจองผ่าน TableCheck\",title:\"ร้านอาหารที่เยี่ยมชม\"}},factors_intro:\"คะแนนลูกค้าแสดงวิธีการรับประทานอาหารของคุณกับ TableCheck และอ้างอิงจากปัจจัยต่อไปนี้:\",factors_title:\"ปัจจัยคะแนน\",faq:{booking_block:{answer:\"คะแนนของคุณไม่มีทางปิดกั้นการจอง อย่างไรก็ตาม ร้านอาหารบางแห่งอาจขอเงินมัดจำหรือการค้ำประกันด้วยบัตรก่อนยืนยัน\",question:\"คะแนนของฉันสามารถหยุดฉันไม่ให้จองได้หรือไม่?\"},data_used:{answer:\"ประวัติการจอง ร้านอาหารที่เยี่ยมชม และธุรกรรมที่สำเร็จผ่าน TableCheck เท่านั้น ไม่มีการใช้ข้อมูลใดๆ จากนอกแพลตฟอร์ม\",question:\"ใช้ข้อมูลอะไรบ้าง?\"},improve:{answer:\"มาตามการจองที่ทำไว้ มาถึงตรงเวลา และยกเลิกล่วงหน้าเมื่อแผนเปลี่ยนแปลง คะแนนของคุณจะเพิ่มขึ้นเมื่อการจองที่สำเร็จสะสมมากขึ้น\",question:\"ฉันจะเพิ่มคะแนนได้อย่างไร?\"},no_score:{answer:\"คะแนนจะปรากฏเมื่อคุณจองสำเร็จผ่าน TableCheck หลายครั้ง จนกว่าจะถึงตอนนั้น ร้านอาหารจะมองเห็นคุณเป็นเพียงแขกใหม่\",question:\"ทำไมฉันยังไม่มีคะแนน?\"},no_show:{answer:\"ไม่ การไม่มาตามนัดเพียงครั้งเดียวมีผลกระทบจำกัด และคะแนนของคุณจะฟื้นตัวเมื่อคุณยังคงมาตามการจองครั้งต่อๆ ไป\",question:\"การไม่มาตามนัดเพียงครั้งเดียวจะทำลายคะแนนของฉันหรือไม่?\"},who_can_see:{answer:\"เฉพาะร้านอาหารที่คุณจองเท่านั้น พวกเขาจะเห็นคะแนนของคุณเมื่อคุณทำการจอง — ไม่มีทางเห็นรายละเอียดว่าคุณเคยไปรับประทานที่อื่นมาก่อน\",question:\"ใครสามารถเห็นคะแนนของฉันได้บ้าง?\"}},faq_title:\"คำถามที่พบบ่อย\",hero_image_alt:\"ลูกค้ากำลังตรวจสอบคะแนนลูกค้าของตนในแอป TableCheck\",hero_subtitle:\"ใช้ TableCheck รับรางวัล\",hero_title:\"คะแนนลูกค้า\",how_title:\"ทำงานอย่างไร?\",other_faqs_cta:\"คำถามที่พบบ่อยอื่นๆ\",perks:{membership:\"เข้าถึงสมาชิกภาพ\",offers:\"ข้อเสนอและสิทธิพิเศษ\",venue_access:\"เข้าถึงร้านอาหารสุดพิเศษ\"},steps:{avoid_cancel:{body:\"การยกเลิกในนาทีสุดท้ายและการไม่มาตามนัดอาจส่งผลต่อคะแนนของคุณมากที่สุด โปรดพยายามหลีกเลี่ยง\",title:\"หลีกเลี่ยงการยกเลิกกระชั้นชิด\"},benefits:{body:\"การได้คะแนนสูงขึ้นจะมอบข้อเสนอ สิทธิพิเศษ และการเข้าถึงร้านอาหารสุดพิเศษให้กับคุณ\",title:\"เพลิดเพลินกับสิทธิประโยชน์\"},book:{body:\"การจองสำเร็จผ่าน TableCheck ช่วยสร้างคะแนนลูกค้าของคุณ\",title:\"จองผ่าน TableCheck\"},habits:{body:\"ยิ่งคุณมีการจองที่สำเร็จมากเท่าไหร่ คะแนนของคุณก็จะยิ่งเพิ่มขึ้นเมื่อเวลาผ่านไป\",title:\"รักษานิสัยที่สม่ำเสมอ\"}},what_is_intro:\"คะแนนลูกค้าของคุณสะท้อนถึงความน่าเชื่อถือในการมาตามการจองที่คุณทำไว้ เพื่อให้ร้านอาหารเห็นได้ในพริบตาว่าคุณเป็นแขกที่วางใจได้ ยิ่งคะแนนของคุณสูงขึ้น คุณก็ยิ่งได้รับสิทธิพิเศษมากขึ้น รวมถึง:\",what_is_title:\"คะแนนลูกค้าคืออะไร?\"},guidance:{frequency:{complete_visits:\"สำเร็จการเยี่ยมชมอีก {{required_actions}} ครั้งใน 90 วันข้างหน้าเพื่อช่วยพัฒนาคะแนนของคุณ\"},recency:{come_back:\"จองอีกครั้งภายใน {{within_days}} วันเพื่อช่วยพัฒนาคะแนนของคุณ\"},reliability:{complete_reservations:\"สำเร็จการจองอีก {{required_actions}} ครั้งโดยไม่ยกเลิกเพื่อช่วยพัฒนาคะแนนของคุณ\"}},insights:{booking_frequency:{description:\"การจองบ่อยขึ้นผ่าน TableCheck เพิ่มค่านี้ได้เร็วที่สุด <actionLink>ค้นหาโต๊ะ</actionLink>\",title_value_0:\"การจองล่าสุด: <bold>{{count}}</bold>\"},improve_pill:\"เพิ่มคะแนนของคุณ\",reliability:{description:\"วัดการจองที่คุณมาใช้บริการ การยกเลิกกะทันหันและการไม่มาส่งผลมากที่สุด\",title_value:\"อัตราการมาใช้บริการ: <bold>{{value}}</bold>\"},transactions:{description:\"เงินมัดจำและการชำระเงินที่ทำด้วย TableCheck Pay นับรวมในค่านี้ <actionLink>Pay ทำงานอย่างไร</actionLink>\",title_value:\"ยอดใช้จ่าย: <bold>{{value}}</bold>\"},venues_visited:{description:\"การจองร้านอาหารใหม่ผ่าน TableCheck ช่วยเพิ่มค่านี้เมื่อเวลาผ่านไป <actionLink>สำรวจร้านอาหาร</actionLink>\",title_value_0:\"ร้านอาหารที่เยี่ยมชม: <bold>{{count}}</bold>\"}},insights_period:\"12 เดือนล่าสุด\",insights_title:\"ข้อมูลเชิงลึกเกี่ยวกับคะแนนของคุณ\",levels:{excellent:\"ยอดเยี่ยม\",fair:\"พอใช้\",good:\"ดี\",great:\"ดีมาก\",low:\"ต่ำ\"},offers:{book_with_offer:\"จองพร้อมข้อเสนอ\",claim_failed:\"ไม่สามารถรับข้อเสนอนี้ได้ โปรดลองอีกครั้ง\",code_copied:\"คัดลอกรหัสแล้ว\",copy:\"คัดลอก\",promo_code:\"รหัสโปรโมชัน\",select_venue:\"เลือกร้านอาหาร\"},offers_title:\"ข้อเสนอและสิทธิพิเศษ\",overall_score:\"คะแนนโดยรวม\",percentile:\"กลุ่ม {{percent}}% แรก\",perks:{claim:\"รับสิทธิ์\",claimed:\"รับสิทธิ์แล้ว\",score_required:\"ต้องมีคะแนนระดับ {{level}}\"},status:{inactive:{description:\"คะแนนของคุณจะกลับมาเมื่อสำเร็จการจองอีกครั้ง คำนวณใหม่ทุกครั้งจากประวัติการจองของคุณ\"},insufficient_history:{description:\"คะแนนของคุณจะปรากฏเมื่อจองครบ 5 ครั้ง การยกเลิกและการไม่มาไม่นับ\"},score_suppressed:{description:\"คะแนนของคุณจะกลับมาเมื่อสำเร็จการจองอีกครั้ง คำนวณใหม่ทุกครั้งจากประวัติการจองของคุณ\"},unavailable:{description:\"ขณะนี้เราไม่สามารถแสดงคะแนนของคุณได้ กรุณาลองอีกครั้งในไม่ช้า\"}},title:\"คะแนนลูกค้า\",venue_diversity_levels:{multi_venue:\"หลายร้าน\",not_established:\"ยังไม่ได้กำหนด\",single_venue:\"ร้านเดียว\"},verify:{code_input_label:\"รหัสยืนยัน หลักที่ {{index}}\",code_resent:\"ส่งรหัสแล้ว\",code_sent:\"เราได้ส่ง SMS ไปยัง <strong>{{phone}}</strong> แล้ว กรุณากรอกรหัสยืนยันด้านล่าง\",cta:\"ส่งรหัส\",heading:\"สำหรับผู้ใช้ในญี่ปุ่น\",invalid_code:\"รหัสนั้นไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง\",japan_only:\"กรุณากรอกหมายเลขโทรศัพท์มือถือญี่ปุ่น\",phone_verified:\"ยืนยันหมายเลขโทรศัพท์แล้ว\",resend:\"ส่งรหัสอีกครั้ง\",resend_countdown:\"ส่งรหัสอีกครั้งใน {{seconds}} วินาที\",title:\"ยืนยันหมายเลขโทรศัพท์\"},verify_description:\"บริการนี้มีให้บริการเฉพาะลูกค้าในประเทศญี่ปุ่นเท่านั้น และเราจะทยอยเปิดให้บริการในภูมิภาคอื่นๆ ในเร็วๆ นี้ ยืนยันหมายเลขโทรศัพท์มือถือของญี่ปุ่นเพื่อดูคะแนนลูกค้าของคุณและสิทธิประโยชน์ต่างๆ ที่คุณจะได้รับ\"},fVe={app_issue:\"ขออภัย, บางสิ่งบางอย่างผิดปกติเกิดขึ้นในแอปพลิเคชัน\",page_not_found:\"ขออภัยไม่พบหน้าที่ท่านต้องการเปิด\"},gVe={badge:{explanation:\"ร้านนี้รองรับการจองด่วน ซึ่งเป็นวิธีที่รวดเร็วที่สุดในการจองที่นั่ง\"},book_now:\"จองเลย\",confirmation_content:{add_request:\"เพิ่มคำขอในรายการจองของคุณ (ไม่บังคับ)\",add_request_placeholder:\"เช่น: ขอที่นั่งใกล้หน้าต่าง\",add_request_title:\"เพิ่มคำขอ\",added:\"เพิ่มแล้ว\",agree_venue_policy_0:\"ฉันยอมรับนโยบายของร้านข้างต้น\",booking_policy:\"นโยบายการจอง\",confirm_booking:\"ยืนยันการจอง\",edit_email_hint:\"คุณสามารถแก้ไขอีเมล TableCheck ของคุณได้จากหน้า <accountLink>บัญชี</accountLink>\",express_booking_description:\"การจองด่วนเป็นวิธีที่รวดเร็วที่สุดในการจองที่นั่งที่ร้านที่ร่วมรายการ หากต้องการประสบการณ์ที่ตรงกับความต้องการมากขึ้น โปรดดูตัวเลือกที่นั่งและเมนูด้านล่าง\",fix_required_fields:\"แก้ไขข้อมูลที่จำเป็น\",guest_details:\"ข้อมูลแขก\",guests:\"{{count}} ท่าน\",holding_table:\"เรากำลังสำรองโต๊ะไว้ให้คุณเป็นเวลา {{time}}\",optional:\"ไม่บังคับ\",read_more:\"อ่านเพิ่มเติม\",request_helper:\"แม้ไม่สามารถรับประกันคำขอได้ แต่ร้านจะพยายามอย่างเต็มที่เพื่อรองรับคำขอของคุณ\",review_booking_policy:\"ตรวจสอบนโยบายการจอง\",seat_reservation_description:\"การจองที่นั่งแบบด่วนจะจองโต๊ะไว้สำหรับกลุ่มของคุณ หากต้องการประสบการณ์ที่ตรงกับความต้องการมากขึ้น โปรดดูตัวเลือกที่นั่งและเมนู\",seat_reservation_title:\"การจองที่นั่ง\",table_expired:\"ท่านสามารถลองดำเนินการจองให้เสร็จสิ้นได้ แต่อาจไม่พร้อมให้บริการอีกต่อไป\",terms_and_policy:\"เมื่อส่งแบบฟอร์มนี้ คุณยอมรับ<termsLink>ข้อกำหนดและนโยบายที่เกี่ยวข้อง</termsLink>\",title:\"ตรวจสอบการจองของคุณ\",view_options:\"ดูตัวเลือก\",your_details:\"ข้อมูลของคุณ\"},continue_without_login:\"ดำเนินการต่อโดยไม่เข้าสู่ระบบ\",description:\"แสดงร้านที่รองรับการจองด่วน เพื่อให้จองโต๊ะได้ทันที\",error_content:{dupe_reservation:{banner:\"คุณได้ทำการจองในช่วงเวลานี้ไว้แล้ว {{venueName}} ไม่รับการจองซ้ำ\",title:\"การจองซ้ำ\"},find_another_time_btn:\"ค้นหาเวลาอื่น\",unexpected_error:{banner:\"เกิดข้อผิดพลาดที่ไม่คาดคิด ท่านยังสามารถจองโต๊ะได้โดยใช้ปุ่มด้านล่าง\",title:\"การจองไม่สำเร็จ\"},view_my_bookings_btn:\"ดูการจองของฉัน\"},login_subheader:\"ใช้บัญชี TableCheck ที่มีอยู่ หรือสร้างบัญชีฟรีเพื่อจอง <bold>{{venueName}}</bold>\",result_content:{booking_complete_title:\"การจองได้รับการยืนยันแล้ว\",booking_pending_title:\"รอการยืนยันการจอง\",manage_booking:\"จัดการการจอง\",pending_subtext:\"เราจะแจ้งให้คุณทราบทาง {{email}} เมื่อได้รับการยืนยัน\",pending_title:\"รอการยืนยันจากร้าน\",reservation_id:\"รหัสการจอง\",success_title:\"เราได้ทำการจองของคุณเรียบร้อยแล้ว\"},select_slot_content:{title:\"เลือกวันที่และเวลา\"},title:\"การจองด่วน\"},_Ve={all_you_can_eat:\"กินได้ไม่อั้น\",casual_lively:\"สบายๆ มีชีวิตชีวา\",chefs_counter:\"เคาน์เตอร์เชฟ\",entertainment:\"ความบันเทิง\",family_friendly:\"เหมาะสำหรับครอบครัว\",gluten_free:\"ปราศจากกลูเตน\",great_view:\"วิวสวยมาก\",intimate_setting:\"บรรยากาศที่เป็นส่วนตัว\",large_groups:\"กลุ่มใหญ่\",late_night_dining:\"รับประทานอาหารดึก\",pet_friendly:\"อนุญาตให้นำสัตว์เลี้ยงเข้าได้\",private_dining:\"การรับประทานอาหารแบบส่วนตัว\",rooftop_terrace:\"ดาดฟ้าและระเบียง\",seasonal_menu:\"เมนูตามฤดูกาล\",traditional_setting:\"บรรยากาศแบบดั้งเดิม\",vegetarian:\"มังสวิรัติ\"},kVe={ramen:\"ราเมน\",sushi:\"ซูชิ\"},bVe={add:\"เพิ่ม\",all:\"ทั้งหมด\",amount:\"จำนวนเงิน\",api_issues:\"เรากำลังเผชิญปัญหาบางประการ\",apply:\"ใช้\",average:\"{{amount}} เฉลี่ย\",average_dinner:\"เฉลี่ยอาหารเย็น\",average_lunch:\"เฉลี่ยอาหารกลางวัน\",back:\"ย้อนกลับ\",balance:\"ยอดคงเหลือ\",book:\"จอง\",browse_venues:\"ดูร้านอาหารทั้งหมด\",campaign_period:\"ระยะเวลาแคมเปญ\",cancel:\"ยกเลิก\",city_region:\"{{city}}, {{region}}\",clear:\"ล้าง\",close:\"ปิด\",closed:\"ปิด\",confirm:\"ยืนยัน\",connect:\"เชื่อมต่อ\",daily:\"ทุกวัน\",date:\"วันที่\",date_time:\"เวลา\",days_week:{friday:\"ศุกร์\",monday:\"จันทร์\",saturday:\"เสาร์\",sunda