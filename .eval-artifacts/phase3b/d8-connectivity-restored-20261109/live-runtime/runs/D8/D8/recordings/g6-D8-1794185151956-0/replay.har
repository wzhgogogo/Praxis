odern_indian:\"आधुनिक भारतीय\",modern_italian:\"आधुनिक इतालवी\",modern_mexican:\"आधुनिक मेक्सिकन\",modern_spanish:\"आधुनिक स्पेनिश\",modern_sushi:\"पश्चिमी शैली की सुशी\",mongolian:\"मंगोलियन\",mongolian_bbq:\"मंगोलियन बीबीक्यू\",moroccan:\"मोरोक्कन & उत्तरी अफ्रीकी\",motsunabe:\"नबे और मोत्सुनबे (हॉटपॉट)\",multiple_cuisines:\"{{cuisine}} + {{other_selected_cuisines_count}}\",nabe:\"नबे (जापानी हॉटपॉट)\",natural:\"प्राकृतिक\",nepalese:\"नेपाली\",new_zealand:\"न्यूजीलैंड\",nightclub:\"नाइटक्लब\",noodles:\"रामेन और एशियाई नूडल्स\",oceanic:\"ओशिनियाई\",oden:\"ओडेन (जापानी स्टू)\",okinawan:\"ओकिनावाई\",okinawan_soba:\"ओकिनावान सोबा\",okonomiyaki:\"ओकोनोमियाकी & मोन्जायाकी\",okonomiyaki_short:\"ओकोनोमियाकि\",omakase:\"ओमाकासे\",omurice:\"ऑमुराइस (आमलेट चावल)\",organic:\"जैविक प्रमाणित\",other:\"अन्य\",oyster:\"ऑयस्टर बार\",pancakes:\"पैनकेक्स\",pasta:\"पास्ता\",pho:\"फो (वियतनामी नूडल्स)\",pizza:\"पिज्जा\",portuguese:\"पुर्तगाली\",poultry:\"चिकन और पोल्ट्री\",pub:\"पब\",ramen:\"रामेन\",robatayaki:\"रोबातायाकी\",russian:\"रूसी और पूर्वी यूरोपीय\",ryokan:\"र्योकान (जापानी सराय)\",sake_bar:\"साके & शोचू बार\",sandwiches:\"सैंडविच\",scandinavian:\"स्वीडिश और स्कैंडिनेवियन\",scottish:\"स्कॉटिश\",seafood:\"समुद्री खाद्य\",shabu_shabu:\"शाबू शाबू (हॉटपॉट)\",shabu_shabu_short:\"शाबू शाबू\",shanghai:\"शंघाई चीनी\",shellfish:\"क्रैब और शैलफिश\",sichuan:\"सिचुआन चीनी\",singaporean:\"सिंगापुरी\",soba:\"सोबा नूडल्स\",soba_short:\"सोबा\",soba_udon:\"सोबा और उडोन\",south_american:\"लैटिन और दक्षिण अमेरिकी\",spanish:\"स्पेनिश\",sports_bar:\"स्पोर्ट्स बार\",steak:\"स्टेक\",sukiyaki:\"सुकीयाकी\",suppon:\"सुप्पोन (स्नैपिंग टर्टल)\",sushi:\"सुशी\",sushi_sashimi:\"सुशी और साशिमी\",sweets:\"डेसर्ट और मिठाइयाँ\",taiwanese:\"ताइवानी चीनी\",takoyaki:\"टाकोयाकी (तला हुआ ऑक्टोपस)\",tantanmen:\"तंतनमेन\",tapas:\"तपास और छोटी प्लेटें\",tea:\"दोपहर की चाय\",tempura:\"टेम्पुरा\",teppanyaki:\"तेप्पान्याकी\",texmex:\"दक्षिण-पश्चिमी और टेक्स-मेक्स\",thai:\"थाई\",thai_curry:\"थाई करी\",thai_hotpot:\"थाई हॉटपॉट\",title:\"व्यंजन\",tofu:\"टोफू\",tonkatsu:\"टोंकात्सु (सूअर का तला हुआ कटलेट)\",tsukemen:\"त्सुकेमेन (डिपिंग रामेन)\",turkish:\"तुर्की\",udon:\"उडोन नूडल्स\",udon_short:\"उडोन\",unagi:\"उनागी (मीठे पानी की ईल)\",vegan:\"वीगन\",vegetables:\"सब्ज़ियाँ\",vegetarian:\"शाकाहारी\",vietnamese:\"वियतनामी\",western:\"पश्चिमी\",wine_bar:\"वाइन बार\",wine_cocktails:\"वाइन और कॉकटेल\",yakiniku:\"याकिनिकु और कोरियन बीबीक्यू\",yakiniku_bbq:\"याकिनिकु और बीबीक्यू\",yakiniku_short:\"याकिनिकु\",yakisoba:\"याकीसोबा (तले नूडल्स)\",yakitori:\"याकिटोरी और कुशीयाकी (स्क्यूअर्स)\",yakitori_short:\"याकिटोरी\",yoshoku:\"योशोकू (जापानी-शैली वेस्टर्न)\"},AOe={description:\"आपका ग्राहक स्कोर दिखाता है कि आप अपनी बुकिंग कितनी विश्वसनीयता से निभाते हैं, ताकि रेस्तरां देख सकें कि आप एक भरोसेमंद ग्राहक हैं। आपका स्कोर जितना अधिक होगा, आप उतने अधिक लाभ अनलॉक करेंगे।\",explainer:{factors:{reliability:{body:\"अपने आरक्षणों में उपस्थित होना आपका ग्राहक स्कोर बढ़ाने का सबसे तेज़ तरीका है।\",title:\"विश्वसनीयता\"},reservation_history:{body:\"समय के साथ आप कितनी बार TableCheck रेस्तरां में बुक करते हैं और भोजन करते हैं।\",title:\"आरक्षण इतिहास\"},transactions:{body:\"प्लेटफ़ॉर्म के माध्यम से पूर्ण बुकिंग और खर्च।\",title:\"लेनदेन\"},venues_visited:{body:\"TableCheck के माध्यम से आप जितने अलग-अलग स्थानों पर आरक्षण करते हैं उनकी संख्या।\",title:\"भ्रमण किए गए स्थान\"}},factors_intro:\"ग्राहक स्कोर दिखाता है कि आप TableCheck के साथ कैसे भोजन करते हैं और यह निम्नलिखित कारकों पर आधारित है:\",factors_title:\"स्कोर कारक\",faq:{booking_block:{answer:\"आपका स्कोर कभी भी आरक्षण को अवरोधित नहीं करता। हालांकि, कुछ रेस्तरां पुष्टि से पहले जमा राशि या कार्ड गारंटी मांग सकते हैं।\",question:\"क्या मेरा स्कोर मुझे बुकिंग से रोक सकता है?\"},data_used:{answer:\"आरक्षण इतिहास, भ्रमण किए गए स्थान और TableCheck के माध्यम से पूर्ण लेनदेन। प्लेटफ़ॉर्म के बाहर की कोई भी चीज़ उपयोग नहीं की जाती।\",question:\"कौन से डेटा का उपयोग किया जाता है?\"},improve:{answer:\"अपनी बुकिंग निभाएँ, समय पर पहुँचें और योजना बदलने पर जल्दी रद्द करें। पूर्ण आरक्षण जमा होते ही आपका स्कोर बढ़ता है।\",question:\"मैं अपना स्कोर कैसे सुधारूँ?\"},no_score:{answer:\"TableCheck के माध्यम से कुछ बुकिंग पूरी करने के बाद स्कोर दिखाई देता है। तब तक, रेस्तरां आपको बस एक नए ग्राहक के रूप में देखते हैं।\",question:\"मेरे पास अभी स्कोर क्यों नहीं है?\"},no_show:{answer:\"नहीं। एकल नो-शो का प्रभाव सीमित होता है, और बाद की बुकिंग निभाते रहने से आपका स्कोर ठीक हो जाता है।\",question:\"क्या एक नो-शो मेरा स्कोर बर्बाद कर देगा?\"},who_can_see:{answer:\"केवल वे रेस्तरां जिनमें आप बुक करते हैं। जब आप आरक्षण करते हैं तो वे आपका स्कोर देखते हैं — आपने और कहाँ भोजन किया, इसका विवरण कभी नहीं।\",question:\"मेरा स्कोर कौन देख सकता है?\"}},faq_title:\"FAQ\",hero_image_alt:\"TableCheck ऐप में अपना ग्राहक स्कोर देखता एक ग्राहक\",hero_subtitle:\"TableCheck का उपयोग करें, पुरस्कार पाएं।\",hero_title:\"ग्राहक स्कोर\",how_title:\"यह कैसे काम करता है?\",other_faqs_cta:\"अन्य FAQ\",perks:{membership:\"सदस्यता तक पहुंच\",offers:\"ऑफ़र और लाभ\",venue_access:\"विशेष रेस्तरां तक पहुंच\"},steps:{avoid_cancel:{body:\"आखिरी मिनट की रद्दीकरण और नो-शो आपके स्कोर को सबसे अधिक प्रभावित कर सकते हैं, इनसे बचने की कोशिश करें।\",title:\"देर से रद्द करने से बचें\"},benefits:{body:\"उच्च स्कोर प्राप्त करने से आपको ऑफ़र, लाभ और विशेष रेस्तरां तक पहुंच मिलेगी।\",title:\"लाभों का आनंद लें\"},book:{body:\"TableCheck के माध्यम से आरक्षण पूरा करने से आपका ग्राहक स्कोर बनाने में मदद मिलती है।\",title:\"TableCheck पर बुक करें\"},habits:{body:\"जितनी अधिक पूर्ण बुकिंग आपके पास होंगी, समय के साथ आपका स्कोर उतना ही बढ़ेगा।\",title:\"नियमित आदतें बनाए रखें\"}},what_is_intro:\"आपका ग्राहक स्कोर दर्शाता है कि आप अपनी बुकिंग कितनी विश्वसनीयता से निभाते हैं, ताकि रेस्तरां एक नज़र में देख सकें कि आप एक भरोसेमंद ग्राहक हैं। जितना अधिक आपका स्कोर बढ़ेगा, उतने अधिक लाभ आपको मिलेंगे, जिनमें शामिल हैं:\",what_is_title:\"ग्राहक स्कोर क्या है?\"},guidance:{frequency:{complete_visits:\"अपने स्कोर को बेहतर बनाने के लिए अगले 90 दिनों में {{required_actions}} और बार जाएं।\"},recency:{come_back:\"अपने स्कोर को बेहतर बनाने के लिए {{within_days}} दिनों के भीतर फिर से बुक करें।\"},reliability:{complete_reservations:\"अपने स्कोर को बेहतर बनाने के लिए बिना रद्द किए {{required_actions}} और बुकिंग पूरी करें।\"}},insights:{booking_frequency:{description:\"TableCheck के माध्यम से अधिक बार बुकिंग करना इसे सबसे तेज़ी से बढ़ाता है। <actionLink>टेबल खोजें</actionLink>\",title_value:\"हाल की बुकिंग: <bold>{{count}}</bold>\",title_value_plural:\"हाल की बुकिंग: <bold>{{count}}</bold>\"},improve_pill:\"अपना स्कोर बेहतर करें\",reliability:{description:\"यह मापता है कि आप अपनी बुकिंग पर कितनी बार पहुंचते हैं। देर से रद्द करना और नो-शो सबसे अधिक प्रभावित करते हैं।\",title_value:\"विश्वसनीयता दर: <bold>{{value}}</bold>\"},transactions:{description:\"TableCheck Pay से किए गए डिपॉज़िट और भुगतान इसमें गिने जाते हैं। <actionLink>Pay कैसे काम करता है</actionLink>\",title_value:\"खर्च: <bold>{{value}}</bold>\"},venues_visited:{description:\"TableCheck के माध्यम से नए स्थानों पर बुकिंग करने से यह समय के साथ बढ़ता है। <actionLink>स्थान खोजें</actionLink>\",title_value:\"भ्रमण किया गया स्थान: <bold>{{count}}</bold>\",title_value_plural:\"भ्रमण किए गए स्थान: <bold>{{count}}</bold>\"}},insights_period:\"पिछले 12 महीने\",insights_title:\"आपके स्कोर की जानकारी\",levels:{excellent:\"उत्कृष्ट\",fair:\"ठीक-ठाक\",good:\"अच्छा\",great:\"बहुत अच्छा\",low:\"कम\"},offers:{book_with_offer:\"ऑफ़र के साथ बुक करें\",claim_failed:\"यह ऑफ़र क्लेम नहीं हो सका। कृपया फिर से कोशिश करें।\",code_copied:\"कोड कॉपी हो गया\",copy:\"कॉपी\",promo_code:\"प्रोमो कोड\",select_venue:\"स्थान चुनें\"},offers_title:\"ऑफ़र और लाभ\",overall_score:\"कुल स्कोर\",percentile:\"शीर्ष {{percent}}%\",perks:{claim:\"क्लेम करें\",claimed:\"क्लेम किया गया\",score_required:\"{{level}} स्कोर आवश्यक\"},status:{inactive:{description:\"एक और बुकिंग पूरी करने पर आपका स्कोर वापस आ जाएगा। हर बार आपकी बुकिंग हिस्ट्री से इसकी नए सिरे से गणना की जाती है।\"},insufficient_history:{description:\"5 बुकिंग पूरी करने के बाद आपका स्कोर दिखाई देगा। रद्दीकरण और नो-शो गिने नहीं जाते।\"},score_suppressed:{description:\"एक और बुकिंग पूरी करने पर आपका स्कोर वापस आ जाएगा। हर बार आपकी बुकिंग हिस्ट्री से इसकी नए सिरे से गणना की जाती है।\"},unavailable:{description:\"हम अभी आपका स्कोर नहीं दिखा सकते। जल्द ही पुनः प्रयास करें।\"}},title:\"ग्राहक स्कोर\",venue_diversity_levels:{multi_venue:\"कई स्थान\",not_established:\"निर्धारित नहीं\",single_venue:\"एक स्थान\"},verify:{code_input_label:\"सत्यापन कोड, अंक {{index}}\",code_resent:\"कोड भेजा गया\",code_sent:\"<strong>{{phone}}</strong> पर एक SMS भेजा गया है। नीचे सत्यापन कोड दर्ज करें।\",cta:\"कोड भेजें\",heading:\"जापान के उपयोगकर्ताओं के लिए उपलब्ध\",invalid_code:\"यह कोड सही नहीं है। कृपया पुनः प्रयास करें।\",japan_only:\"कृपया जापानी मोबाइल नंबर दर्ज करें।\",phone_verified:\"फ़ोन नंबर सत्यापित हुआ\",resend:\"कोड पुनः भेजें\",resend_countdown:\"{{seconds}} सेकंड में कोड पुनः भेजें\",title:\"फ़ोन नंबर सत्यापित करें\"},verify_description:\"जापान में स्थित ग्राहकों के लिए उपलब्ध, हम जल्द ही इसे अन्य क्षेत्रों में भी शुरू कर रहे हैं। अपना स्कोर और इससे मिलने वाले लाभ देखने के लिए एक जापानी मोबाइल नंबर सत्यापित करें।\"},wOe={app_issue:\"हमें खेद है, हमारे एप्लिकेशन के अंदर कुछ गलत हुआ।\",page_not_found:\"हमें खेद है, आपके द्वारा अनुरोधित पृष्ठ नहीं मिल सका\"},SOe={badge:{explanation:\"यह स्थान एक्सप्रेस बुकिंग की सुविधा देता है, जो सीट आरक्षण करने का सबसे तेज़ तरीका है।\"},book_now:\"अभी बुक करें\",confirmation_content:{add_request:\"अपने आरक्षण में अनुरोध जोड़ें (वैकल्पिक)\",add_request_placeholder:\"उदा.: कृपया मुझे खिड़की के पास सीट दें\",add_request_title:\"अनुरोध जोड़ें\",added:\"जोड़ा गया\",agree_venue_policy:\"मैं ऊपर दी गई रेस्तरां की नीति से सहमत हूँ।\",agree_venue_policy_plural:\"मैं ऊपर दी गई रेस्तरां की नीतियों से सहमत हूँ।\",booking_policy:\"बुकिंग नीति\",confirm_booking:\"आरक्षण की पुष्टि करें\",edit_email_hint:\"आप अपने <accountLink>खाता</accountLink> पेज से अपना TableCheck ईमेल पता संपादित कर सकते हैं।\",express_booking_description:\"एक्सप्रेस बुकिंग चुनिंदा स्थानों पर सीट आरक्षण करने का सबसे तेज़ तरीका है। अधिक अनुकूल अनुभव के लिए, नीचे सीटिंग और मेनू विकल्प देखें\",fix_required_fields:\"आवश्यक विवरण ठीक करें\",guest_details:\"अतिथि विवरण\",guests:\"{{count}} अतिथि\",holding_table:\"हम {{time}} तक आपके लिए टेबल रोक रहे हैं\",optional:\"वैकल्पिक\",read_more:\"और पढ़ें\",request_helper:\"अनुरोधों की गारंटी नहीं होती, लेकिन स्थान उन्हें पूरा करने की पूरी कोशिश करेंगे।\",review_booking_policy:\"आरक्षण नीति देखें\",seat_reservation_description:\"एक्सप्रेस बुकिंग के साथ, आपके समूह के लिए एक टेबल आरक्षित की जाएगी। अधिक अनुकूल अनुभव के लिए, सीटिंग और मेनू विकल्प देखें।\",seat_reservation_title:\"सीट आरक्षण\",table_expired:\"आप अपनी बुकिंग को पूरा करने की कोशिश कर सकते हैं, लेकिन यह अब और उपलब्ध नहीं हो सकता है।\",terms_and_policy:\"यह फ़ॉर्म सबमिट करके, आप संबंधित <termsLink>नियमों और नीतियों</termsLink> से सहमत होते हैं।\",title:\"अपने आरक्षण की समीक्षा करें\",view_options:\"विकल्प देखें\",your_details:\"आपकी जानकारी\"},continue_without_login:\"लॉगिन किए बिना जारी रखें\",description:\"एक्सप्रेस बुकिंग प्रदान करने वाले स्थान दिखाकर तुरंत टेबल आरक्षित करें।\",error_content:{dupe_reservation:{banner:\"आपने इस समय के लिए पहले ही ऐसी ही बुकिंग कर रखी है। {{venueName}} दोहरी बुकिंग स्वीकार नहीं कर रहा है।\",title:\"दोहरी बुकिंग\"},find_another_time_btn:\"कोई और समय खोजें\",unexpected_error:{banner:\"एक अप्रत्याशित त्रुटि हुई। आप नीचे दिए गए बटन से अभी भी टेबल बुक कर सकते हैं।\",title:\"आरक्षण सफल नहीं हुआ\"},view_my_bookings_btn:\"मेरी बुकिंग देखें\"},login_subheader:\"<bold>{{venueName}}</bold> बुक करने के लिए मौजूदा TableCheck खाते का उपयोग करें, या मुफ़्त में नया खाता बनाएँ\",result_content:{booking_complete_title:\"बुकिंग पूरी हुई\",booking_pending_title:\"बुकिंग लंबित है\",manage_booking:\"बुकिंग प्रबंधित करें\",pending_subtext:\"पुष्टि होने पर हम आपको {{email}} पर सूचित करेंगे।\",pending_title:\"रेस्तरां की पुष्टि लंबित है\",reservation_id:\"आरक्षण आईडी\",success_title:\"आपका आरक्षण सफलतापूर्वक बुक हो गया है।\"},sele