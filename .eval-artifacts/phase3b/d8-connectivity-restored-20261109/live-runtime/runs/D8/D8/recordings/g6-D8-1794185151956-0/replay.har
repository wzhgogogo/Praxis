:\"Karusel Susyi\",kamameshi:\"Kamameshi (Pilaf Jepun)\",kappo:\"Kappo (Jepun Tradisional)\",karaoke:\"Karaoke\",kissaten:\"Kafe Jepun\",korean:\"Korea\",korean_hotpot:\"Periuk Panas Korea\",kosher:\"Disahkan Kosher\",kushiage:\"Kushiage (Pencucuk Goreng)\",kyoto_cuisine:\"Masakan Kyoto\",lounge:\"Lounge\",malaysian:\"Malaysia\",meat:\"Daging\",mediterranean:\"Mediterranean\",mexican:\"Mexico\",middle_eastern:\"Timur Tengah\",modern_asian:\"Asia Moden\",modern_french:\"Perancis Moden\",modern_indian:\"India Moden\",modern_italian:\"Itali Moden\",modern_mexican:\"Mexico Moden\",modern_spanish:\"Sepanyol Moden\",modern_sushi:\"Susyi Gaya Barat\",mongolian:\"Mongolia\",mongolian_bbq:\"Barbeku Mongolia\",moroccan:\"Maghribi & Afrika Utara\",motsunabe:\"Nabe & Motsunabe (Periuk Panas)\",multiple_cuisines:\"{{cuisine}} + {{other_selected_cuisines_count}}\",nabe:\"Nabe (Periuk Panas Jepun)\",natural:\"Semula Jadi\",nepalese:\"Nepal\",new_zealand:\"New Zealand\",nightclub:\"Kelab Malam\",noodles:\"Ramen & Mi Asia\",oceanic:\"Oceania\",oden:\"Oden (Stu Jepun)\",okinawan:\"Okinawa\",okinawan_soba:\"Soba Okinawa\",okonomiyaki:\"Okonomiyaki & Monjayaki\",okonomiyaki_short:\"Okonomiyaki\",omakase:\"Omakase\",omurice:\"Omurice (Nasi Telur Dadar)\",organic:\"Disahkan Organik\",other:\"Lain-lain\",oyster:\"Bar Tiram\",pancakes:\"Penkek\",pasta:\"Pasta\",pho:\"Pho (Mi Vietnam)\",pizza:\"Piza\",portuguese:\"Portugis\",poultry:\"Ayam & Poltri\",pub:\"Pub\",ramen:\"Ramen\",robatayaki:\"Robatayaki\",russian:\"Rusia & Eropah Timur\",ryokan:\"Ryokan (Rumah Penginapan Jepun)\",sake_bar:\"Bar Sake & Shochu\",sandwiches:\"Sandwic\",scandinavian:\"Sweden & Scandinavia\",scottish:\"Scotland\",seafood:\"Makanan Laut\",shabu_shabu:\"Shabu Shabu (Periuk Panas)\",shabu_shabu_short:\"Shabu shabu\",shanghai:\"Cina Shanghai\",shellfish:\"Ketam & Kerang-kerangan\",sichuan:\"Cina Sichuan\",singaporean:\"Singapura\",soba:\"Mi Soba\",soba_short:\"Soba\",soba_udon:\"Soba & Udon\",south_american:\"Amerika Latin & Selatan\",spanish:\"Sepanyol\",sports_bar:\"Bar Sukan\",steak:\"Stik\",sukiyaki:\"Sukiyaki\",suppon:\"Suppon (Labi-labi)\",sushi:\"Sushi\",sushi_sashimi:\"Sushi & sashimi\",sweets:\"Pencuci Mulut & Kuih-muih\",taiwanese:\"Cina Taiwan\",takoyaki:\"Takoyaki (Bebola Kurita)\",tantanmen:\"Tantanmen\",tapas:\"Tapas & Hidangan Kecil\",tea:\"Minum Petang\",tempura:\"Tempura\",teppanyaki:\"Teppanyaki\",texmex:\"Barat daya & Tex-Mex\",thai:\"Thai\",thai_curry:\"Kari Thai\",thai_hotpot:\"Periuk Panas Thai\",title:\"Jenis Masakan\",tofu:\"Tofu\",tonkatsu:\"Tonkatsu (Kutlet Babi Goreng)\",tsukemen:\"Tsukemen (Ramen Celup)\",turkish:\"Turki\",udon:\"Mi Udon\",udon_short:\"Udon\",unagi:\"Unagi (Belut Air Tawar)\",vegan:\"Vegan\",vegetables:\"Sayur-sayuran\",vegetarian:\"Vegetarian\",vietnamese:\"Vietnam\",western:\"Barat\",wine_bar:\"Bar Wain\",wine_cocktails:\"Wain & koktel\",yakiniku:\"Yakiniku & BBQ Korea\",yakiniku_bbq:\"Yakiniku & BBQ\",yakiniku_short:\"Yakiniku\",yakisoba:\"Yakisoba (Mi Goreng)\",yakitori:\"Yakitori & Kushiyaki (Sate)\",yakitori_short:\"Yakitori\",yoshoku:\"Yoshoku (Masakan Barat Gaya Jepun)\"},IHe={description:\"Skor pelanggan anda menunjukkan sejauh mana anda menepati tempahan anda, supaya restoran dapat melihat bahawa anda tetamu yang boleh diharap. Lebih tinggi skor anda, lebih banyak faedah yang anda buka.\",explainer:{factors:{reliability:{body:\"Menghadiri tempahan anda adalah cara terpantas untuk membina Skor Pelanggan anda.\",title:\"Kebolehpercayaan\"},reservation_history:{body:\"Kekerapan anda menempah dan menjamu selera di restoran TableCheck dari semasa ke semasa.\",title:\"Sejarah tempahan\"},transactions:{body:\"Tempahan yang dilengkapkan dan perbelanjaan melalui platform.\",title:\"Transaksi\"},venues_visited:{body:\"Bilangan restoran berbeza yang anda buat tempahan melalui TableCheck.\",title:\"Tempat yang dilawati\"}},factors_intro:\"Skor pelanggan menunjukkan cara anda menjamu selera dengan TableCheck & berdasarkan faktor berikut:\",factors_title:\"Faktor skor\",faq:{booking_block:{answer:\"Skor anda tidak pernah menyekat tempahan. Sesetengah restoran mungkin meminta deposit atau jaminan kad sebelum mengesahkan.\",question:\"Bolehkah skor saya menghalang saya daripada menempah?\"},data_used:{answer:\"Sejarah tempahan, tempat yang dilawati dan transaksi yang dilengkapkan melalui TableCheck. Tiada apa-apa di luar platform digunakan.\",question:\"Data apakah yang digunakan?\"},improve:{answer:\"Tepati tempahan yang anda buat, tiba tepat pada masanya, dan batalkan awal apabila rancangan berubah. Skor anda meningkat apabila tempahan yang dilengkapkan terkumpul.\",question:\"Bagaimana saya meningkatkan skor saya?\"},no_score:{answer:\"Skor muncul sebaik sahaja anda melengkapkan beberapa tempahan melalui TableCheck. Sehingga itu, restoran hanya melihat anda sebagai tetamu baharu.\",question:\"Mengapa saya belum mempunyai skor?\"},no_show:{answer:\"Tidak. Satu kali tidak hadir mempunyai kesan terhad, dan skor anda pulih apabila anda terus menepati tempahan berikutnya.\",question:\"Adakah satu kali tidak hadir akan merosakkan skor saya?\"},who_can_see:{answer:\"Hanya restoran yang anda tempah. Mereka melihat skor anda apabila anda membuat tempahan — tidak pernah butiran tempat lain anda menjamu selera.\",question:\"Siapa boleh melihat skor saya?\"}},faq_title:\"FAQ\",hero_image_alt:\"Seorang pelanggan menyemak skor pelanggannya dalam aplikasi TableCheck\",hero_subtitle:\"Gunakan TableCheck, dapatkan ganjaran.\",hero_title:\"Skor pelanggan\",how_title:\"Bagaimana ia berfungsi?\",other_faqs_cta:\"FAQ lain\",perks:{membership:\"Akses keahlian\",offers:\"Tawaran & faedah\",venue_access:\"Akses restoran eksklusif\"},steps:{avoid_cancel:{body:\"Pembatalan saat akhir & tidak hadir mungkin paling mempengaruhi skor anda, cuba elakkannya.\",title:\"Elakkan pembatalan lewat\"},benefits:{body:\"Mendapat skor lebih tinggi akan memberikan anda tawaran, faedah & akses ke restoran eksklusif.\",title:\"Nikmati faedahnya\"},book:{body:\"Melengkapkan tempahan melalui TableCheck membantu membina skor pelanggan anda.\",title:\"Tempah di TableCheck\"},habits:{body:\"Lebih banyak tempahan yang dilengkapkan, lebih skor anda akan meningkat dari semasa ke semasa.\",title:\"Kekalkan tabiat yang konsisten\"}},what_is_intro:\"Skor pelanggan anda mencerminkan seberapa boleh dipercayai anda menepati tempahan yang dibuat, supaya restoran dapat melihat sepintas lalu bahawa anda tetamu yang boleh diharap. Lebih tinggi skor anda, lebih banyak faedah yang anda peroleh, termasuk:\",what_is_title:\"Apakah skor pelanggan?\"},guidance:{frequency:{complete_visits:\"Selesaikan {{required_actions}} lawatan lagi dalam 90 hari akan datang untuk membantu meningkatkan skor anda.\"},recency:{come_back:\"Tempah semula dalam {{within_days}} hari untuk membantu meningkatkan skor anda.\"},reliability:{complete_reservations:\"Selesaikan {{required_actions}} tempahan lagi tanpa membatalkan untuk membantu meningkatkan skor anda.\"}},insights:{booking_frequency:{description:\"Menempah lebih kerap melalui TableCheck menaikkannya dengan paling pantas. <actionLink>Cari meja</actionLink>\",title_value_0:\"Tempahan terkini: <bold>{{count}}</bold>\"},improve_pill:\"Tingkatkan skor anda\",reliability:{description:\"Mengukur tempahan yang anda hadiri. Pembatalan lewat dan ketidakhadiran memberi kesan paling besar.\",title_value:\"Kadar kebolehpercayaan: <bold>{{value}}</bold>\"},transactions:{description:\"Deposit dan bayaran yang dibuat dengan TableCheck Pay dikira ke arah ini. <actionLink>Cara Pay berfungsi</actionLink>\",title_value:\"Perbelanjaan: <bold>{{value}}</bold>\"},venues_visited:{description:\"Menempah tempat baharu melalui TableCheck menaikkannya dari semasa ke semasa. <actionLink>Terokai tempat</actionLink>\",title_value_0:\"Tempat yang dilawati: <bold>{{count}}</bold>\"}},insights_period:\"12 bulan terakhir\",insights_title:\"Cerapan skor anda\",levels:{excellent:\"Cemerlang\",fair:\"Sederhana\",good:\"Bagus\",great:\"Hebat\",low:\"Rendah\"},offers:{book_with_offer:\"Tempah dengan tawaran\",claim_failed:\"Tidak dapat menuntut tawaran ini. Sila cuba lagi.\",code_copied:\"Kod disalin\",copy:\"Salin\",promo_code:\"Kod promo\",select_venue:\"Pilih tempat\"},offers_title:\"Tawaran & faedah\",overall_score:\"Skor keseluruhan\",percentile:\"{{percent}}% teratas\",perks:{claim:\"Tuntut\",claimed:\"Dituntut\",score_required:\"Skor {{level}} diperlukan\"},status:{inactive:{description:\"Skor anda kembali setelah anda menyelesaikan tempahan seterusnya. Ia dikira semula setiap kali daripada sejarah tempahan anda.\"},insufficient_history:{description:\"Skor anda muncul setelah anda menyelesaikan 5 tempahan. Pembatalan dan ketidakhadiran tidak dikira.\"},score_suppressed:{description:\"Skor anda kembali setelah anda menyelesaikan tempahan seterusnya. Ia dikira semula setiap kali daripada sejarah tempahan anda.\"},unavailable:{description:\"Kami tidak dapat memaparkan skor anda sekarang. Cuba lagi sebentar.\"}},title:\"Skor pelanggan\",venue_diversity_levels:{multi_venue:\"Pelbagai tempat\",not_established:\"Belum ditetapkan\",single_venue:\"Satu tempat\"},verify:{code_input_label:\"Kod pengesahan, digit {{index}}\",code_resent:\"Kod telah dihantar\",code_sent:\"Kami telah menghantar SMS ke <strong>{{phone}}</strong>. Masukkan kod pengesahan di bawah.\",cta:\"Hantar kod\",heading:\"Tersedia untuk pengguna di Jepun\",invalid_code:\"Kod itu tidak betul. Sila cuba lagi.\",japan_only:\"Sila masukkan nombor telefon mudah alih Jepun.\",phone_verified:\"Nombor telefon telah disahkan\",resend:\"Hantar semula kod\",resend_countdown:\"Hantar semula kod dalam {{seconds}}\",title:\"Sahkan nombor telefon\"},verify_description:\"Tersedia untuk pelanggan yang berpangkalan di Jepun, kami akan melancarkannya ke wilayah lain tidak lama lagi. Sahkan nombor telefon bimbit Jepun untuk melihat skor anda & faedah yang ditawarkannya.\"},OHe={app_issue:\"Kami memohon maaf, ada sesuatu yang tidak kena dalam aplikasi kami.\",page_not_found:\"Kami mohon maaf, halaman yang anda minta tidak dapat dijumpai\"},WHe={badge:{explanation:\"Tempat ini menyokong Tempahan Ekspres, cara terpantas untuk membuat tempahan tempat duduk.\"},book_now:\"Tempah sekarang\",confirmation_content:{add_request:\"Tambahkan permintaan pada tempahan anda (pilihan)\",add_request_placeholder:\"Cth: Sila tempatkan saya berhampiran tingkap\",add_request_title:\"Tambah permintaan\",added:\"Ditambah\",agree_venue_policy_0:\"Saya bersetuju dengan dasar tempat di atas.\",booking_policy:\"Dasar tempahan\",confirm_booking:\"Sahkan tempahan\",edit_email_hint:\"Anda boleh mengedit alamat e-mel TableCheck anda dari halaman <accountLink>Akaun</accountLink> anda.\",express_booking_description:\"Tempahan ekspres ialah cara terpantas untuk menempah tempat duduk di lokasi terpilih. Untuk pengalaman yang lebih disesuaikan, sila lihat pilihan tempat duduk dan menu di bawah.\",fix_required_fields:\"Betulkan butiran yang diperlukan\",guest_details:\"Butiran tetamu\",guests:\"{{count}} tetamu\",holding_table:\"Kami sedang menahan meja untuk {{time}}\",optional:\"Pilihan\",read_more:\"Baca lagi\",request_helper:\"Walaupun permintaan tidak dijamin, pihak restoran akan berusaha sebaik mungkin untuk memenuhinya.\",review_booking_policy:\"Semak dasar tempahan\",seat_reservation_description:\"Dengan tempahan ekspres, meja akan ditempah untuk kumpulan anda. Untuk pengalaman yang lebih disesuaikan, sila lihat pilihan tempat duduk dan menu.\",seat_reservation_title:\"Tempahan tempat duduk\",table_expired:\"Anda boleh cuba melengkapkan tempahan anda, tetapi ia mungkin tidak tersedia lagi.\",terms_and_policy:\"Dengan menghantar borang ini, anda bersetuju dengan <termsLink>terma dan dasar</termsLink> yang berkaitan.\",title:\"Semak tempahan anda\",view_options:\"Lihat pilihan\",your_details:\"Butiran anda\"},continue_without_login:\"Teruskan tanpa log masuk\",description:\"Tempah meja serta-merta dengan memaparkan restoran yang menawarkan Tempahan Ekspres.\",error_content:{dupe_reservation:{banner:\"Anda telah membuat tempahan yang serupa untuk waktu ini. {{venueName}} tidak menerima tempahan berganda.\",title:\"Tempahan berganda\"},find_another_time_btn:\"Cari waktu lain\",unexpected_error:{banner:\"Ralat yang tidak dijangka telah berlaku. Anda masih boleh menempah meja menggunakan butang di bawah.\",title:\"Tempahan tidak berjaya\"},view_my_bookings_btn:\"Lihat tempahan saya\"},login_subheader:\"Gunakan akaun TableCheck sedia ada, atau cipta akaun percuma untuk membuat tempahan di <bold>{{venueName}}</bold>\",result_content:{booking_complete_title:\"Tempahan selesai\",booking_pending_title:\"Tempahan menunggu pengesahan\",manage_booking:\"Urus tempahan\",pending_subtext:\"Kami akan memaklumkan anda di {{email}} apabila tempahan disahkan.\",pending_title:\"Menunggu pengesahan restoran\",reservation_id:\"ID tempahan\",success_title:\"Tempahan anda telah berjaya disahkan.\"},select_slot_content:{title:\"Pilih tarikh & masa\"},title:\"Tempahan Ekspres\"},FHe={all_you_can_eat:\"Makan sepuas-puasnya\",casual_lively:\"Santai meriah\",chefs_counter:\"Kaunter cef\",entertainment:\"Hiburan\",family_friendly:\"Mesra keluarga\",gluten_free:\"Bebas gluten\",great_view:\"Pemandangan yang bagus\",intimate_setting:\"Suasana intim\",large_groups:\"Kumpulan besar\",late_night_dining:\"Makan lewat malam\",pet_friendly:\"Mesra haiwan peliharaan\",private_dining:\"Ruang makan persendirian\",rooftop_terrace:\"Atas bumbung & teres\",seasonal_menu:\"Menu bermusim\",traditional_setting:\"Suasana tradisional\",vegetarian:\"Vegetarian\"},DHe={ramen:\"Ramen\",sushi:\"Sushi\"},$He={add:\"Tambah\",all:\"Semua\",amount:\"Jumlah\",api_issues:\"Kami sedang menghadapi beberapa masalah!\",apply:\"Gunakan\",average:\"Purata {{amount}}\",average_dinner:\"Purata makan malam\",average_lunch:\"Purata makan tengah hari\",back:\"Kembali\",balance:\"Baki\",book:\"Tempah\",browse_venues:\"Semak imbas semua tempat\",campaign_period:\"Te