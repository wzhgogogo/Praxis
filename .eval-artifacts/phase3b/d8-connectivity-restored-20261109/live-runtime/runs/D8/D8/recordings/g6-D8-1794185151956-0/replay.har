ranslation:\"Neighbourhood Italian with wood-fired pizza\"},{locale:le.japanese.code,translation:\"薪窯ピッツァが自慢の街イタリアン\"},{locale:le.chineseSimplified.code,translation:\"社区意式餐厅，窑烤披萨\"}],content_body_translations:[{locale:le.english.code,translation:\"Casual Italian favourites: antipasti, handmade pasta, and pizzas from the oven. Family-friendly lunch and terrace seating when weather allows.\"},{locale:le.japanese.code,translation:\"前菜、手打ちパスタ、窯焼きピッツァなどカジュアルなイタリアン。ファミリー向けランチと、天候が良い日はテラス席も。\"},{locale:le.chineseSimplified.code,translation:\"轻松意式料理：前菜、手工意面与窑烤披萨。适合家庭午餐，天气好时可坐露台。\"}],tagline_translations:[{locale:le.english.code,translation:\"Italian · Hiroo\"},{locale:le.chineseSimplified.code,translation:\"意式 · 广尾\"}],search_image:\"https://1.image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn0.tablecheck.com%2Fimages%2F5ced0d829516e8084d0005f9%2Fimages%2Foriginal%2FIMG_8342-1-1024x768.jpg%3F1559039362\",images:[{id:\"la-bisboccia-1\",original:\"https://4.image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F5cedbdcb9516e872c600010e%2Fimages%2Foriginal%2F640x640_rect_5319996.jpg%3F1559084493\",thumbnail:\"https://4.image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F5cedbdcb9516e872c600010e%2Fimages%2Foriginal%2F640x640_rect_5319996.jpg%3F1559084493\",caption:null},{id:\"la-bisboccia-2\",original:\"https://2.image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F5cedbdec950ffc74d0000115%2Fimages%2Foriginal%2FIMG_9275-1-1024x750.jpg%3F1559084524\",thumbnail:\"https://2.image.cdn.tablecheck.com/unsafe/full-fit-in/720x420/smart/filters:format(webp)/https%3A%2F%2Fcdn1.tablecheck.com%2Fimages%2F5cedbdec950ffc74d0000115%2Fimages%2Foriginal%2FIMG_9275-1-1024x750.jpg%3F1559084524\",caption:null},{id:\"la-bisboccia-3\",original:\"