{
  "name": "praxis-zhixing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch:check": "node --import tsx scripts/arch-check.ts",
    "test": "node --import tsx --test src/harness/*.test.ts src/core/*/*.test.ts src/domains/*/*.test.ts src/infrastructure/*/*.test.ts src/server/*.test.ts src/eval/semantic-v15/*.test.ts src/eval/search-fixture/*.test.ts src/eval/shared/*.test.ts",
    "test:probes": "PRAXIS_RUN_FROZEN_PROBES=1 node --import tsx --test src/infrastructure/postgres/postgres-runtime.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server/local-web-server.ts",
    "eval:semantic:deepseek": "node --env-file-if-exists=.env --import tsx src/eval/semantic-v15/run-deepseek-regression.ts",
    "eval:semantic:fixture": "node --import tsx src/eval/semantic-v15/run-fixture.ts",
    "eval:semantic:holdout:preflight": "node --import tsx src/eval/semantic-v15/run-holdout-preflight.ts",
    "eval:semantic:holdout:preflight:complete": "node --import tsx src/eval/semantic-v15/run-holdout-preflight.ts --require-complete",
    "eval:semantic:holdout": "node --env-file-if-exists=.env --import tsx src/eval/semantic-v15/run-holdout.ts",
    "eval:semantic:holdout:exposed-regression": "node --env-file-if-exists=.env --import tsx src/eval/semantic-v15/run-exposed-holdout-regression.ts",
    "eval:semantic:holdout:exposed-regression:analyze": "node --import tsx src/eval/semantic-v15/run-exposed-holdout-regression-analysis.ts",
    "eval:search:fixture": "node --import tsx src/eval/search-fixture/run.ts",
    "test:postgres:live": "node --env-file-if-exists=.env --import tsx src/infrastructure/postgres/postgres-live-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
