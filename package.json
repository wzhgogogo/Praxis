{
  "name": "praxis-zhixing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "arch:check": "node --import tsx scripts/arch-check.ts",
    "test": "node --import tsx --test src/harness/*.test.ts src/core/*/*.test.ts src/domains/*/*.test.ts src/infrastructure/*/*.test.ts src/integrations/*/*.test.ts src/server/*.test.ts src/eval/restaurant/semantic/*.test.ts src/eval/restaurant/search-fixture/*.test.ts src/eval/restaurant/agent-loop/*.test.ts src/eval/shared/*.test.ts",
    "test:probes": "PRAXIS_RUN_FROZEN_PROBES=1 node --import tsx --test src/infrastructure/postgres/postgres-runtime.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server/local-web-server.ts",
    "eval:restaurant:semantic:deepseek": "node --env-file-if-exists=.env --import tsx src/eval/restaurant/semantic/runners/run-deepseek-regression.ts",
    "eval:restaurant:semantic:fixture": "node --import tsx src/eval/restaurant/semantic/runners/run-fixture.ts",
    "eval:restaurant:semantic:holdout:preflight": "node --import tsx src/eval/restaurant/semantic/runners/run-holdout-preflight.ts",
    "eval:restaurant:semantic:holdout:preflight:complete": "node --import tsx src/eval/restaurant/semantic/runners/run-holdout-preflight.ts --require-complete",
    "eval:restaurant:semantic:holdout:baseline": "node --env-file-if-exists=.env --import tsx src/eval/restaurant/semantic/runners/run-holdout.ts",
    "eval:restaurant:semantic:holdout:exposed-regression": "node --env-file-if-exists=.env --import tsx src/eval/restaurant/semantic/runners/run-exposed-holdout-regression.ts",
    "eval:restaurant:semantic:holdout:exposed-regression:analyze": "node --import tsx src/eval/restaurant/semantic/runners/run-exposed-holdout-regression-analysis.ts",
    "eval:restaurant:search:fixture": "node --import tsx src/eval/restaurant/search-fixture/run.ts",
    "eval:restaurant:agent-loop:hybrid-live-read": "node --env-file-if-exists=.env --import tsx src/eval/restaurant/agent-loop/runners/run-hybrid-live-read.ts",
    "test:postgres:live": "node --env-file-if-exists=.env --import tsx src/infrastructure/postgres/postgres-live-smoke.ts",
    "reset:dev:restaurant-state": "node --env-file-if-exists=.env --import tsx src/infrastructure/postgres/reset-restaurant-dev-data.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe:restaurant:browser:read": "node --env-file-if-exists=.env --import tsx src/eval/restaurant/agent-loop/runners/run-browser-read-probe.ts",
    "test:browser:fixture": "node --import tsx --test src/harness/browser/*.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "playwright-core": "^1.62.1",
    "yaml": "^2.9.0"
  }
}
