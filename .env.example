# Local-only, server-side configuration. Copy this file to .env before running
# a stateful local server or a real-model eval. Never commit .env.
#
# None of these values are exposed to the browser. Fixture tests and builds do
# not load .env.

# Required for: npm run dev
DATABASE_URL=

# Optional local port for: npm run dev
# PORT=3000

# Optional local Stage 2B Pilot access override. Keep this JSON on one line.
# If omitted, use the documented fixture token: praxis-fixture-a.
# PRAXIS_PILOT_ACCESS_JSON='[{"accessToken":"replace-me","id":"local-user","displayName":"Local User"}]'

# Required for: npm run eval:restaurant:semantic:deepseek (and authorized Hybrid model runs)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Paid-network gate for the real-model Eval. Keep 0 except during an explicit
# evaluation session; no ordinary test command uses this value.
PRAXIS_ALLOW_LIVE_MODEL_EVAL=0

# Live / Hybrid Restaurant read-only diagnostic. These server-side values are
# never exposed to Web clients. The runner has no booking, payment, cancellation
# or personal-data submission code path.
GOOGLE_MAPS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PRAXIS_ALLOW_LIVE_RESTAURANT_READ=0
PRAXIS_ALLOW_BROWSER_RUN=0
# PRAXIS_BROWSER_ENGINE=LOCAL_CHROMIUM # local; AUTO / KITESURF / CHROMIUM use Cloudflare
# PRAXIS_LOCAL_CHROMIUM_INTERACTIVE=1 # headed, temporary profile by default
# PRAXIS_EVAL_ALLOW_TABELOG_MANUAL_INTERVENTION=0
# Both interactive=1 and manual-intervention=1 enable a dedicated persistent
# local eval profile. See ADR-0016 for ownership, retention and explicit cleanup.
# PRAXIS_EVAL_USER_LAT=
# PRAXIS_EVAL_USER_LNG=
# Single URL probe: npm run probe:restaurant:browser:read -- --url <public-url>
# LOCAL_CHROMIUM probe needs neither Google nor model nor Cloudflare keys.
# See docs/harness/BROWSER-READ-DIAGNOSTICS.md for bounded experiments.

# Local Web defaults to FIXTURE. To make its server-side Restaurant composition
# Live read-only, set all three explicit values below in addition to the keys and
# read/browser gates above. It never falls back to fixture when Live is selected.
# PRAXIS_RESTAURANT_PROVIDER_MODE=LIVE_READ
# PRAXIS_ALLOW_LIVE_RESTAURANT_READ=1
# PRAXIS_ALLOW_BROWSER_RUN=1

# Optional token-cost estimates. Set both values together, or neither.
# PRAXIS_DEEPSEEK_INPUT_USD_PER_MILLION_TOKENS=
# PRAXIS_DEEPSEEK_OUTPUT_USD_PER_MILLION_TOKENS=

# Optional and only for: npm run test:postgres:live
# Use a dedicated, disposable PostgreSQL database. The smoke test creates
# Praxis tables and writes then removes three temporary tasks and one Goal.
# PRAXIS_TEST_DATABASE_URL=
# PRAXIS_ALLOW_TEST_DATABASE_WRITE=0

# Explicitly required only for `npm run reset:dev:restaurant-state`. The command
# accepts localhost DATABASE_URL values only and deletes restaurant-state@7/@8/@9
# development tasks plus their cascading local workspace records.
# PRAXIS_ALLOW_DEV_RESTAURANT_STATE_RESET=0
